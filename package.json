{
  "name": "espectral-client",
  "version": "1.3.8",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "EspectralClient — Minecraft launcher",
  "engines": {
    "node": ">=24.12.0"
  },
  "espectral": {
    "bundledNode": "24.12.0"
  },
  "engineStrict": true,
  "scripts": {
    "predev": "node scripts/free-port.mjs",
    "dev": "node src/engine/cli.mjs --open",
    "start": "npm run build && node src/engine/cli.mjs --open",
    "build": "node scripts/build-ui.mjs",
    "ui": "vite dev --config src/ui/vite.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "svelte-check --tsconfig ./src/ui/tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.11.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
