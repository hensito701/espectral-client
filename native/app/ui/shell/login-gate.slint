// LoginGate — port of components/LoginGate.svelte (Discord OAuth gate).
// FOUNDATION-OWNED. Session logic: src/session.rs (Session global).
// HotkeyLegend — port of components/HotkeyLegend.svelte (not placed by the
// Svelte app either; available for pages).
//
// Glass restyle: the full-window glows stay visible; one floating glass card
// holds the logo + wordmark and the sign-in options. No poster blocks.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { Session, AppState } from "../state.slint";
import { Icon, Icons } from "../widgets/icon.slint";
import { ClientLockup, McTitle, Sticker } from "../widgets/badge.slint";
import { Btn, BtnVariant, Spinner } from "../widgets/btn.slint";
import { GlassCard, Elevation } from "../widgets/card.slint";
import { SelectableText } from "../widgets/selectable.slint";

component GateSuccess inherits VerticalLayout {
    alignment: center;
    padding-top: 8px;
    padding-bottom: 8px;
    HorizontalLayout {
        alignment: center;
        padding-bottom: Theme.space-5;
        Rectangle {
            width: 76px;
            height: 76px;
            border-radius: 38px;
            background: Theme.card-bg-soft;
            border-width: Theme.hairline;
            border-color: Theme.glass-border;
            clip: true;
            if Session.has-user-avatar: Image {
                width: 100%;
                height: 100%;
                source: Session.user-avatar;
                image-fit: cover;
            }
            if !Session.has-user-avatar: Icon { data: Icons.discord; filled: true; size: 34px; color: Theme.discord; }
            // "online" pip: green dot, glass edge
            Rectangle {
                x: parent.width - 22px;
                y: parent.height - 22px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: Theme.accent-green;
                border-width: Theme.hairline;
                border-color: Theme.border-solid;
                Icon { data: Icons.check; size: 13px; weight: 3; color: Theme.text-inverse; }
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        padding-bottom: Theme.space-3;
        Sticker { text: T.tr("gate.badge"); }
    }
    McTitle {
        text: T.tr1("gate.success", "name", Session.user-name);
        font-size: 24px;
        horizontal-alignment: center;
        wrap: true;
    }
    Rectangle { height: Theme.space-2; }
    SelectableText {
        text: T.tr("gate.subtitle");
        font-size: Theme.text-sm;
        line-height-factor: 1.35;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

component GatePrompt inherits VerticalLayout {
    HorizontalLayout {
        alignment: center;
        padding-bottom: Theme.space-2;
        McTitle {
            text: T.tr("gate.welcome");
            font-size: 16px;
            horizontal-alignment: center;
            wrap: true;
        }
    }
    SelectableText {
        text: T.tr("gate.subtitle");
        font-size: Theme.text-sm;
        line-height-factor: 1.35;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Rectangle { height: Theme.space-6; }

    if Session.auth-error != "": VerticalLayout {
        padding-bottom: Theme.space-5;
        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.accent-red.with-alpha(0.10);
            border-width: Theme.hairline;
            border-color: Theme.accent-red.with-alpha(0.55);
            HorizontalLayout {
                padding-top: Theme.space-2;
                padding-bottom: Theme.space-2;
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Icon { data: Icons.alert-circle; size: 16px; color: Theme.accent-red; }
                }
                SelectableText {
                    text: Session.auth-error;
                    font-size: Theme.text-xs;
                    color: Theme.accent-red;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    // actions
    VerticalLayout {
        spacing: Theme.space-3;
        padding-bottom: Theme.space-5;
        // Discord: the primary action of this view, so it keeps its solid fill
        discord-btn := Rectangle {
            property <bool> busy: Session.authenticating;
            property <bool> hovered: d-ta.has-hover && !self.busy;
            height: 46px;
            opacity: self.busy ? 0.6 : 1;
            border-radius: Theme.radius-pill;
            background: Theme.discord;
            border-width: Theme.hairline;
            border-color: hovered ? Theme.edge-strong : transparent;
            animate border-color { duration: Theme.dur-fast; }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-2;
                if discord-btn.busy: VerticalLayout {
                    alignment: center;
                    Spinner { size: 16px; tint: #ffffff; }
                }
                if !discord-btn.busy: VerticalLayout {
                    alignment: center;
                    Icon { data: Icons.discord; filled: true; size: 20px; color: #ffffff; }
                }
                Text {
                    text: discord-btn.busy ? T.tr("gate.connecting") : T.tr("gate.discord");
                    font-size: Theme.text-sm;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
            d-ta := TouchArea {
                enabled: !discord-btn.busy;
                mouse-cursor: pointer;
                clicked => { Session.login-discord(); }
            }
        }
        Btn {
            variant: BtnVariant.secondary;
            block: true;
            text: T.tr("gate.anon");
            enabled: !Session.authenticating;
            clicked => { Session.continue-anonymous(); }
        }
    }
    SelectableText {
        text: T.tr("gate.footnote");
        font-size: Theme.text-xs;
        font-weight: 500;
        line-height-factor: 1.35;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component LoginGate inherits Rectangle {
    // The backdrop glows show through the translucent scrim.
    background: Theme.backdrop;

    TouchArea { }

    // centered with layouts so wrapped text gets its height-for-width
    VerticalLayout {
        alignment: center;
        padding: Theme.space-6;
        HorizontalLayout {
            alignment: center;
            card := GlassCard {
                flat: true;
                elevation: Elevation.lg;
                width: min(460px, root.width - 48px);
                radius: Theme.radius-lg;
                padding-size: 0px;
                spacing: Theme.space-5;

                VerticalLayout {
                    alignment: center;
                    // logo + wordmark (no poster band)
                    HorizontalLayout {
                        padding-top: Theme.space-6;
                        padding-bottom: Theme.space-5;
                        spacing: Theme.space-4;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 64px;
                                height: 64px;
                                source: AppState.logo-md.width > 0 ? AppState.logo-md : @image-url("../assets/logo_circle.png");
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ClientLockup { font-size: 26px; version: AppState.version-label; }
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-8;
                        padding-right: Theme.space-8;
                        padding-bottom: Theme.space-6;
                        if !Session.just-authed: GatePrompt { }
                        if Session.just-authed: GateSuccess { }
                    }
                }
            }
        }
    }
}

export component HotkeyLegend inherits HorizontalLayout {
    spacing: Theme.space-3;
    alignment: start;
    for sc in [
        { key: "CTRL+K", label: T.tr("hotkey.command") },
        { key: "/", label: T.tr("hotkey.search") },
        { key: "ESPACIO", label: T.tr("hotkey.logs") },
        { key: "ESC", label: T.tr("hotkey.back") },
    ]: HorizontalLayout {
        spacing: Theme.space-1;
        opacity: 0.8;
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: k.preferred-height + 6px;
                width: k.preferred-width + 12px;
                border-radius: Theme.radius-xs;
                background: Theme.card-bg-soft;
                border-width: Theme.hairline;
                border-color: Theme.border-solid;
                k := Text {
                    text: sc.key;
                    font-family: Theme.label-family(8px);
                    font-size: Theme.label-size(8px);
                    font-weight: 700;
                    color: Theme.title-color;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        SelectableText {
            text: sc.label;
            font-family: Theme.label-family(8px);
            font-size: Theme.label-size(8px);
            font-weight: 700;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }
}
