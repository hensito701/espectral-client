// LoginGate — port of components/LoginGate.svelte (Discord OAuth gate).
// FOUNDATION-OWNED. Session logic: src/session.rs (Session global).
// HotkeyLegend — port of components/HotkeyLegend.svelte (not placed by the
// Svelte app either; available for pages).
//
// Poster restyle: opaque ink scrim, one flat cream/purple poster card with a
// 2px border and a hard 6px ink shadow, the gold Letterpress wordmark + a
// tilted "CLIENT" sticker, and the brand Discord button (flat blurple pill,
// ink border, hard purple shadow) as on espectral.uhce.top.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { Session, AppState } from "../state.slint";
import { Icon, Icons } from "../widgets/icon.slint";
import { ClientLockup, McTitle, Sticker } from "../widgets/badge.slint";
import { Btn, BtnVariant, Spinner } from "../widgets/btn.slint";

component GateSuccess inherits VerticalLayout {
    alignment: center;
    padding-top: 8px;
    padding-bottom: 8px;
    HorizontalLayout {
        alignment: center;
        padding-bottom: Theme.space-5;
        Rectangle {
            width: 76px;
            height: 76px;
            // hard ink shadow block
            Rectangle {
                x: 4px;
                y: 4px;
                width: 72px;
                height: 72px;
                border-radius: 36px;
                background: Theme.brand-ink;
            }
            Rectangle {
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: Theme.surface-solid;
                border-width: 2px;
                border-color: Theme.border-solid;
                clip: true;
                if Session.has-user-avatar: Image {
                    width: 100%;
                    height: 100%;
                    source: Session.user-avatar;
                    image-fit: cover;
                }
                if !Session.has-user-avatar: Icon { data: Icons.discord; filled: true; size: 34px; color: Theme.discord; }
            }
            // "online" pip: gold ring, ink edge
            Rectangle {
                x: parent.width - 22px;
                y: parent.height - 22px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: Theme.accent-green;
                border-width: 2px;
                border-color: Theme.brand-ink;
                Icon { data: Icons.check; size: 13px; weight: 3; color: Theme.brand-ink; }
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        padding-bottom: Theme.space-3;
        Sticker { text: T.tr("gate.badge"); tilt: -4deg; }
    }
    McTitle {
        text: T.tr1("gate.success", "name", Session.user-name);
        font-size: 24px;
        horizontal-alignment: center;
        wrap: true;
    }
    Rectangle { height: Theme.space-2; }
    Text {
        text: T.tr("gate.subtitle");
        font-size: Theme.text-sm;
        line-height-factor: 1.35;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

component GatePrompt inherits VerticalLayout {
    HorizontalLayout {
        alignment: center;
        padding-bottom: Theme.space-2;
        McTitle {
            text: T.tr("gate.welcome");
            font-size: 16px;
            horizontal-alignment: center;
            wrap: true;
        }
    }
    Text {
        text: T.tr("gate.subtitle");
        font-size: Theme.text-sm;
        line-height-factor: 1.35;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Rectangle { height: Theme.space-6; }

    if Session.auth-error != "": VerticalLayout {
        padding-bottom: Theme.space-5;
        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.surface-solid;
            border-width: 2px;
            border-color: Theme.accent-red;
            HorizontalLayout {
                padding-top: Theme.space-2;
                padding-bottom: Theme.space-2;
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Icon { data: Icons.alert-circle; size: 16px; color: Theme.accent-red; }
                }
                Text {
                    text: Session.auth-error;
                    font-size: Theme.text-xs;
                    color: Theme.accent-red;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    // actions
    VerticalLayout {
        spacing: Theme.space-3;
        padding-bottom: Theme.space-5;
        // brand Discord button: flat blurple pill, ink border, hard ink shadow
        discord-btn := Rectangle {
            property <bool> busy: Session.authenticating;
            property <bool> hovered: d-ta.has-hover && !self.busy;
            property <length> depth: 4px;
            height: 46px + self.depth;
            opacity: self.busy ? 0.6 : 1;

            Rectangle {
                y: discord-btn.depth;
                width: 100%;
                height: 46px;
                border-radius: Theme.radius-pill;
                background: Theme.brand-ink;
            }
            Rectangle {
                y: discord-btn.hovered ? -2px : 0px;
                width: 100%;
                height: 46px;
                border-radius: Theme.radius-pill;
                background: discord-btn.hovered ? #4752c4 : Theme.discord;
                border-width: 2px;
                border-color: Theme.brand-ink;
                animate background, y { duration: Theme.dur-fast; easing: ease-out; }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-2;
                    if discord-btn.busy: VerticalLayout {
                        alignment: center;
                        Spinner { size: 16px; tint: #ffffff; }
                    }
                    if !discord-btn.busy: VerticalLayout {
                        alignment: center;
                        Icon { data: Icons.discord; filled: true; size: 20px; color: #ffffff; }
                    }
                    Text {
                        text: discord-btn.busy ? T.tr("gate.connecting") : T.tr("gate.discord");
                        font-size: Theme.text-sm;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
            }
            d-ta := TouchArea {
                enabled: !discord-btn.busy;
                mouse-cursor: pointer;
                clicked => { Session.login-discord(); }
            }
        }
        Btn {
            variant: BtnVariant.secondary;
            block: true;
            text: T.tr("gate.anon");
            enabled: !Session.authenticating;
            clicked => { Session.continue-anonymous(); }
        }
    }
    Text {
        text: T.tr("gate.footnote");
        font-size: Theme.text-xs;
        font-weight: 500;
        line-height-factor: 1.35;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component LoginGate inherits Rectangle {
    // Opaque ink scrim (no backdrop blur in the poster look).
    background: Theme.backdrop;

    TouchArea { }

    // centered with layouts so wrapped text gets its height-for-width
    VerticalLayout {
        alignment: center;
        padding: Theme.space-6;
        HorizontalLayout {
            alignment: center;
            card := Rectangle {
                width: min(460px, root.width - 48px);
                border-radius: Theme.radius-lg;
                background: Theme.surface-solid;
                border-width: 2px;
                border-color: Theme.border-solid;
                // hard 6px ink shadow block sitting behind the card
                drop-shadow-color: Theme.brand-ink;
                drop-shadow-blur: 0px;
                drop-shadow-offset-x: 6px;
                drop-shadow-offset-y: 6px;
                clip: true;

                VerticalLayout {
                    // poster header band: always the purple brand bar with the
                    // logo + "Espectral / Client vX.Y" lockup (as on the site)
                    band := Rectangle {
                        background: Theme.topbar-bg;
                        HorizontalLayout {
                            padding-top: Theme.space-6;
                            padding-bottom: Theme.space-6;
                            spacing: Theme.space-4;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 88px;
                                    height: 88px;
                                    source: @image-url("../assets/logo_circle.png");
                                    image-fit: contain;
                                }
                            }
                            ClientLockup { font-size: 32px; version: AppState.version-label; }
                        }
                    }
                    // 4px gold rule under the header band
                    Rectangle { height: 4px; background: Theme.header-rule; }

                    HorizontalLayout {
                        padding-left: Theme.space-8;
                        padding-right: Theme.space-8;
                        padding-top: Theme.space-6;
                        padding-bottom: Theme.space-6;
                        if !Session.just-authed: GatePrompt { }
                        if Session.just-authed: GateSuccess { }
                    }
                }
            }
        }
    }
}

export component HotkeyLegend inherits HorizontalLayout {
    spacing: Theme.space-3;
    alignment: start;
    for sc in [
        { key: "CTRL+K", label: T.tr("hotkey.command") },
        { key: "/", label: T.tr("hotkey.search") },
        { key: "ESPACIO", label: T.tr("hotkey.logs") },
        { key: "ESC", label: T.tr("hotkey.back") },
    ]: HorizontalLayout {
        spacing: Theme.space-1;
        opacity: 0.8;
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: k.preferred-height + 6px;
                width: k.preferred-width + 12px;
                border-radius: Theme.radius-xs;
                background: Theme.surface-solid;
                border-width: 2px;
                border-color: Theme.border-solid;
                k := Text {
                    text: sc.key;
                    font-family: Theme.label-family(8px);
                    font-size: Theme.label-size(8px);
                    font-weight: 700;
                    color: Theme.title-color;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: sc.label;
            font-family: Theme.label-family(8px);
            font-size: Theme.label-size(8px);
            font-weight: 700;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }
}
