// CommandPalette — port of components/CommandPalette.svelte. FOUNDATION-OWNED.
// The item list (recent / running / instances / navigation / actions, fuzzy
// scoring, recents persistence) is computed in Rust: src/palette.rs.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { Shell, PaletteState, PaletteItem } from "../state.slint";
import { Kbd } from "../widgets/badge.slint";
import { Emoji } from "../widgets/emoji.slint";

component PaletteRow inherits Rectangle {
    in property <PaletteItem> item;
    in property <bool> active;
    callback hovered();
    callback activate();

    property <color> icon-fg: item.icon-kind == "play" ? Theme.accent : item.icon-kind == "stop" ? Theme.accent-red : item.icon-kind == "wizard" ? Theme.accent-gold : Theme.muted-strong;
    property <color> badge-fg: item.badge-type == "launch" ? Theme.accent : item.badge-type == "nav" ? Theme.accent-cyan : item.badge-type == "action" ? Theme.accent-gold : item.badge-type == "running" ? Theme.accent-red : Theme.muted;

    height: 50px;
    border-radius: Theme.radius-md;
    background: active ? Theme.btn-fill : ta.has-hover ? Theme.surface-up : transparent;
    border-width: 2px;
    border-color: active ? Theme.brand-ink : ta.has-hover ? Theme.hover-border : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        moved => { root.hovered(); }
        clicked => { root.activate(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: active ? Theme.brand-ink : Theme.surface-solid;
                border-width: 2px;
                border-color: active ? Theme.brand-ink : Theme.border-solid;
                Emoji {
                    char: root.item.icon-kind == "instance" ? "⛏" : root.item.icon-kind == "play" ? "▶" : root.item.icon-kind == "stop" ? "⏹" : root.item.icon-kind == "nav" ? "◈" : root.item.icon-kind == "wizard" ? "✦" : root.item.icon-kind == "folder" ? "📁" : root.item.icon-kind == "theme" ? "◐" : root.item.icon-kind == "lang" ? "🌐" : root.item.icon-kind == "logs" ? "📋" : "⚙";
                    size: 15px;
                    fallback-color: active ? Theme.btn-fill : root.icon-fg;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.item.title;
                font-size: Theme.text-sm;
                font-weight: 700;
                color: active ? Theme.btn-ink : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.item.description;
                font-size: Theme.text-xs;
                color: active ? Theme.btn-ink : Theme.muted;
                opacity: active ? 0.75 : 1;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: badge-text.preferred-height + 6px;
                min-width: badge-text.preferred-width + 12px;
                border-radius: Theme.radius-xs;
                background: active ? Theme.brand-ink : Theme.card-bg-soft;
                border-width: 2px;
                border-color: active ? Theme.brand-ink : Theme.border-solid;
                badge-text := Text {
                    text: root.item.badge;
                    font-family: Theme.font-pixel;
                    font-size: 8px;
                    color: active ? Theme.btn-fill : root.badge-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component CommandPalette inherits Rectangle {
    visible: Shell.palette-open;
    background: Theme.backdrop;

    changed visible => {
        if self.visible {
            PaletteState.query = "";
            PaletteState.opened();
            list.content-y = 0;
            input.focus();
        }
    }

    TouchArea {
        clicked => { Shell.palette-open = false; }
    }

    modal := Rectangle {
        width: min(640px, root.width - 2 * Theme.space-4);
        x: (root.width - self.width) / 2;
        y: clamp(root.height * 0.12, 40px, 120px);
        height: col.preferred-height;
        border-radius: Theme.radius-lg;
        background: Theme.surface-solid;
        border-width: 2px;
        border-color: Theme.border-solid;
        // hard 6px ink shadow (poster block, no blur)
        drop-shadow-color: Theme.brand-ink;
        drop-shadow-blur: 0px;
        drop-shadow-offset-x: 6px;
        drop-shadow-offset-y: 6px;
        clip: true;

        TouchArea { }

        col := VerticalLayout {
            // input bar
            Rectangle {
                background: Theme.card-bg-soft;
                HorizontalLayout {
                    padding-top: Theme.space-4;
                    padding-bottom: Theme.space-4;
                    padding-left: Theme.space-5;
                    padding-right: Theme.space-5;
                    spacing: Theme.space-3;
                    Text {
                        text: ">";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-xl;
                        font-weight: 700;
                        color: Theme.title-color;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        input := TextInput {
                            text <=> PaletteState.query;
                            y: (parent.height - self.height) / 2;
                            height: self.preferred-height;
                            font-size: Theme.text-base;
                            font-weight: 500;
                            color: Theme.text;
                            single-line: true;
                            selection-background-color: Theme.accent.with-alpha(0.3);
                            edited => {
                                PaletteState.query-edited(self.text);
                            }
                            key-pressed(e) => {
                                if e.text == Key.DownArrow {
                                    if PaletteState.items.length > 0 {
                                        PaletteState.highlighted = mod(PaletteState.highlighted + 1, PaletteState.items.length);
                                        root.scroll-into-view();
                                    }
                                    return accept;
                                }
                                if e.text == Key.UpArrow {
                                    if PaletteState.items.length > 0 {
                                        PaletteState.highlighted = mod(PaletteState.highlighted - 1 + PaletteState.items.length, PaletteState.items.length);
                                        root.scroll-into-view();
                                    }
                                    return accept;
                                }
                                if e.text == Key.Return {
                                    if PaletteState.items.length > 0 { PaletteState.execute(PaletteState.highlighted); }
                                    return accept;
                                }
                                if e.text == Key.Escape {
                                    Shell.palette-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        if input.text == "": Text {
                            width: parent.width;
                            height: parent.height;
                            text: T.tr("command.placeholder");
                            font-size: Theme.text-base;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: esc-t.preferred-height + 6px;
                            width: esc-t.preferred-width + 12px;
                            border-radius: Theme.radius-xs;
                            background: Theme.surface-solid;
                            border-width: 2px;
                            border-color: Theme.border-solid;
                            esc-t := Text {
                                text: "ESC";
                                font-family: Theme.font-pixel;
                                font-size: 8px;
                                color: Theme.muted-strong;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { y: parent.height - 2px; height: 2px; background: Theme.border-solid; }
            }

            // body
            if PaletteState.items.length == 0: VerticalLayout {
                padding-top: Theme.space-8;
                padding-bottom: Theme.space-8;
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-1;
                alignment: center;
                Text { text: "⌨"; font-size: 32px; color: Theme.muted; opacity: 0.6; horizontal-alignment: center; }
                Text {
                    text: T.tr1("command.noResults", "query", PaletteState.empty-query);
                    font-size: Theme.text-sm;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: T.tr("command.noResultsHint");
                    font-size: Theme.text-xs;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            list := Flickable {
                visible: PaletteState.items.length > 0;
                height: PaletteState.items.length > 0 ? min(380px, list-col.preferred-height) : 0px;
                content-height: list-col.preferred-height;
                interactive: false;
                list-col := VerticalLayout {
                    width: parent.width;
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    padding-top: Theme.space-2;
                    padding-bottom: Theme.space-3;
                    spacing: 2px;
                    for item[i] in PaletteState.items: VerticalLayout {
                        if item.section != "": Text {
                            height: 30px;
                            text: item.section;
                            font-family: Theme.font-pixel;
                            font-weight: 700;
                            font-size: 8px;
                            color: Theme.muted;
                            vertical-alignment: bottom;
                            // CSS: padding 8px 12px 4px
                            x: Theme.space-3;
                        }
                        if item.section != "": Rectangle { height: 4px; }
                        PaletteRow {
                            item: item;
                            active: i == PaletteState.highlighted;
                            hovered => { PaletteState.highlighted = i; }
                            activate => { PaletteState.execute(i); }
                        }
                    }
                }
            }

            // footer
            Rectangle {
                background: Theme.card-bg-soft;
                Rectangle { y: 0; height: 2px; background: Theme.border-solid; }
                HorizontalLayout {
                    padding-top: Theme.space-3;
                    padding-bottom: Theme.space-3;
                    padding-left: Theme.space-5;
                    padding-right: Theme.space-5;
                    spacing: Theme.space-4;
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        VerticalLayout { alignment: center; Kbd { text: "↑↓"; } }
                        Text { text: T.tr("command.kbd.navigate"); font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        VerticalLayout { alignment: center; Kbd { text: "↵"; } }
                        Text { text: T.tr("command.kbd.select"); font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        VerticalLayout { alignment: center; Kbd { text: "ESC"; } }
                        Text { text: T.tr("command.kbd.close"); font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "ESPECTRAL HORIZON";
                        font-family: Theme.font-pixel;
                        font-size: 8px;
                        color: Theme.muted;
                        opacity: 0.6;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // keep the highlighted row visible (PaletteItem.top/height are computed in Rust
    // with the same metrics as the layout above: header 34px, row 50px, spacing 2px)
    function scroll-into-view() {
        if PaletteState.highlighted < 0 || PaletteState.highlighted >= PaletteState.items.length { return; }
        let it = PaletteState.items[PaletteState.highlighted];
        let top = it.top * 1px + Theme.space-2;
        let bottom = top + it.height * 1px;
        if top + list.content-y < 0px {
            list.content-y = -top + (it.section != "" ? 0px : 0px);
        } else if bottom + list.content-y > list.height {
            list.content-y = list.height - bottom - Theme.space-3;
        }
    }

}
