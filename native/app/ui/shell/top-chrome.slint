// TopChrome — no header bar: the logo + pixel wordmark on the left, the
// navigation as a floating glass pill in the centre (Inicio · Mods · Cuenta ·
// settings), the update CTA and the account chip on the right. Everything
// sits on the backdrop glows; the page scrolls underneath.
// The account popover itself is owned by account-wardrobe
// (pages/account-wardrobe/account-popover.slint) and placed by app.slint.
// The command palette has no button: Ctrl+K or "/" opens it.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { Router, Page, AppState, Shell } from "../state.slint";
import { Icon, Icons } from "../widgets/icon.slint";
import { Wordmark } from "../widgets/badge.slint";
import { GlassSheen } from "../widgets/card.slint";
import { MonogramTile, MonogramShape } from "../widgets/monogram.slint";

/// One entry of the navigation pill; the current page gets a lit glass chip.
component NavLink inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    property <bool> hovered: ta.has-hover;
    height: 32px;
    min-width: label-text.preferred-width + 28px;
    preferred-width: label-text.preferred-width + 28px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-pill;
    background: active ? (Theme.dark ? rgba(255, 255, 255, 0.09) : rgba(0, 0, 0, 0.07)) : hovered ? Theme.card-bg-soft : transparent;
    border-width: active ? Theme.hairline : 0px;
    border-color: Theme.edge;
    animate background { duration: Theme.dur-fast; }
    label-text := Text {
        text: root.label;
        font-size: Theme.text-sm;
        font-weight: root.active ? 600 : 500;
        color: root.active ? Theme.text : root.hovered ? Theme.text : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: Theme.dur-fast; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Small square glass button (settings gear, theme toggle).
component ChromeSquare inherits Rectangle {
    callback clicked();
    in property <string> tooltip;
    in property <bool> active;
    out property <bool> hovered: ta.has-hover;
    width: 32px;
    height: 32px;
    border-radius: Theme.radius-pill;
    background: active ? (Theme.dark ? rgba(255, 255, 255, 0.09) : rgba(0, 0, 0, 0.07)) : hovered ? Theme.card-bg-soft : transparent;
    border-width: active ? Theme.hairline : 0px;
    border-color: Theme.edge;
    animate background { duration: Theme.dur-fast; }
    @children
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Theme switch (moon in dark, sun in light). Used by Settings.
export component ThemeToggle inherits ChromeSquare {
    tooltip: Theme.dark ? T.tr("themeToggle.toLight") : T.tr("themeToggle.toDark");
    clicked => { Shell.toggle-theme(); }
    Icon {
        data: Theme.dark ? Icons.moon : Icons.sun;
        size: 16px;
        color: root.hovered ? Theme.accent-bright : Theme.muted-strong;
    }
}

/// A glass pill container (navigation, account chip).
component GlassPill inherits Rectangle {
    in property <bool> hot;
    border-radius: Theme.radius-pill;
    background: Theme.chrome-bg;
    border-width: Theme.hairline;
    border-color: hot ? Theme.hover-border : Theme.glass-border;
    drop-shadow-blur: Theme.shadow-sm-blur;
    drop-shadow-offset-y: Theme.shadow-sm-y;
    drop-shadow-color: Theme.shadow-sm-color;
    clip: true;
    animate border-color { duration: Theme.dur-fast; }
    GlassSheen {
        width: 100%;
        height: 100%;
        radius: root.height / 2;
    }
    @children
}

export component TopChrome inherits Rectangle {
    height: Theme.topbar-height;
    background: Theme.topbar-bg;

    // ---- brand: logo + pixel wordmark (left) ----
    brand := Rectangle {
        x: Theme.space-6;
        y: (root.height - self.height) / 2;
        width: brand-row.preferred-width;
        height: brand-row.preferred-height;
        brand-row := HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 34px;
                    height: 34px;
                    // 96px copy: the 256px original aliases when drawn this small.
                    source: @image-url("../assets/logo_circle_96.png");
                    image-fit: contain;
                }
            }
            if root.width >= 1000px: VerticalLayout {
                alignment: center;
                Wordmark { font-size: 16px; }
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Router.navigate("#/"); }
        }
    }

    // ---- navigation pill (centre) ----
    nav := GlassPill {
        width: nav-row.preferred-width;
        height: 44px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        nav-row := HorizontalLayout {
            padding: 6px;
            spacing: 2px;
            NavLink {
                label: T.tr("nav.home");
                active: Router.page == Page.home || Router.page == Page.instances || Router.page == Page.instance;
                clicked => { Router.navigate("#/"); }
            }
            NavLink {
                label: T.tr("nav.mods");
                active: Router.page == Page.mods || Router.page == Page.versions || Router.page == Page.import;
                clicked => { Router.navigate("#/mods"); }
            }
            NavLink {
                label: T.tr("nav.account");
                active: Router.page == Page.account;
                clicked => { Router.navigate("#/account"); }
            }
            VerticalLayout {
                alignment: center;
                padding-left: 4px;
                padding-right: 4px;
                Rectangle { width: Theme.hairline; height: 16px; background: Theme.border-solid; }
            }
            ChromeSquare {
                tooltip: T.tr("nav.settings");
                active: Router.page == Page.settings || Router.page == Page.donations;
                clicked => { Router.navigate("#/settings"); }
                Icon {
                    data: Icons.settings;
                    size: 16px;
                    color: parent.hovered || parent.active ? Theme.text : Theme.muted;
                }
            }
        }
    }

    // ---- actions (right): update CTA + account chip ----
    actions := HorizontalLayout {
        x: root.width - self.width - Theme.space-6;
        y: (root.height - self.height) / 2;
        width: self.preferred-width;
        height: 44px;
        spacing: Theme.space-2;

        // Update CTA (renders only when a signed update exists): accent pill
        if Shell.update-status != "idle": VerticalLayout {
            alignment: center;
            upd := Rectangle {
                property <bool> busy: Shell.update-status != "available";
                height: 32px;
                min-width: upd-row.preferred-width;
                border-radius: Theme.radius-pill;
                background: upd-ta.has-hover && !upd.busy ? Theme.btn-fill-hover : Theme.btn-fill;
                clip: true;
                if upd.busy: Rectangle {
                    x: 0;
                    width: parent.width * Shell.update-progress;
                    background: Theme.btn-fill-hover;
                }
                upd-row := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: Theme.space-2;
                    if !upd.busy: VerticalLayout {
                        alignment: center;
                        Icon { data: Icons.download; size: 14px; color: Theme.btn-ink; }
                    }
                    Text {
                        text: !upd.busy ? T.tr1("update.badge", "version", Shell.update-version)
                            : Shell.update-status == "downloading" ? (Shell.update-progress > 0 ? T.tr1("update.progress", "pct", round(Shell.update-progress * 100)) : T.tr("update.working"))
                            : T.tr("update.installing");
                        font-size: Theme.text-xs;
                        font-weight: 700;
                        color: Theme.btn-ink;
                        vertical-alignment: center;
                    }
                }
                upd-ta := TouchArea {
                    enabled: !upd.busy;
                    mouse-cursor: pointer;
                    clicked => { Shell.install-update(); }
                }
            }
        }

        // Account chip: glass pill with the avatar
        chip := GlassPill {
            property <bool> active: Shell.account-popover-open;
            hot: chip-ta.has-hover || self.active;
            min-width: chip-row.preferred-width;
            chip-row := HorizontalLayout {
                padding-left: 6px;
                padding-right: 14px;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: Theme.card-bg-soft;
                        if AppState.has-active-account: MonogramTile {
                            name: AppState.active-account.username;
                            hue: AppState.active-account.monogram-hue;
                            avatar: AppState.active-account.avatar;
                            has-avatar: AppState.active-account.has-avatar;
                            size: 30px;
                            shape: MonogramShape.circle;
                        }
                        if !AppState.has-active-account: Icon {
                            data: Icons.plus;
                            size: 14px;
                            color: Theme.accent;
                        }
                        Rectangle {
                            x: parent.width - 8px;
                            y: parent.height - 8px;
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            border-width: 2px;
                            border-color: Theme.surface-solid;
                            background: !AppState.has-active-account ? Theme.muted : AppState.active-account.token-kind == "msa" ? Theme.msa-blue : Theme.accent-green;
                        }
                    }
                }
                Text {
                    text: AppState.has-active-account ? AppState.active-account.username : T.tr("nav.noAccount");
                    font-size: Theme.text-sm;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 150px;
                }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        data: Icons.chevron-down;
                        size: 12px;
                        color: Theme.muted;
                        transform-rotation: chip.active ? 180deg : 0deg;
                        animate transform-rotation { duration: Theme.dur-fast; }
                    }
                }
            }
            chip-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Shell.account-popover-open = !Shell.account-popover-open; }
            }
        }
    }
}
