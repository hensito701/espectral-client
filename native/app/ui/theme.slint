// Theme — the "glass" look (1.9): the in-game Espectral menu's palette
// (branding-mod MenuSkin / SuiteTheme) on a dark charcoal backdrop with soft
// accent glows. Surfaces are translucent dark glass with 1px hairlines and a
// faint top sheen; the accent (gold by default) is used sparingly: the Play
// button, focus/hover edges, active states. The poster pieces that remain
// are the pixel "Espectral" wordmark and the logo.
//
//   CSS                                  Slint
//   var(--accent)                        Theme.accent
//   rgba(var(--accent-rgb), 0.12)        Theme.accent.with-alpha(0.12)
//   var(--space-4) / var(--radius-md)    Theme.space-4 / Theme.radius-md
//   var(--text-sm)                       Theme.text-sm
//   box-shadow: var(--shadow-md)         drop-shadow-blur: Theme.shadow-md-blur; drop-shadow-offset-y: Theme.shadow-md-y; drop-shadow-color: Theme.shadow-md-color;
//
// `dark` and `accent-id` are driven from Rust (src/theme.rs) from the engine
// config (`theme`, `accent`) and the OS color scheme. Never set them from a
// page: call Shell.set-theme-mode(...) / Shell.set-accent(...).

import { Palette } from "std-widgets.slint";

export global Theme {
    // ---- inputs ------------------------------------------------------------
    /// "dark" | "light" | "system" (engine config `theme`). Set by Rust.
    in-out property <string> mode: "dark";
    /// "oro" | "carmesi" | "amatista" | "esmeralda" | "glaciar" (engine config `accent`). Set by Rust.
    in-out property <string> accent-id: "oro";
    /// Resolved scheme: true = dark palette.
    out property <bool> dark: mode == "system" ? Palette.color-scheme != ColorScheme.light : mode != "light";
    /// Window scale factor (1.25 at Windows "125 %"). Set by Rust; `pix` needs it.
    in property <float> ui-scale: 1;
    /// The window is real glass: transparent, with Windows 11's acrylic (the
    /// blurred desktop) behind it. Set by Rust on Windows 11 22H2+ with
    /// OpenGL; elsewhere the backdrop stays opaque charcoal.
    in property <bool> glass: false;

    // ---- surfaces ------------------------------------------------------------
    /// Window base under the glows (MenuSkin.BASE).
    out property <color> bg: dark ? #0b0d10 : #e9e7e2;
    /// Glass: translucent panels over the backdrop (SuiteTheme.ROW / LIST_GLASS).
    out property <color> surface: dark ? rgba(18, 20, 24, 0.62) : rgba(255, 255, 255, 0.62);
    /// Opaque panel for things that float over content (menus, popovers, modals).
    out property <color> surface-solid: dark ? #121418 : #f7f6f3;
    /// Hover / raised glass (SuiteTheme.ROW_HOVER).
    out property <color> surface-up: dark ? rgba(32, 36, 44, 0.72) : rgba(255, 255, 255, 0.85);
    out property <color> surface-up-solid: dark ? #1b1f26 : #ffffff;
    out property <color> card-bg: dark ? rgba(18, 20, 24, 0.62) : rgba(255, 255, 255, 0.62);
    /// Inner wells inside a card (rows, insets).
    out property <color> card-bg-soft: dark ? rgba(255, 255, 255, 0.035) : rgba(0, 0, 0, 0.035);
    out property <color> chrome-bg: dark ? rgba(14, 16, 20, 0.72) : rgba(255, 255, 255, 0.72);
    /// No header bar: the navigation floats as a glass pill.
    out property <color> topbar-bg: transparent;
    out property <color> rail-bg: dark ? rgba(255, 255, 255, 0.035) : rgba(0, 0, 0, 0.035);
    out property <color> log-bg: dark ? rgba(8, 10, 12, 0.85) : rgba(245, 244, 240, 0.92);
    /// Modal / palette scrim (SuiteTheme.SCRIM).
    out property <color> backdrop: dark ? rgba(8, 10, 12, 0.72) : rgba(20, 22, 26, 0.35);
    /// Faint top highlight of glass panels (the "liquid" rim).
    out property <color> sheen: dark ? rgba(255, 255, 255, 0.10) : rgba(255, 255, 255, 0.9);

    // ---- brand ---------------------------------------------------------------
    /// The wordmark's purple drop (in-game title shadow).
    out property <color> wordmark-shadow: #6b3fa0;
    /// Headings: warm white (light: near black). The accent marks state, not titles.
    out property <color> title-color: dark ? #e8e6e1 : #16181c;
    /// Accent fill of the one primary action (Jugar, Save…).
    out property <color> gold: accent;
    out property <color> gold-hover: accent-bright;
    /// Text on an accent fill.
    out property <color> on-gold: #101216;
    out property <color> header-rule: transparent;

    // ---- text ----------------------------------------------------------------
    out property <color> text: dark ? #e8e6e1 : #16181c;
    out property <color> text-inverse: dark ? #0b0d10 : #f7f6f3;
    out property <color> muted: dark ? #a8aeb8 : #5d636c;
    out property <color> muted-strong: dark ? #c9cdd3 : #33373e;

    // ---- accent palette (SuiteTheme.Palette; follows accent-id + scheme) ------
    out property <color> accent: dark ? pick(accent-id, #d9a93b, #e5484d, #bb86fc, #10b981, #38bdf8) : pick(accent-id, #b8862b, #c9243a, #7c3aed, #059669, #0284c7);
    out property <color> accent-ink: pick(accent-id, #c47b1e, #b01e3c, #7c3aed, #059669, #0284c7);
    out property <color> accent-bright: dark ? pick(accent-id, #ffd873, #ff8a92, #d9b3ff, #6ee7b7, #7dd3fc) : pick(accent-id, #9a6d1c, #9f1239, #6d28d9, #047857, #075985);
    /// Second stop of the brand wordmark.
    out property <color> accent-2: pick(accent-id, #ffe3a1, #ffb3b8, #f0ddff, #a7f3d0, #c9edff);
    /// Primary button fill / hover / label.
    out property <color> btn-fill: accent;
    out property <color> btn-fill-hover: dark ? accent-bright : accent-ink;
    out property <color> btn-ink: dark ? #101216 : #ffffff;
    /// 25% / 40% accent hairlines (SuiteTheme.accentHairline / panel edge).
    out property <color> edge: accent.with-alpha(0.25);
    out property <color> edge-strong: accent.with-alpha(0.45);

    // ---- fixed semantic hues (SuiteTheme OK / WARN; softened reds) -------------
    out property <color> accent-gold: accent;
    out property <color> accent-alt: dark ? #e0a24a : #b7791f;
    out property <color> accent-cyan: dark ? #5cc8dc : #0e7490;
    out property <color> accent-purple: dark ? #b48ae8 : #6d28d9;
    out property <color> accent-red: dark ? #ef5f5f : #c62828;
    out property <color> accent-green: dark ? #7fd58b : #2e7d32;
    out property <color> msa-blue: #00a4ef;
    out property <color> discord: #5865f2;

    // loader colours (--loader-*)
    out property <brush> loader-vanilla: #10b981;
    out property <brush> loader-fabric: #0ea5e9;
    out property <brush> loader-neoforge: #f97316;
    out property <brush> loader-quilt: #a855f7;

    // game modes (--mode-*)
    out property <color> mode-uhc: #10b981;
    out property <color> mode-hg: #ef4444;
    out property <color> mode-towers: #06b6d4;
    out property <color> mode-smp: #a855f7;
    out property <color> mode-torneo: #f97316;

    // ---- borders: 1px hairlines ----------------------------------------------
    out property <color> border: dark ? rgba(255, 255, 255, 0.08) : rgba(0, 0, 0, 0.10);
    out property <color> border-solid: dark ? rgba(255, 255, 255, 0.08) : rgba(0, 0, 0, 0.10);
    out property <color> border-focus: edge-strong;
    out property <color> glass-border: dark ? rgba(255, 255, 255, 0.10) : rgba(0, 0, 0, 0.08);
    /// Hover / selected edge: the accent at 45%.
    out property <color> hover-border: edge-strong;
    out property <color> glass-highlight: sheen;
    /// The one hairline width.
    out property <length> hairline: 1px;

    // ---- shadows: soft, dark, below ------------------------------------------
    out property <color> shadow-sm-color: rgba(0, 0, 0, dark ? 0.35 : 0.10);
    out property <length> shadow-sm-blur: 8px;
    out property <length> shadow-sm-x: 0px;
    out property <length> shadow-sm-y: 2px;
    out property <color> shadow-md-color: rgba(0, 0, 0, dark ? 0.45 : 0.12);
    out property <length> shadow-md-blur: 24px;
    out property <length> shadow-md-x: 0px;
    out property <length> shadow-md-y: 8px;
    out property <color> shadow-lg-color: rgba(0, 0, 0, dark ? 0.55 : 0.16);
    out property <length> shadow-lg-blur: 40px;
    out property <length> shadow-lg-x: 0px;
    out property <length> shadow-lg-y: 16px;
    out property <color> shadow-card-color: shadow-md-color;
    out property <length> shadow-card-blur: 24px;
    out property <length> shadow-card-y: 8px;
    out property <color> glow-color: accent.with-alpha(0.35);
    out property <color> glow-play-color: accent.with-alpha(0.45);

    // ---- radii ---------------------------------------------------------------
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-xl: 20px;
    out property <length> radius-tile: 14px;
    out property <length> radius-pill: 9999px;

    // ---- spacing -------------------------------------------------------------
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> space-10: 40px;
    out property <length> space-12: 48px;
    out property <length> space-16: 64px;

    // ---- typography ----------------------------------------------------------
    out property <string> font-body: "Space Grotesk";
    /// Headings use the body family (semibold); the pixel font is reserved
    /// for the wordmark (`font-pixel`).
    out property <string> font-display: "Space Grotesk";
    out property <string> font-title: "Space Grotesk";
    /// The Minecraft pixel font: the "Espectral" wordmark only.
    out property <string> font-pixel: "Minecraft Espectral";
    out property <string> font-mono: "JetBrains Mono";

    /// The size nearest to `size` at which the pixel font is sharp on this
    /// display: a multiple of 8 physical px (halfway rounds down, minimum 8).
    /// Only the wordmark needs it; other callers get a plain size back.
    pure public function pix(size: length) -> length {
        Math.max(1, Math.ceil(size * ui-scale / 8px - 0.5)) * 8px / ui-scale
    }
    /// `v` rounded to whole physical pixels on this display. The pixel font
    /// blurs when it lands between pixels.
    pure public function snap(v: length) -> length {
        Math.round(v * ui-scale / 1px) * 1px / ui-scale
    }
    /// Short labels (badges, chips, key hints): the body font.
    pure public function label-family(size: length) -> string {
        font-body
    }
    /// Size to pair with `label-family(size)`: at least 12px. Smaller
    /// proportional text turns to grey smudge on the OpenGL renderer.
    pure public function label-size(size: length) -> length {
        Math.max(size, 12px)
    }
    out property <length> text-xs: 12px;
    out property <length> text-sm: 14px;
    out property <length> text-md: 15px;
    out property <length> text-base: 16px;
    out property <length> text-lg: 18px;
    out property <length> text-xl: 22px;
    out property <length> text-2xl: 28px;
    out property <length> text-3xl: 36px;
    /// Page hero size for a viewport width.
    public pure function text-hero(viewport-width: length) -> length {
        return clamp(22px + viewport-width * 0.012, 28px, 40px);
    }

    // ---- motion --------------------------------------------------------------
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-med: 180ms;
    out property <duration> dur-slow: 200ms;
    /// Backdrop glows gliding to a page's positions.
    out property <duration> dur-glow: 900ms;

    // ---- shell layout --------------------------------------------------------
    /// Room above the page for the floating navigation pill.
    out property <length> topbar-height: 72px;
    out property <length> statusbar-height: 28px;
    out property <length> pip-collapsed-height: 36px;
    out property <length> pip-expanded-height: 260px;
    out property <length> max-width: 1152px;
    out property <length> content-max: 1312px;

    // ---- scrollbars ------------------------------------------------------------
    out property <color> scrollbar-track: transparent;
    out property <color> scrollbar-thumb: dark ? rgba(255, 255, 255, 0.14) : rgba(0, 0, 0, 0.18);
    out property <color> scrollbar-thumb-hover: edge-strong;

    // ---- helpers ---------------------------------------------------------------
    /// CSS hsla(h, s%, l%, a) — s and l in 0..1.
    public pure function hsla(h: float, s: float, l: float, a: float) -> color {
        let v = l + s * min(l, 1 - l);
        let sv = v == 0 ? 0 : 2 * (1 - l / v);
        return hsv(mod(mod(h, 360) + 360, 360), sv, v, a);
    }

    /// Badge / chip palette by semantic tone name ("ok" | "warn" | "err" | "info" | "accent" | "gold" | "purple" | "neutral").
    public pure function tone(name: string) -> color {
        return name == "ok" ? accent-green : name == "warn" ? accent-alt : (name == "err" || name == "error" || name == "danger") ? accent-red : name == "info" ? accent-cyan : name == "accent" ? accent : name == "gold" ? accent-gold : name == "purple" ? accent-purple : muted;
    }

    pure function pick(id: string, oro: color, carmesi: color, amatista: color, esmeralda: color, glaciar: color) -> color {
        return id == "carmesi" ? carmesi : id == "amatista" ? amatista : id == "esmeralda" ? esmeralda : id == "glaciar" ? glaciar : oro;
    }
}
