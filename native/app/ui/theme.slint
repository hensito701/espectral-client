// Theme — the "poster" look of espectral.uhce.top (house style:
// notes/espectral-web-style.md in the ops workspace): flat deep purple +
// gold, cream paper + purple ink in light mode, hard offset shadows, the
// Minecraft pixel font for titles. No glass, blur, glow or gradient fills.
//
//   CSS                                  Slint
//   var(--accent)                        Theme.accent
//   rgba(var(--accent-rgb), 0.12)        Theme.accent.with-alpha(0.12)
//   var(--space-4) / var(--radius-md)    Theme.space-4 / Theme.radius-md
//   var(--text-sm)                       Theme.text-sm
//   var(--font-mono-retro) (.font-pixel) Theme.font-pixel
//   box-shadow: var(--shadow-md)         drop-shadow-blur: Theme.shadow-md-blur; drop-shadow-offset-y: Theme.shadow-md-y; drop-shadow-color: Theme.shadow-md-color;
//
// `dark` and `accent-id` are driven from Rust (src/theme.rs) from the engine
// config (`theme`, `accent`) and the OS color scheme. Never set them from a
// page: call Shell.set-theme-mode(...) / Shell.set-accent(...).

import { Palette } from "std-widgets.slint";

export global Theme {
    // ---- inputs ------------------------------------------------------------
    /// "dark" | "light" | "system" (engine config `theme`). Set by Rust.
    in-out property <string> mode: "dark";
    /// "oro" | "carmesi" | "amatista" | "esmeralda" | "glaciar" (engine config `accent`). Set by Rust.
    in-out property <string> accent-id: "oro";
    /// Resolved scheme: true = dark palette.
    out property <bool> dark: mode == "system" ? Palette.color-scheme != ColorScheme.light : mode != "light";
    /// Window scale factor (1.25 at Windows "125 %"). Set by Rust; `pix` needs it.
    in property <float> ui-scale: 1;

    // ---- surfaces ------------------------------------------------------------
    // Flat, opaque blocks. The translucent names are kept for the callers but
    // resolve to solid poster colours.
    out property <color> bg: dark ? #120a33 : #fff4dc;
    out property <color> surface: dark ? #1f1252 : #ffffff;
    out property <color> surface-solid: dark ? #1f1252 : #ffffff;
    out property <color> surface-up: dark ? #2a1a66 : #fff9ec;
    out property <color> surface-up-solid: dark ? #2a1a66 : #fff9ec;
    out property <color> card-bg: dark ? #1f1252 : #ffffff;
    out property <color> card-bg-soft: dark ? #180e44 : #fff9ec;
    out property <color> chrome-bg: dark ? #0c0626 : #fff4dc;
    /// Header bar: always the purple brand bar, in both themes.
    out property <color> topbar-bg: #0c0626;
    out property <color> rail-bg: dark ? #180e44 : #fff9ec;
    out property <color> log-bg: dark ? #0c0626 : #f6e9c8;
    /// Modal / palette scrim.
    out property <color> backdrop: dark ? rgba(7, 2, 26, 0.8) : rgba(31, 17, 89, 0.55);

    // ---- brand (fixed pieces of the poster look) -------------------------------
    /// Hard-shadow ink under cards and blocks.
    out property <color> brand-ink: dark ? #07021a : #1f1159;
    /// Title shadow / hover shadow purple (both themes).
    out property <color> brand-purple: #6b3fa0;
    /// Pixel-font title colour: gold on purple, orange on cream.
    out property <color> title-color: dark ? #ffd700 : #f08c00;
    /// Primary buttons and the footer band: gold in both themes.
    out property <color> gold: #ffd700;
    out property <color> gold-hover: #ffaa00;
    /// Text on gold (purple ink, both themes).
    out property <color> on-gold: #1f1159;
    /// The header's 4px bottom rule.
    out property <color> header-rule: #ffaa00;

    // ---- text ----------------------------------------------------------------
    out property <color> text: dark ? #f6f1ff : #1f1159;
    out property <color> text-inverse: dark ? #120a33 : #fff4dc;
    out property <color> muted: dark ? #b7a6e8 : #5b4a8f;
    out property <color> muted-strong: dark ? #d9ccff : #2e1f70;

    // ---- accent palette (follows accent-id + scheme) -------------------------
    out property <color> accent: dark ? pick(accent-id, #ffd700, #e5484d, #bb86fc, #10b981, #38bdf8) : pick(accent-id, #f08c00, #c9243a, #8b5cf6, #059669, #0284c7);
    out property <color> accent-ink: dark ? pick(accent-id, #ffaa00, #b01e3c, #7c3aed, #059669, #0284c7) : pick(accent-id, #c26b00, #9f1239, #6d28d9, #047857, #075985);
    out property <color> accent-bright: dark ? pick(accent-id, #ffff55, #ff8a92, #d9b3ff, #6ee7b7, #7dd3fc) : pick(accent-id, #ffaa00, #e5484d, #a78bfa, #10b981, #0ea5e9);
    /// Second stop of the brand wordmark (per-letter in game; solid here).
    out property <color> accent-2: dark ? pick(accent-id, #ffff55, #ffb3b8, #f0ddff, #a7f3d0, #c9edff) : pick(accent-id, #ffaa00, #e5484d, #a78bfa, #34d399, #38bdf8);
    /// Primary button fill: brand gold in both themes for "oro" (the default),
    /// otherwise the chosen accent.
    out property <color> btn-fill: accent-id == "oro" ? gold : accent;
    out property <color> btn-fill-hover: accent-id == "oro" ? gold-hover : accent-ink;
    out property <color> btn-ink: accent-id == "oro" ? on-gold : #ffffff;

    // ---- fixed semantic hues -------------------------------------------------
    out property <color> accent-gold: dark ? #ffd700 : #f08c00;
    out property <color> accent-alt: dark ? #f59e0b : #d97706;
    out property <color> accent-cyan: dark ? #06b6d4 : #0891b2;
    out property <color> accent-purple: dark ? #a855f7 : #7e22ce;
    out property <color> accent-red: dark ? #ef4444 : #dc2626;
    out property <color> accent-green: dark ? #22c55e : #16a34a;
    out property <color> msa-blue: #00a4ef;
    out property <color> discord: #5865f2;

    // loader colours (--loader-*): flat blocks
    out property <brush> loader-vanilla: #10b981;
    out property <brush> loader-fabric: #0ea5e9;
    out property <brush> loader-neoforge: #f97316;
    out property <brush> loader-quilt: #a855f7;

    // game modes (--mode-*)
    out property <color> mode-uhc: #10b981;
    out property <color> mode-hg: #ef4444;
    out property <color> mode-towers: #06b6d4;
    out property <color> mode-smp: #a855f7;
    out property <color> mode-torneo: #f97316;

    // ---- borders -------------------------------------------------------------
    out property <color> border: dark ? #3a2488 : #1f1159;
    out property <color> border-solid: dark ? #3a2488 : #1f1159;
    /// Gold on hover / focus, as on the site.
    out property <color> border-focus: dark ? #ffd700 : #f08c00;
    out property <color> glass-border: dark ? #3a2488 : #1f1159;
    out property <color> hover-border: dark ? #ffd700 : #f08c00;
    /// (Glass top highlight: none in the poster look.)
    out property <color> glass-highlight: transparent;

    // ---- shadows: hard offsets, no blur ---------------------------------------
    out property <color> shadow-sm-color: brand-ink;
    out property <length> shadow-sm-blur: 0px;
    out property <length> shadow-sm-x: 2px;
    out property <length> shadow-sm-y: 2px;
    out property <color> shadow-md-color: brand-ink;
    out property <length> shadow-md-blur: 0px;
    out property <length> shadow-md-x: 4px;
    out property <length> shadow-md-y: 4px;
    out property <color> shadow-lg-color: brand-ink;
    out property <length> shadow-lg-blur: 0px;
    out property <length> shadow-lg-x: 6px;
    out property <length> shadow-lg-y: 6px;
    out property <color> shadow-card-color: brand-ink;
    out property <length> shadow-card-blur: 0px;
    out property <length> shadow-card-y: 4px;
    /// (Glows are off-style: kept as hard purple shadows.)
    out property <color> glow-color: brand-purple;
    out property <color> glow-play-color: brand-purple;

    // ---- radii ---------------------------------------------------------------
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 20px;
    out property <length> radius-tile: 16px;
    out property <length> radius-pill: 9999px;

    // ---- spacing -------------------------------------------------------------
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> space-10: 40px;
    out property <length> space-12: 48px;
    out property <length> space-16: 64px;

    // ---- typography ----------------------------------------------------------
    out property <string> font-body: "Space Grotesk";
    /// Titles, card titles, stat numbers: the Minecraft pixel font (bold).
    /// Its glyphs sit on an em/8 grid, so they are sharp only when the size
    /// in physical pixels is a multiple of 8: give every size as `pix(...)`.
    out property <string> font-display: "Minecraft Espectral";
    out property <string> font-title: "Minecraft Espectral";
    /// Short pixel labels (badges, key chips).
    out property <string> font-pixel: "Minecraft Espectral";
    out property <string> font-mono: "JetBrains Mono";

    /// The size nearest to `size` at which the pixel font is sharp on this
    /// display: a multiple of 8 physical px (halfway rounds down, minimum 8).
    /// 16px stays 16px at 100 % and becomes 12.8px (16 physical) at 125 %.
    pure public function pix(size: length) -> length {
        Math.max(1, Math.ceil(size * ui-scale / 8px - 0.5)) * 8px / ui-scale
    }
    out property <length> text-xs: 12px;
    out property <length> text-sm: 14px;
    out property <length> text-md: 15px;
    out property <length> text-base: 16px;
    out property <length> text-lg: 18px;
    out property <length> text-xl: 22px;
    out property <length> text-2xl: 28px;
    out property <length> text-3xl: 36px;
    /// --text-hero: clamp(2rem, 1.5rem + 1.8vw, 3rem) for a viewport width.
    public pure function text-hero(viewport-width: length) -> length {
        return clamp(24px + viewport-width * 0.018, 32px, 48px);
    }

    // ---- motion (CSS durations capped at 200 ms) ------------------------------
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-med: 180ms;
    out property <duration> dur-slow: 200ms;

    // ---- shell layout --------------------------------------------------------
    out property <length> topbar-height: 64px;
    out property <length> statusbar-height: 28px;
    out property <length> pip-collapsed-height: 36px;
    out property <length> pip-expanded-height: 260px;
    out property <length> max-width: 1152px;
    out property <length> content-max: 1312px;

    // ---- scrollbars ------------------------------------------------------------
    out property <color> scrollbar-track: dark ? #0c0626 : #f6e9c8;
    out property <color> scrollbar-thumb: dark ? #3a2488 : #b7a6e8;
    out property <color> scrollbar-thumb-hover: dark ? #ffd700 : #f08c00;

    // ---- helpers ---------------------------------------------------------------
    /// CSS hsla(h, s%, l%, a) — s and l in 0..1.
    public pure function hsla(h: float, s: float, l: float, a: float) -> color {
        let v = l + s * min(l, 1 - l);
        let sv = v == 0 ? 0 : 2 * (1 - l / v);
        return hsv(mod(mod(h, 360) + 360, 360), sv, v, a);
    }

    /// Badge / chip palette by semantic tone name ("ok" | "warn" | "err" | "info" | "accent" | "gold" | "purple" | "neutral").
    public pure function tone(name: string) -> color {
        return name == "ok" ? accent-green : name == "warn" ? accent-alt : (name == "err" || name == "error" || name == "danger") ? accent-red : name == "info" ? accent-cyan : name == "accent" ? accent : name == "gold" ? accent-gold : name == "purple" ? accent-purple : muted;
    }

    pure function pick(id: string, oro: color, carmesi: color, amatista: color, esmeralda: color, glaciar: color) -> color {
        return id == "carmesi" ? carmesi : id == "amatista" ? amatista : id == "esmeralda" ? esmeralda : id == "glaciar" ? glaciar : oro;
    }
}
