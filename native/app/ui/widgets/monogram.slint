// MonogramTile — port of components/MonogramTile.svelte (account avatars,
// instance tiles without an icon). The hue comes from Util.name-hue() or an
// AccountRow.monogram-hue computed in Rust.
//
//     MonogramTile { name: acc.username; hue: acc.monogram-hue; avatar: acc.avatar; has-avatar: acc.has-avatar; size: 26px; shape: MonogramShape.circle; }

import { Theme } from "../theme.slint";
import { Util } from "../state.slint";

export enum MonogramShape { tile, rounded, circle }

export component MonogramTile inherits Rectangle {
    in property <string> name;
    /// Resolved hue (0..359). Use Util.name-hue(name, hue-or--1) when you only have a name.
    in property <int> hue: Util.name-hue(name, -1);
    in property <image> avatar;
    in property <bool> has-avatar: false;
    in property <length> size: 48px;
    in property <MonogramShape> shape: MonogramShape.tile;
    /// Requested size of the no-avatar initial: on the 8px pixel grid so big
    /// tiles keep the old glyph, with a body-font fallback on small ones (G1).
    property <length> glyph-size: max(8px, round(root.size * 0.4 / 8px) * 8px);

    width: size;
    height: size;
    border-radius: shape == MonogramShape.circle ? size / 2 : shape == MonogramShape.rounded ? Theme.radius-md : Theme.radius-lg;
    // Flat block: one solid hue, 2px ink border, hard 2px shadow.
    background: Theme.hsla(hue, 0.5, 0.28, 1);
    border-width: 2px;
    border-color: Theme.brand-ink;
    drop-shadow-color: Theme.brand-ink;
    drop-shadow-blur: 0px;
    drop-shadow-offset-x: 2px;
    drop-shadow-offset-y: 2px;
    clip: true;

    // The face fills the whole tile (edge to edge); the ink outline is drawn
    // over it so the image never sits inside a ring.
    if root.has-avatar: Image {
        width: 100%;
        height: 100%;
        source: root.avatar;
        image-fit: cover;
        image-rendering: pixelated;
    }
    if root.has-avatar: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.brand-ink;
    }
    if !root.has-avatar: Text {
        text: Util.initial(root.name);
        font-family: Theme.label-family(root.glyph-size);
        font-size: Theme.label-size(root.glyph-size);
        font-weight: 700;
        color: Theme.hsla(root.hue, 0.9, 0.78, 1);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
