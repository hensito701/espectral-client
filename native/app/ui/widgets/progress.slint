// ProgressBar — port of components/ProgressBar.svelte.
//
//     ProgressBar { value: 42; label: "Descargando"; show-value: true; }
//     ProgressBar { indeterminate: true; tone: ProgressTone.cyan; thickness: ProgressThickness.sm; }
//
// The shimmer sweep is omitted (continuous animation); the indeterminate bar
// animates only while it is visible.

import { Theme } from "../theme.slint";

export enum ProgressTone { accent, cyan, gold, purple, danger }
export enum ProgressThickness { sm, md, lg }

export component ProgressBar inherits VerticalLayout {
    in property <float> value: 0;
    in property <float> max: 100;
    in property <bool> indeterminate: false;
    in property <ProgressTone> tone: ProgressTone.accent;
    in property <ProgressThickness> thickness: ProgressThickness.md;
    in property <string> label;
    in property <bool> show-value: false;

    property <float> pct: max > 0 ? clamp(value / max, 0, 1) : 0;
    // Flat poster fill: one colour per tone (no gradient, no glow).
    property <brush> fill: tone == ProgressTone.cyan ? Theme.accent-cyan
        : tone == ProgressTone.gold ? Theme.accent-gold
        : tone == ProgressTone.purple ? Theme.accent-purple
        : tone == ProgressTone.danger ? Theme.accent-red
        : Theme.btn-fill;

    spacing: Theme.space-1;

    if root.label != "" || (root.show-value && !root.indeterminate): HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.muted-strong;
            font-size: Theme.text-xs;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.show-value && !root.indeterminate: Text {
            text: round(root.pct * 100) + "%";
            color: Theme.text;
            font-family: Theme.label-family(8px);
            font-size: Theme.label-size(8px);
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    track := Rectangle {
        height: root.thickness == ProgressThickness.sm ? 6px : root.thickness == ProgressThickness.lg ? 14px : 10px;
        border-radius: self.height / 2;
        background: Theme.card-bg-soft;
        border-width: 2px;
        border-color: Theme.border-solid;
        clip: true;

        if !root.indeterminate: Rectangle {
            x: 2px;
            y: 2px;
            width: clamp((parent.width - 4px) * root.pct, 0px, parent.width - 4px);
            height: parent.height - 4px;
            border-radius: (parent.height - 4px) / 2;
            background: root.fill;
            animate width { duration: Theme.dur-med; easing: ease-out; }
        }
        if root.indeterminate: Rectangle {
            property <float> t: mod(animation-tick(), 1400ms) / 1400ms;
            width: parent.width * 0.4;
            x: parent.width * (-0.45 + 1.45 * t);
            y: 2px;
            height: parent.height - 4px;
            border-radius: (parent.height - 4px) / 2;
            background: root.fill;
        }
    }
}
