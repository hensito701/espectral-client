// ProgressBar — port of components/ProgressBar.svelte.
//
//     ProgressBar { value: 42; label: "Descargando"; show-value: true; }
//     ProgressBar { indeterminate: true; tone: ProgressTone.cyan; thickness: ProgressThickness.sm; }
//
// The shimmer sweep is omitted (continuous animation); the indeterminate bar
// animates only while it is visible.

import { Theme } from "../theme.slint";

export enum ProgressTone { accent, cyan, gold, purple, danger }
export enum ProgressThickness { sm, md, lg }

export component ProgressBar inherits VerticalLayout {
    in property <float> value: 0;
    in property <float> max: 100;
    in property <bool> indeterminate: false;
    in property <ProgressTone> tone: ProgressTone.accent;
    in property <ProgressThickness> thickness: ProgressThickness.md;
    in property <string> label;
    in property <bool> show-value: false;

    property <float> pct: max > 0 ? clamp(value / max, 0, 1) : 0;
    property <brush> fill: tone == ProgressTone.cyan ? @linear-gradient(90deg, #0284c7 0%, Theme.accent-cyan 100%)
        : tone == ProgressTone.gold ? @linear-gradient(90deg, Theme.accent-alt 0%, Theme.accent-gold 100%)
        : tone == ProgressTone.purple ? @linear-gradient(90deg, #7e22ce 0%, Theme.accent-purple 100%)
        : tone == ProgressTone.danger ? @linear-gradient(90deg, #b91c1c 0%, Theme.accent-red 100%)
        : @linear-gradient(90deg, Theme.accent-ink 0%, Theme.accent 100%);
    property <color> glow: tone == ProgressTone.cyan ? rgba(6, 182, 212, 0.4) : tone == ProgressTone.gold ? Theme.accent-gold.with-alpha(0.4) : tone == ProgressTone.purple ? rgba(168, 85, 247, 0.4) : tone == ProgressTone.danger ? rgba(239, 68, 68, 0.4) : Theme.accent.with-alpha(0.4);

    spacing: Theme.space-1;

    if root.label != "" || (root.show-value && !root.indeterminate): HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.muted-strong;
            font-size: Theme.text-xs;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.show-value && !root.indeterminate: Text {
            text: round(root.pct * 100) + "%";
            color: Theme.text;
            font-family: Theme.font-pixel;
            font-size: 10.4px;
        }
    }

    track := Rectangle {
        height: root.thickness == ProgressThickness.sm ? 4px : root.thickness == ProgressThickness.lg ? 12px : 8px;
        border-radius: self.height / 2;
        background: Theme.card-bg-soft;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        if !root.indeterminate: Rectangle {
            x: 0;
            width: parent.width * root.pct;
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.fill;
            drop-shadow-color: root.glow;
            drop-shadow-blur: 10px;
            animate width { duration: Theme.dur-med; easing: ease-out; }
        }
        if root.indeterminate: Rectangle {
            property <float> t: mod(animation-tick(), 1400ms) / 1400ms;
            width: parent.width * 0.4;
            x: parent.width * (-0.45 + 1.45 * t);
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.fill;
        }
    }
}
