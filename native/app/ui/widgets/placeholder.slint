// PlaceholderPage — what the router shows until a page agent ports the page.
// Page agents: delete its use from your page; do not edit this file.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { Router } from "../state.slint";
import { PageScaffold, PageHeader } from "page.slint";
import { GlassCard } from "card.slint";
import { Badge, BadgeVariant } from "badge.slint";

export component PlaceholderPage inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    /// Svelte source this page ports (shown for orientation).
    in property <string> source;
    PageScaffold {
        content-padding: 40px;
        PageHeader {
            title: root.title;
            subtitle: root.subtitle;
            HorizontalLayout {
                alignment: start;
                Badge { text: Router.route; variant: BadgeVariant.accent; dot: true; }
            }
        }
        GlassCard {
            title: "Slint port pending";
            subtitle: root.source;
            Text {
                text: "This page is a placeholder created by the UI foundation. The page agent that owns it replaces this component (see native/app/UI-PORTING.md).";
                color: Theme.muted;
                font-size: Theme.text-sm;
                wrap: word-wrap;
            }
        }
    }
}
