/// Stroked (default) or filled 24x24 icon.
export component Icon inherits Path {
    in property <string> data;
    in property <length> size: 16px;
    in property <brush> color: #ffffff;
    in property <bool> filled: false;
    in property <float> weight: 2;

    width: size;
    height: size;
    commands: data;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    clip: false;
    fill: filled ? color : transparent;
    stroke: filled ? transparent : color;
    stroke-width: filled ? 0px : size * weight / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}
