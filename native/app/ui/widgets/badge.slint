// Badge — flat chips (no glow); Kbd — the pixel-font key chips (HotkeyLegend,
// palette footer, TopChrome "/" hint); GradientText — kept for the callers but
// draws solid colour (gradient text fills are off-style in the poster look).

import { Theme } from "../theme.slint";

/// Badge variants (CSS .badge--*). Loader variants: vanilla | fabric | neoforge | quilt.
export enum BadgeVariant { neutral, ok, warn, err, info, accent, gold, purple, vanilla, fabric, neoforge, quilt }

export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeVariant> variant: BadgeVariant.neutral;
    /// Leading status dot.
    in property <bool> dot: false;
    /// Minecraft pixel font (8px, one game pixel per px).
    in property <bool> pixel: false;
    /// md = 5px 12px / 14px; sm = 3px 8px / 12px.
    in property <bool> large: false;

    property <color> fg: variant == BadgeVariant.ok ? Theme.accent-green
        : variant == BadgeVariant.warn ? Theme.accent-alt
        : variant == BadgeVariant.err ? Theme.accent-red
        : variant == BadgeVariant.info || variant == BadgeVariant.fabric ? Theme.accent-cyan
        : variant == BadgeVariant.accent ? Theme.accent
        : variant == BadgeVariant.gold ? Theme.accent-gold
        : variant == BadgeVariant.purple || variant == BadgeVariant.quilt ? Theme.accent-purple
        : variant == BadgeVariant.neoforge ? Theme.accent-alt
        : variant == BadgeVariant.vanilla ? #ffffff
        : Theme.muted;
    property <color> base: variant == BadgeVariant.err ? #ef4444 : variant == BadgeVariant.info || variant == BadgeVariant.fabric ? #06b6d4 : variant == BadgeVariant.purple || variant == BadgeVariant.quilt ? #a855f7 : variant == BadgeVariant.neoforge ? #f97316 : fg;

    height: row.preferred-height;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-pill;
    border-width: 2px;
    background: variant == BadgeVariant.neutral ? Theme.card-bg-soft
        : variant == BadgeVariant.vanilla ? Theme.loader-vanilla
        : variant == BadgeVariant.accent ? Theme.accent.with-alpha(0.2)
        : base.with-alpha(0.16);
    border-color: variant == BadgeVariant.neutral ? Theme.border-solid
        : variant == BadgeVariant.vanilla ? #0b7a56
        : variant == BadgeVariant.accent ? Theme.accent
        : base.with-alpha(0.6);

    row := HorizontalLayout {
        padding-left: large ? 12px : 8px;
        padding-right: large ? 12px : 8px;
        padding-top: large ? 5px : 3px;
        padding-bottom: large ? 5px : 3px;
        spacing: Theme.space-1;
        alignment: center;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.fg;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: root.pixel ? 8px : root.large ? Theme.text-sm : Theme.text-xs;
            font-family: root.pixel ? Theme.font-pixel : Theme.font-body;
            font-weight: root.pixel ? 400 : 600;
            letter-spacing: root.pixel ? 0px : 0.3px;
            vertical-alignment: center;
        }
    }
}

/// <kbd class="font-pixel"> key chip.
export component Kbd inherits Rectangle {
    in property <string> text;
    /// accent-tinted (TopChrome "/" , HotkeyLegend) vs neutral (palette footer).
    in property <bool> accent: false;
    in property <length> font-size: 8px;
    height: label.preferred-height + 6px;
    min-width: label.preferred-width + 10px;
    preferred-width: label.preferred-width + 10px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-xs;
    background: accent ? Theme.accent.with-alpha(0.12) : Theme.surface-solid;
    border-width: 1px;
    border-color: accent ? Theme.accent.with-alpha(0.3) : Theme.border;
    label := Text {
        text: root.text;
        font-family: Theme.font-pixel;
        font-size: root.font-size;
        color: root.accent ? Theme.accent : Theme.muted-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Colour presets of the old GradientText (now solid colours).
export enum GradientKind { emerald-gold, cyan-emerald, gold-amber, purple-pink, accent }

/// Title text in the poster style: solid colour (the preset's main colour; the
/// default is the title gold/orange). Gradient text fills are off-style.
export component GradientText inherits Text {
    in property <GradientKind> gradient: GradientKind.emerald-gold;
    color: gradient == GradientKind.cyan-emerald ? Theme.accent-cyan
        : gradient == GradientKind.purple-pink ? Theme.accent-purple
        : gradient == GradientKind.accent ? Theme.accent
        : Theme.title-color;
}

/// The in-game title look: Minecraft pixel font, bold, title colour, with a
/// purple shadow one game pixel (font-size / 8) down and to the right.
/// Use font sizes that are multiples of 8px (16, 24, 32, 40, 48, 64).
///
///     McTitle { text: T.tr("dash.title"); font-size: 32px; }
export component McTitle inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 24px;
    in property <color> ink: Theme.title-color;
    in property <color> shadow-ink: Theme.brand-purple;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <bool> wrap: true;
    property <length> px: font-size / 8;

    // A long pixel title must never widen its parent: when it wraps, it
    // wraps; when it doesn't, it is clipped by the layout instead.
    min-width: root.wrap ? 0px : label.min-width + px;
    preferred-width: label.preferred-width + px;
    min-height: label.min-height + px;
    preferred-height: label.preferred-height + px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    Text {
        x: root.px;
        y: root.px;
        width: root.width - root.px;
        height: root.height - root.px;
        text: root.text;
        font-family: Theme.font-title;
        font-size: root.font-size;
        font-weight: 700;
        color: root.shadow-ink;
        horizontal-alignment: root.horizontal-alignment;
        wrap: root.wrap ? word-wrap : no-wrap;
    }
    label := Text {
        x: 0;
        y: 0;
        width: root.width - root.px;
        height: root.height - root.px;
        text: root.text;
        font-family: Theme.font-title;
        font-size: root.font-size;
        font-weight: 700;
        color: root.ink;
        horizontal-alignment: root.horizontal-alignment;
        wrap: root.wrap ? word-wrap : no-wrap;
    }
}

/// One letter of the brand wordmark: pixel font with the site's lockup shadow
/// (purple at 60%, one game pixel = font-size / 8, down-right). The shadow
/// overhangs: letters advance by the glyph width only.
component WordmarkLetter inherits Rectangle {
    in property <string> letter;
    in property <color> tint;
    in property <length> font-size;
    property <length> px: font-size / 8;
    width: glyph.preferred-width;
    height: glyph.preferred-height + px;
    Text { x: root.px; y: root.px; text: root.letter; font-family: Theme.font-title; font-size: root.font-size; font-weight: 700; color: Theme.brand-purple.with-alpha(0.6); }
    glyph := Text { x: 0; y: 0; text: root.letter; font-family: Theme.font-title; font-size: root.font-size; font-weight: 700; color: root.tint; }
}

/// The "Espectral" wordmark: per-letter gold gradient #FFAA00 → #FFD700 →
/// #FFFF55 → #FFD700, letter by letter as the game colours it (BRAND_GRADIENT
/// of espectral-web/src/lib/mcText.ts). Sizes: multiples of 8px.
export component Wordmark inherits HorizontalLayout {
    in property <length> font-size: 16px;
    accessible-role: text;
    accessible-label: "Espectral";
    spacing: 0px;
    alignment: start;
    WordmarkLetter { letter: "E"; tint: #ffaa00; font-size: root.font-size; }
    WordmarkLetter { letter: "s"; tint: #ffbb00; font-size: root.font-size; }
    WordmarkLetter { letter: "p"; tint: #ffcc00; font-size: root.font-size; }
    WordmarkLetter { letter: "e"; tint: #ffdc0b; font-size: root.font-size; }
    WordmarkLetter { letter: "c"; tint: #ffeb2b; font-size: root.font-size; }
    WordmarkLetter { letter: "t"; tint: #fffa4a; font-size: root.font-size; }
    WordmarkLetter { letter: "r"; tint: #fff540; font-size: root.font-size; }
    WordmarkLetter { letter: "a"; tint: #ffe620; font-size: root.font-size; }
    WordmarkLetter { letter: "l"; tint: #ffd700; font-size: root.font-size; }
}

/// Sticker badge: small pixel label on a flat colour with a hard shadow,
/// tilted about -4°. Defaults to the site's green tag: #10B981 with dark ink
/// (white on that green is too faint). One per section at most.
export component Sticker inherits Rectangle {
    in property <string> text;
    in property <color> fill: #10b981;
    in property <color> ink: #07021a;
    in property <length> font-size: 8px;
    in property <angle> tilt: -4deg;
    /// 2px ink outline (the site's version tag has none).
    in property <bool> outlined: true;
    property <length> d: 3px;
    width: label.preferred-width + 16px + d;
    height: label.preferred-height + 8px + d;
    Rectangle {
        width: root.width;
        height: root.height;
        transform-rotation: root.tilt;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        Rectangle { x: root.d; y: root.d; width: root.width - root.d; height: root.height - root.d; border-radius: 4px; background: Theme.brand-ink; }
        Rectangle {
            x: 0; y: 0;
            width: root.width - root.d; height: root.height - root.d;
            border-radius: 4px;
            background: root.fill;
            border-width: root.outlined ? 2px : 0px;
            border-color: Theme.brand-ink;
            label := Text {
                text: root.text;
                font-family: Theme.font-title;
                font-size: root.font-size;
                font-weight: 700;
                color: root.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

/// The "Espectral / Client" lockup of espectral.uhce.top/client: two lines of
/// per-letter gold wordmark with the green tilted version tag after "Client".
/// The site draws it at 64px; the header uses 16px.
///
///     ClientLockup { font-size: 16px; version: AppState.version-label; }
export component ClientLockup inherits VerticalLayout {
    in property <length> font-size: 16px;
    /// "v1.7"; the tag is hidden when empty.
    in property <string> version;
    accessible-role: text;
    accessible-label: "Espectral Client " + version;
    spacing: 0px;
    alignment: center;
    Wordmark { font-size: root.font-size; }
    HorizontalLayout {
        spacing: 0px;
        alignment: start;
        WordmarkLetter { letter: "C"; tint: #ffaa00; font-size: root.font-size; }
        WordmarkLetter { letter: "l"; tint: #ffc500; font-size: root.font-size; }
        WordmarkLetter { letter: "i"; tint: #ffdf11; font-size: root.font-size; }
        WordmarkLetter { letter: "e"; tint: #fff744; font-size: root.font-size; }
        WordmarkLetter { letter: "n"; tint: #ffef33; font-size: root.font-size; }
        WordmarkLetter { letter: "t"; tint: #ffd700; font-size: root.font-size; }
        if root.version != "": HorizontalLayout {
            padding-left: root.font-size * 0.375;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Sticker {
                    text: root.version;
                    fill: #10b981;
                    ink: #07021a;
                    tilt: -8deg;
                    outlined: false;
                    // the site's tag is 3/8 of the title size; 8px is the smallest crisp size
                    font-size: max(8px, round(root.font-size * 0.375 / 8px) * 8px);
                }
            }
        }
    }
}

