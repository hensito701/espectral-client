// Btn — poster buttons (espectral.uhce.top):
//   primary   flat gold pill, purple-ink label, hard 4px purple shadow below;
//             hover goes darker gold and lifts 2px, press sinks 2px
//   secondary 2px gold outline + gold label, fills gold on hover
//   ghost     bare label, gold on hover
//   danger    flat red pill with the ink shadow
//
//     Btn { text: T.tr("actions.save"); clicked => { ... } }
//     Btn { variant: BtnVariant.secondary; size: BtnSize.sm; icon: Icons.refresh; text: "..."; }
//     Btn { emoji: "📦"; text: T.tr("home.importModpack"); variant: BtnVariant.secondary; }
//     Btn { variant: BtnVariant.primary; loading: true; }        // spinner, not clickable

import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { Emoji } from "emoji.slint";

export enum BtnVariant { primary, secondary, ghost, danger }
export enum BtnSize { sm, md, lg }

export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <brush> tint: Theme.text;
    width: size;
    height: size;
    // track
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 21 12 A 9 9 0 1 1 3 12 A 9 9 0 1 1 21 12";
        stroke: root.tint;
        stroke-width: root.size * 3 / 24;
        opacity: 0.25;
    }
    head := Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 3 A 9 9 0 0 1 21 12";
        stroke: root.tint;
        stroke-width: root.size * 3 / 24;
        stroke-line-cap: round;
        // Only animates while a spinner is visible (animation-tick keeps redrawing).
        transform-rotation: mod(animation-tick(), 750ms) / 750ms * 360deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <BtnVariant> variant: BtnVariant.primary;
    in property <BtnSize> size: BtnSize.md;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    /// Stretch to the parent width (CSS .btn--block). Otherwise the width hugs the content.
    in property <bool> block: false;
    /// Leading icon path (Icons.*). Ignored when empty.
    in property <string> icon;
    /// Leading color emoji (e.g. "📦"). Ignored when empty.
    in property <string> emoji;
    /// Font size override (0 = size default).
    in property <length> font-size-override: 0px;
    in property <string> tooltip;
    out property <bool> hovered: touch.has-hover && interactive;
    out property <bool> pressed: touch.pressed && interactive;
    callback clicked();

    property <bool> interactive: enabled && !loading;
    property <length> h: size == BtnSize.sm ? 28px : size == BtnSize.lg ? 48px : 38px;
    property <length> pad: size == BtnSize.sm ? Theme.space-3 : size == BtnSize.lg ? Theme.space-6 : Theme.space-4;
    property <length> fs: font-size-override > 0 ? font-size-override : size == BtnSize.sm ? Theme.text-xs : size == BtnSize.lg ? Theme.text-base : Theme.text-sm;
    property <bool> solid: variant == BtnVariant.primary || variant == BtnVariant.danger;
    property <color> outline: Theme.accent-id == "oro" ? Theme.title-color : Theme.accent;
    property <color> fg: variant == BtnVariant.primary ? Theme.btn-ink
        : variant == BtnVariant.danger ? #ffffff
        : variant == BtnVariant.secondary ? (hovered ? Theme.btn-ink : outline)
        : hovered ? outline : Theme.muted-strong;
    /// Shadow depth under the filled pills (0 for outline / ghost).
    property <length> depth: !solid ? 0px : size == BtnSize.sm ? 3px : 4px;

    height: h + depth;
    min-width: block ? 0px : row.preferred-width;
    preferred-width: row.preferred-width;
    horizontal-stretch: block ? 1 : 0;
    border-radius: Theme.radius-pill;
    opacity: enabled ? 1 : 0.45;

    // hover lifts 2px off the shadow, press sinks onto it
    property <length> lift: !interactive || !solid ? 0px : pressed ? 2px : hovered ? -2px : 0px;
    animate lift { duration: Theme.dur-fast; easing: ease-out; }

    background: transparent;

    // hard shadow under the filled pills (box-shadow: 0 4px 0 purple)
    if root.solid: Rectangle {
        y: root.depth;
        width: 100%;
        height: root.h;
        border-radius: Theme.radius-pill;
        background: root.variant == BtnVariant.danger ? Theme.brand-ink : Theme.brand-purple;
    }

    face := Rectangle {
        y: root.lift;
        width: 100%;
        height: root.h;
        border-radius: Theme.radius-pill;
        border-width: root.variant == BtnVariant.secondary ? 2px : 0px;
        clip: true;
        background: root.variant == BtnVariant.primary ? (root.hovered ? Theme.btn-fill-hover : Theme.btn-fill)
            : root.variant == BtnVariant.danger ? (root.hovered ? #c81e1e : Theme.accent-red)
            : root.variant == BtnVariant.secondary ? (root.hovered ? root.outline : transparent)
            : transparent;
        border-color: root.outline;
        animate background { duration: Theme.dur-fast; }

        row := HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: Theme.space-2;
            alignment: center;
            if root.loading: VerticalLayout {
                alignment: center;
                Spinner { size: root.fs; tint: root.fg; }
            }
            if !root.loading && root.icon != "": VerticalLayout {
                alignment: center;
                Icon { data: root.icon; size: root.fs + 2px; color: root.fg; }
            }
            if !root.loading && root.emoji != "": VerticalLayout {
                alignment: center;
                Emoji { char: root.emoji; size: root.fs; }
            }
            if root.text != "": Text {
                text: root.text;
                color: root.fg;
                font-size: root.fs;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// Square icon-only button (TopChrome toggles, modal close, toolbar icons).
export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <length> size: 34px;
    in property <length> icon-size: 16px;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> flat: false;
    in property <string> tooltip;
    out property <bool> hovered: touch.has-hover && enabled;
    callback clicked();

    width: size;
    height: size;
    border-radius: Theme.radius-md;
    background: flat ? (hovered ? Theme.surface-up : transparent) : hovered ? Theme.surface-up : Theme.surface;
    border-width: flat ? 0px : 2px;
    border-color: hovered || active ? Theme.hover-border : Theme.border-solid;
    opacity: enabled ? 1 : 0.45;
    animate background, border-color { duration: Theme.dur-fast; }

    Icon {
        data: root.icon;
        size: root.icon-size;
        color: root.hovered || root.active ? Theme.hover-border : Theme.muted-strong;
        animate color { duration: Theme.dur-fast; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
