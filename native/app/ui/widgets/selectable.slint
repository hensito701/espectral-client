// SelectableText — display text the mouse can select and Ctrl+C can copy.
// Slint `Text` cannot be selected; this is a read-only TextInput styled like a
// Text, and a drop-in for it: same `text`, `color`, `font-*`, `wrap`,
// `horizontal-alignment`, `vertical-alignment`, `letter-spacing`.
// No `overflow: elide` (TextInput can't elide): keep plain Text for labels
// that must elide in a tight width. Never put it above a TouchArea that
// should get the click (buttons, rows, tabs, pills): it takes the press.
//
//     SelectableText { text: root.version; font-size: 13.6px; font-weight: 600; }
//     SelectableText { text: T.tr("..."); color: Theme.muted; wrap: word-wrap; }

import { Theme } from "../theme.slint";

export component SelectableText inherits TextInput {
    read-only: true;
    single-line: self.wrap == TextWrap.no-wrap;
    font-family: Theme.font-body;
    color: Theme.text;
    selection-background-color: Theme.accent.with-alpha(0.3);
    selection-foreground-color: Theme.text;
    accessible-role: AccessibleRole.text;
}
