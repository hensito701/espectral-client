// GlassCard — the poster "card / section block" (espectral.uhce.top): solid
// surface, 2px border, hard 4px ink shadow down-right. Interactive cards lift
// 2px up-left on hover; the border turns gold and the shadow becomes a 6px
// purple block. No glass, no sheen. (The name is kept for the callers.)
//
//     GlassCard { title: "..."; subtitle: "..."; VerticalLayout { ... } }
//     GlassCard { elevation: Elevation.lg; featured: true; padding-size: 0px; ... }
//     GlassCard { clickable: true; clicked => { ... } ... }   // hover lift + gold border

import { Theme } from "../theme.slint";

export enum Elevation { none, sm, md, lg }

export component GlassCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> footer;
    in property <Elevation> elevation: Elevation.md;
    /// Hover lift + accent border (CSS --interactive).
    in property <bool> interactive: false;
    /// Clickable card (implies interactive): emits clicked().
    in property <bool> clickable: false;
    /// Gold border + purple block shadow (the highlighted card).
    in property <bool> featured: false;
    /// Opaque --surface-solid fill (CSS backdrop=false / --flat-surface).
    in property <bool> flat: false;
    /// Inner padding (CSS 20px).
    in property <length> padding-size: Theme.space-5;
    in property <length> spacing: Theme.space-3;
    in property <brush> fill: flat ? Theme.surface-solid : Theme.card-bg;
    in property <length> radius: Theme.radius-lg;
    out property <bool> hovered: touch.has-hover && (interactive || clickable);
    callback clicked();

    // size from the content layout, plus room for the shadow block
    min-width: content.min-width + shadow;
    min-height: content.min-height + shadow;
    preferred-width: content.preferred-width + shadow;
    preferred-height: content.preferred-height + shadow;

    property <bool> hot: hovered || featured;
    /// Shadow block offset: none / 2 / 4 / 6px. Constant, so hovering never
    /// changes the layout: the face lifts 2px instead, which makes the visible
    /// shadow 2px deeper.
    property <length> shadow: elevation == Elevation.none && !featured ? 0px : featured || elevation == Elevation.lg ? 6px : elevation == Elevation.sm ? 2px : 4px;
    property <length> lift: hovered ? -2px : 0px;
    animate lift { duration: Theme.dur-fast; easing: ease-out; }

    background: transparent;

    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }

    // hard shadow block (box-shadow: Npx Npx 0 ink)
    Rectangle {
        x: root.shadow;
        y: root.shadow;
        width: root.width - root.shadow;
        height: root.height - root.shadow;
        border-radius: root.radius;
        background: root.hot ? Theme.brand-purple : Theme.brand-ink;
        visible: root.shadow > 0;
    }

    Rectangle {
        x: root.lift;
        y: root.lift;
        width: root.width - root.shadow;
        height: root.height - root.shadow;
        border-radius: root.radius;
        background: root.fill;
        border-width: 2px;
        border-color: root.hot ? Theme.hover-border : Theme.border-solid;
        clip: true;
        animate border-color { duration: Theme.dur-fast; }

        // horizontal padding on a HorizontalLayout (see UI-PORTING.md "wrapped text")
        content := HorizontalLayout {
          padding-left: root.padding-size;
          padding-right: root.padding-size;
          VerticalLayout {
            padding-top: root.padding-size;
            padding-bottom: root.padding-size;
            spacing: root.spacing;

            if root.title != "" || root.subtitle != "": VerticalLayout {
                spacing: Theme.space-1;
                if root.title != "": Text {
                    text: root.title;
                    color: Theme.title-color;
                    font-family: Theme.font-title;
                    font-size: 16px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: Theme.muted;
                    font-size: Theme.text-xs;
                    wrap: word-wrap;
                }
            }

            @children

            if root.footer != "": VerticalLayout {
                padding-top: Theme.space-3;
                Rectangle { height: 2px; background: Theme.border-solid; }
                Text {
                    text: root.footer;
                    color: Theme.muted;
                    font-size: Theme.text-xs;
                    wrap: word-wrap;
                }
            }
          }
        }
    }
}

/// Plain bordered surface (base.css .card-surface / .glass-row) without layout.
export component Surface inherits Rectangle {
    in property <bool> soft: false;
    in property <bool> solid: false;
    in property <bool> hoverable: false;
    out property <bool> hovered: touch.has-hover && hoverable;
    callback clicked();
    border-radius: Theme.radius-md;
    background: solid ? Theme.surface-solid : soft ? Theme.card-bg-soft : hovered ? Theme.surface-up : Theme.surface;
    border-width: 2px;
    border-color: hovered ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    touch := TouchArea {
        enabled: root.hoverable;
        mouse-cursor: root.hoverable ? pointer : default;
        clicked => { root.clicked(); }
    }
    @children
}
