// GlassCard — a translucent glass panel over the backdrop glows: dark tint,
// 1px hairline brighter along the top (the "liquid" rim), a faint sheen in
// the upper part. Interactive cards brighten and take an accent edge on
// hover. Only `Elevation.lg` / featured cards cast a (soft) shadow.
//
//     GlassCard { title: "..."; subtitle: "..."; VerticalLayout { ... } }
//     GlassCard { elevation: Elevation.lg; featured: true; padding-size: 0px; ... }
//     GlassCard { clickable: true; clicked => { ... } ... }   // hover edge

import { Theme } from "../theme.slint";

export enum Elevation { none, sm, md, lg }

/// The glass face shared by GlassCard and Surface: sheen + rim, no layout.
export component GlassSheen inherits Rectangle {
    in property <length> radius: Theme.radius-lg;
    border-radius: radius;
    // upper sheen: light falls on the top of the glass
    background: @linear-gradient(180deg, Theme.dark ? rgba(255, 255, 255, 0.045) : rgba(255, 255, 255, 0.5) 0%, transparent 45%);
    // top rim highlight
    Rectangle {
        x: root.radius;
        y: 0px;
        width: max(0px, root.width - 2 * root.radius);
        height: 1px;
        background: @linear-gradient(90deg, transparent 0%, Theme.sheen 50%, transparent 100%);
    }
}

export component GlassCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> footer;
    in property <Elevation> elevation: Elevation.md;
    /// Hover edge (CSS --interactive).
    in property <bool> interactive: false;
    /// Clickable card (implies interactive): emits clicked().
    in property <bool> clickable: false;
    /// Accent edge (the highlighted card).
    in property <bool> featured: false;
    /// Opaque fill (cards over other content, not over the backdrop).
    in property <bool> flat: false;
    /// Inner padding.
    in property <length> padding-size: Theme.space-5;
    in property <length> spacing: Theme.space-3;
    in property <brush> fill: flat ? Theme.surface-solid : Theme.card-bg;
    in property <length> radius: Theme.radius-lg;
    out property <bool> hovered: touch.has-hover && (interactive || clickable);
    callback clicked();

    min-width: content.min-width;
    min-height: content.min-height;
    preferred-width: content.preferred-width;
    preferred-height: content.preferred-height;

    property <bool> hot: hovered || featured;

    border-radius: root.radius;
    background: root.hovered ? Theme.surface-up : root.fill;
    border-width: Theme.hairline;
    border-color: root.hot ? Theme.hover-border : Theme.glass-border;
    drop-shadow-blur: root.elevation == Elevation.lg || root.featured ? Theme.shadow-lg-blur : 0px;
    drop-shadow-offset-y: root.elevation == Elevation.lg || root.featured ? Theme.shadow-lg-y : 0px;
    drop-shadow-color: root.elevation == Elevation.lg || root.featured ? Theme.shadow-lg-color : transparent;
    clip: true;
    animate background, border-color { duration: Theme.dur-fast; }

    GlassSheen {
        width: 100%;
        height: 100%;
        radius: root.radius;
    }

    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }

    // horizontal padding on a HorizontalLayout (see UI-PORTING.md "wrapped text")
    content := HorizontalLayout {
        padding-left: root.padding-size;
        padding-right: root.padding-size;
        VerticalLayout {
            padding-top: root.padding-size;
            padding-bottom: root.padding-size;
            spacing: root.spacing;

            if root.title != "" || root.subtitle != "": VerticalLayout {
                spacing: 2px;
                if root.title != "": Text {
                    text: root.title;
                    color: Theme.title-color;
                    font-family: Theme.font-title;
                    font-size: Theme.text-base;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: Theme.muted;
                    font-size: Theme.text-xs;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }

            @children

            if root.footer != "": VerticalLayout {
                padding-top: Theme.space-3;
                spacing: Theme.space-2;
                Rectangle { height: Theme.hairline; background: Theme.border-solid; }
                Text {
                    text: root.footer;
                    color: Theme.muted;
                    font-size: Theme.text-xs;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }
        }
    }
}

/// Plain glass surface (rows, wells) without layout.
export component Surface inherits Rectangle {
    in property <bool> soft: false;
    in property <bool> solid: false;
    in property <bool> hoverable: false;
    out property <bool> hovered: touch.has-hover && hoverable;
    callback clicked();
    border-radius: Theme.radius-md;
    background: solid ? Theme.surface-solid : hovered ? Theme.surface-up : soft ? Theme.card-bg-soft : Theme.surface;
    border-width: Theme.hairline;
    border-color: hovered ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    touch := TouchArea {
        enabled: root.hoverable;
        mouse-cursor: root.hoverable ? pointer : default;
        clicked => { root.clicked(); }
    }
    @children
}
