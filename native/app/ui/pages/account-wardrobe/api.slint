// OWNER: account-wardrobe agent. The group's single bridge global — the only Slint global
// of this group that Rust can see (app.slint re-exports it by name).
// Rust side: native/app/src/pages/account_wardrobe.rs (+ account_wardrobe/*.rs).
//
// Pages: AccountPage (account-vault.slint, #/account — accounts, Skin Atelier,
// Espectral identity, Discord, supporter badges, cosmetics pointer and hidden
// players) and AccountPopover (account-popover.slint).

import { AccountRow } from "../../state.slint";

/// Skin gallery entry (engine types::SkinLibraryEntry).
export struct VaultSkinEntry {
    id: string,
    name: string,
    /// "classic" | "slim"
    variant: string,
}

/// Espectral identity of the active account (engine types::IdentityAccount +
/// PublicAccount bits). Shown in the identity card of the Cuenta page.
export struct EspectralIdentity {
    username: string,
    verified: bool,
    supporter: bool,
    mvp: bool,
    offline: bool,
    has-discord: bool,
    discord-username: string,
    has-discord-avatar: bool,
    discord-avatar: image,
    /// Formatted grant expiry per UI language ("" when none).
    grant-exp-es: string,
    grant-exp-en: string,
}

export global AccountBridge {
    // =====================================================================
    // Account vault (#/account) — shared with the popover
    // =====================================================================
    /// Accounts sorted like the Svelte vault: active first, then last_used desc.
    in property <[AccountRow]> accounts;
    /// The active account (most recently used) — valid when has-active.
    in property <AccountRow> active;
    in property <bool> has-active;
    /// First load in flight (no accounts yet).
    in property <bool> loading;
    /// Silent reload in flight (refresh button spinner).
    in property <bool> refreshing;
    callback refresh();
    callback set-active(username: string);

    // offline forge
    in property <bool> offline-creating;
    in property <string> offline-error;
    /// Bumped after a successful create so the page clears its input.
    in property <int> offline-created-serial;
    callback create-offline(username: string);

    // Microsoft device flow
    in property <bool> ms-flow;
    in property <bool> ms-polling;
    in property <bool> ms-pending;
    in property <string> ms-error;
    in property <string> ms-user-code;
    in property <string> ms-verification-uri;
    in property <string> ms-verification-uri-complete;
    callback start-ms();
    callback cancel-ms();

    // inline MSA sign-out
    in-out property <string> confirming-logout;
    in property <bool> logging-out;
    callback logout-msa(username: string);

    // avatar customization
    in property <string> avatar-busy;
    /// hue -1 = clear the custom color.
    callback set-avatar-color(username: string, hue: int);
    callback upload-avatar(username: string);
    callback remove-avatar(username: string);

    // advanced Azure client id
    in property <string> client-id;
    in property <bool> client-id-loading;
    in property <bool> client-id-saving;
    in property <string> client-id-error;
    /// Bumped whenever Rust loaded/saved the id (the page copies client-id into its field).
    in property <int> client-id-serial;
    callback load-client-id();
    callback save-client-id(value: string);

    // ---- Skin Atelier ----
    in property <bool> skin-loading;
    in property <bool> skin-busy;
    /// SkinInfo known for the active MSA account.
    in property <bool> skin-info;
    in property <bool> skin-has-skin;
    in property <bool> skin-cape;
    /// "classic" | "slim" (radio group).
    in-out property <string> skin-variant: "classic";
    /// A local file is staged in the viewer.
    in property <bool> staged;
    /// Local PNG path of the staged file (SkinView "file:" source).
    in property <string> staged-path;
    in-out property <string> staged-name;
    in property <int> staged-serial;
    in-out property <bool> confirming-skin-reset;
    callback pick-skin-file();
    callback clear-staged();
    callback save-to-gallery(name: string);
    callback reset-skin();
    callback refresh-skin();
    /// Open NovaSkin's editor with the skin the atelier is showing (gallery
    /// preview, else the active account's skin; the bare editor otherwise).
    callback open-novaskin();

    // gallery
    in property <[VaultSkinEntry]> gallery;
    in property <bool> gallery-loading;
    in property <bool> importing-vanilla;
    in-out property <string> preview-id;
    in property <string> preview-name;
    in property <string> preview-variant;
    in property <string> applying-id;
    in property <string> deleting-id;
    in-out property <string> renaming-id;
    in-out property <string> confirming-delete-id;
    callback reload-gallery();
    callback import-vanilla();
    callback preview-entry(id: string);
    callback apply-entry(id: string);
    callback delete-entry(id: string);
    callback rename-entry(id: string, name: string);
    /// Page asks Rust to scroll the stage into view (set by Rust, read by the page).
    in property <int> preview-serial;

    // ---- Account popover ----
    /// accounts minus the active one (quick-switch list).
    in property <[AccountRow]> popover-others;
    in property <bool> popover-creating;
    in property <string> popover-error;
    in property <int> popover-created-serial;
    callback popover-create(username: string);
    callback popover-switch(username: string);
    /// Popover opened (reload accounts).
    callback popover-opened();

    // =====================================================================
    // Espectral identity of the ACTIVE account (identity card of #/account):
    // Minecraft ownership proof, Discord link, supporter flags and the hidden
    // players list. The wardrobe page is gone; this follows the active account.
    // =====================================================================
    /// Identity loaded and known for the account on the pedestal.
    in property <bool> identity-available;
    in property <EspectralIdentity> identity;
    in property <bool> identity-loading: true;
    in property <string> identity-load-error;
    in property <[string]> identity-hidden;
    in property <string> identity-hidden-error;
    in property <int> identity-hidden-serial;
    in property <bool> identity-verifying;
    in property <bool> identity-refreshing;
    in property <bool> identity-linking;
    in property <bool> identity-unlinking;
    callback identity-load();
    callback identity-verify();
    callback identity-refresh-flags();
    callback identity-link();
    callback identity-cancel-link();
    callback identity-unlink();
    callback identity-add-hidden(name: string);
    callback identity-remove-hidden(name: string);

    /// First n characters (Slint strings have no substring()).
    pure callback truncate(text: string, n: int) -> string;
    /// String.trim().
    pure callback trim(text: string) -> string;
    /// "^[A-Za-z0-9_]{2,16}$" (offline forge / popover): implemented in Rust.
    pure callback valid-offline-name(name: string) -> bool;
}
