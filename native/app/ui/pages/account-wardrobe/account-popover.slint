// OWNER: account-wardrobe agent. Port of components/AccountPopover.svelte.
// app.slint places it under the TopChrome account chip (top-right, 320px wide)
// and shows it while Shell.account-popover-open (click outside / Esc close it).

import { Theme, T, Shell, Router, Util, AccountRow, Icon, Icons, Spinner, MonogramTile, MonogramShape, ScrollArea } from "../../widgets.slint";
import { AccountBridge } from "api.slint";
import { PlainInput, MsLogo } from "parts.slint";

component ActiveCard inherits Rectangle {
    in property <AccountRow> acc;
    border-radius: Theme.radius-md;
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: Theme.border-solid;
    HorizontalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                MonogramTile {
                    name: root.acc.username;
                    hue: root.acc.monogram-hue;
                    avatar: root.acc.avatar;
                    has-avatar: root.acc.has-avatar;
                    size: 44px;
                    shape: MonogramShape.circle;
                }
                Rectangle {
                    x: parent.width - 8px;
                    y: parent.height - 8px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.acc.token-kind == "msa" ? Theme.msa-blue : Theme.mode-uhc;
                    border-width: 2px;
                    border-color: Theme.brand-ink;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Rectangle {
                    background: Theme.gold;
                    border-radius: Theme.radius-xs;
                    width: active-lbl.preferred-width + 8px;
                    height: active-lbl.preferred-height + 2px;
                    active-lbl := Text {
                        text: T.tr("account.active");
                        font-family: Theme.font-pixel;
                        font-size: 8px;
                        color: Theme.on-gold;
                    }
                }
                Text {
                    text: root.acc.token-kind == "msa" ? "Microsoft" : "Offline";
                    font-size: Theme.text-xs;
                    font-weight: 600;
                    color: root.acc.token-kind == "msa" ? Theme.msa-blue : Theme.muted;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.acc.username;
                font-size: Theme.text-md;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
            }
            if root.acc.last-used != "": Text {
                text: T.tr("account.lastUsed") + ": " + Util.relative-time(root.acc.last-used, T.lang);
                font-size: Theme.text-xs;
                color: Theme.muted;
            }
        }
    }
}

component SwitchItem inherits Rectangle {
    in property <AccountRow> acc;
    callback clicked();
    height: row.preferred-height;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.surface-up : transparent;
    border-width: 2px;
    border-color: ta.has-hover ? Theme.hover-border : transparent;
    animate background, border-color { duration: Theme.dur-fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-2;
        MonogramTile {
            name: root.acc.username;
            hue: root.acc.monogram-hue;
            avatar: root.acc.avatar;
            has-avatar: root.acc.has-avatar;
            size: 32px;
            shape: MonogramShape.circle;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.acc.username; font-size: Theme.text-sm; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: root.acc.token-kind == "msa" ? "Microsoft" : "Offline"; font-size: Theme.text-xs; color: Theme.muted; }
        }
        VerticalLayout {
            alignment: center;
            Icon { data: Icons.chevron-right; size: 14px; color: ta.has-hover ? Theme.title-color : Theme.muted; }
        }
    }
}

component SectionLabel inherits HorizontalLayout {
    in property <string> text;
    in property <string> count;
    // CSS line-height 1.6
    min-height: 19px;
    Text {
        text: root.text.to-uppercase();
        font-size: Theme.text-xs;
        font-weight: 600;
        letter-spacing: 0.48px;
        color: Theme.muted;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    if root.count != "": Rectangle {
        background: Theme.card-bg-soft;
        border-width: 2px;
        border-color: Theme.border-solid;
        border-radius: Theme.radius-xs;
        width: cnt.preferred-width + 10px;
        height: cnt.preferred-height + 2px;
        cnt := Text { text: root.count; font-family: Theme.font-pixel; font-size: 8px; color: Theme.muted; vertical-alignment: center; horizontal-alignment: center; }
    }
}

/// Footer action: Microsoft = partner pill (#00A4EF fill, ink border, hard
/// shadow); everything else = poster secondary chip.
component FooterBtn inherits Rectangle {
    in property <string> text;
    in property <bool> msa;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius-pill;
    property <bool> hot: ta.has-hover;
    property <length> depth: 3px;
    // hard ink shadow block
    Rectangle {
        y: root.depth;
        width: 100%;
        height: root.height - root.depth;
        border-radius: Theme.radius-pill;
        background: Theme.brand-ink;
    }
    face := Rectangle {
        width: 100%;
        height: root.height - root.depth;
        border-radius: Theme.radius-pill;
        border-width: 2px;
        border-color: root.hot ? Theme.brand-ink : root.msa ? Theme.brand-ink : Theme.border-solid;
        background: root.msa ? Theme.msa-blue : root.hot ? Theme.gold : Theme.surface;
        animate background, border-color { duration: Theme.dur-fast; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        width: 100%;
        height: root.height - root.depth;
        padding-left: 12px;
        padding-right: 12px;
        spacing: Theme.space-2;
        alignment: center;
        VerticalLayout {
            alignment: center;
            if root.msa: MsLogo { size: 16px; }
            if !root.msa: Icon { data: Icons.user; size: 16px; color: root.hot ? Theme.on-gold : Theme.text; }
        }
        Text {
            text: root.text;
            font-size: Theme.text-xs;
            font-weight: 700;
            color: root.msa ? #ffffff : root.hot ? Theme.on-gold : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component AddForm inherits VerticalLayout {
    property <string> name;
    property <int> created: AccountBridge.popover-created-serial;
    changed created => { input.text = ""; root.name = ""; }
    property <bool> valid: AccountBridge.valid-offline-name(root.name);
    spacing: Theme.space-2;
    SectionLabel { text: T.tr("account.createOffline"); }
    HorizontalLayout {
        spacing: 6px;
        input := PlainInput {
            height: 34px;
            fill: Theme.surface;
            focus-border: Theme.border-focus;
            pad-x: 10px;
            placeholder: T.tr("account.usernamePlaceholder");
            max-length: 16;
            edited(t) => { root.name = t; }
            accepted => { AccountBridge.popover-create(root.name); }
        }
        Rectangle {
            property <bool> enabled: root.valid && !AccountBridge.popover-creating;
            width: 38px;
            height: 38px;
            border-radius: Theme.radius-md;
            background: self.enabled ? Theme.gold : Theme.surface-up;
            border-width: 2px;
            border-color: Theme.brand-ink;
            opacity: self.enabled ? (add-ta.has-hover ? 0.85 : 1) : 0.35;
            if AccountBridge.popover-creating: Spinner { size: 14px; tint: Theme.on-gold; }
            if !AccountBridge.popover-creating: Icon { data: Icons.plus; size: 16px; weight: 2.5; color: Theme.on-gold; }
            add-ta := TouchArea {
                enabled: parent.enabled;
                mouse-cursor: parent.enabled ? pointer : not-allowed;
                clicked => { AccountBridge.popover-create(root.name); }
            }
        }
    }
    if AccountBridge.popover-error != "": Text {
        text: AccountBridge.popover-error;
        font-size: Theme.text-xs;
        color: Theme.accent-red;
        wrap: word-wrap;
    }
}

export component AccountPopover inherits Rectangle {
    width: 320px;
    height: col.preferred-height;
    border-radius: Theme.radius-lg;
    background: Theme.surface-solid;
    border-width: 2px;
    border-color: Theme.border-solid;
    // opaque card, hard 6px ink shadow (poster)
    drop-shadow-color: Theme.brand-ink;
    drop-shadow-blur: 0px;
    drop-shadow-offset-x: 6px;
    drop-shadow-offset-y: 6px;
    clip: true;

    init => { AccountBridge.popover-opened(); }

    // swallow clicks (app.slint's click-outside area is underneath)
    TouchArea { }

    col := VerticalLayout {
        // ---- header ----
        Rectangle {
            background: Theme.card-bg-soft;
            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-3;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        background: Theme.gold;
                        border-width: 2px;
                        border-color: Theme.brand-ink;
                    }
                }
                Text {
                    text: T.tr("account.profileTitle").to-uppercase();
                    font-family: Theme.font-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.title-color;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    border-width: 2px;
                    border-color: close-ta.has-hover ? Theme.hover-border : transparent;
                    background: close-ta.has-hover ? Theme.surface-up : transparent;
                    Icon { data: Icons.x; size: 16px; color: close-ta.has-hover ? Theme.title-color : Theme.muted; }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Shell.account-popover-open = false; }
                    }
                }
            }
        }
        Rectangle { height: 2px; background: Theme.border-solid; }

        // ---- body ----
        VerticalLayout {
            padding: Theme.space-4;
            spacing: Theme.space-4;
            if AccountBridge.loading && AccountBridge.accounts.length == 0: HorizontalLayout {
                alignment: center;
                spacing: Theme.space-2;
                padding-top: Theme.space-6;
                padding-bottom: Theme.space-6;
                Spinner { size: 20px; tint: Theme.accent; }
                Text { text: T.tr("common.loading"); color: Theme.muted; font-size: Theme.text-sm; vertical-alignment: center; }
            }
            if !(AccountBridge.loading && AccountBridge.accounts.length == 0) && AccountBridge.has-active: ActiveCard {
                acc: AccountBridge.active;
            }
            if !AccountBridge.loading && !AccountBridge.has-active: VerticalLayout {
                padding-top: Theme.space-4;
                padding-bottom: Theme.space-4;
                Text {
                    height: 22px;
                    vertical-alignment: center;
                    text: T.tr("account.noAccounts");
                    color: Theme.text;
                    font-size: Theme.text-sm;
                    horizontal-alignment: center;
                }
            }
            if AccountBridge.popover-others.length > 0: VerticalLayout {
                spacing: Theme.space-2;
                SectionLabel {
                    text: T.tr("account.switchTitle");
                    count: AccountBridge.popover-others.length;
                }
                // .switch-list: max-height 140px, scrolls beyond
                Rectangle {
                    height: min(140px, list.preferred-height);
                    ScrollArea {
                        list := VerticalLayout {
                            spacing: 4px;
                            for acc in AccountBridge.popover-others: SwitchItem {
                                acc: acc;
                                clicked => { AccountBridge.popover-switch(acc.username); }
                            }
                        }
                    }
                }
            }
            AddForm { }
        }

        // ---- footer ----
        Rectangle { height: 2px; background: Theme.border-solid; }
        Rectangle {
            background: Theme.card-bg-soft;
            VerticalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-3;
                spacing: 6px;
                FooterBtn {
                    msa: true;
                    text: T.tr("account.msLogin");
                    clicked => {
                        Router.navigate("#/account");
                        Shell.account-popover-open = false;
                    }
                }
                FooterBtn {
                    text: T.tr("account.manageAll");
                    clicked => {
                        Router.navigate("#/account");
                        Shell.account-popover-open = false;
                    }
                }
            }
        }
    }
}
