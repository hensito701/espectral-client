// OWNER: account-wardrobe agent. Port of src/ui/src/pages/AccountVault.svelte
// (#/account): hero, identity pedestal, Skin Atelier (3D viewer + gallery),
// account directory, identity forge (offline / Microsoft device flow),
// advanced client id, Lunar shield card, plus the Espectral identity sections
// folded in from the old Armario page (identity.slint).
// Keep the exported component name and the empty interface used by app.slint.

import { Theme, T, Router, AppState, Util, AccountRow, Btn, BtnVariant, BtnSize, Badge, BadgeVariant, McTitle,
    Icon, Icons, Emoji, Spinner, MonogramTile, MonogramShape, Field, PageScaffold, GlassCard, Elevation } from "../../widgets.slint";
import { AccountBridge } from "api.slint";
import { CopyFlag, LoadingRow, UploadChip, PlainInput, MsLogo } from "parts.slint";
import { SkinAtelier } from "skin-atelier.slint";
import { CosmeticsSection, HiddenSection, IdentitySection, MinecraftDisclaimer } from "identity.slint";

// ---------------------------------------------------------------------------
// hero
// ---------------------------------------------------------------------------

component VaultHero inherits HorizontalLayout {
    spacing: Theme.space-4;
    /// Page width, passed down from AccountPage (never measured on this layout).
    in property <length> page-width: 1280px;
    VerticalLayout {
        spacing: Theme.space-2;
        horizontal-stretch: 1;
        min-width: 0px;
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            Badge { text: T.tr("vault.badge"); variant: BadgeVariant.accent; dot: true; }
            Text {
                text: T.tr1("vault.rosterCount", "count", AccountBridge.accounts.length);
                font-size: Theme.text-xs;
                font-weight: 500;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
        // pixel title: tiered so the single-line glyph run always fits the
        // content column; min-width clamped so it can never widen the page
        McTitle {
            text: T.tr("vault.title");
            font-size: root.page-width < 1200px ? 24px : root.page-width < 1440px ? 32px : 40px;
            min-width: 0px;
        }
        HorizontalLayout {
            Text {
                max-width: 680px;
                text: T.tr("vault.subtitle");
                font-size: Theme.text-sm;
                color: Theme.muted;
                wrap: word-wrap;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    VerticalLayout {
        alignment: start;
        horizontal-stretch: 0;
        Btn {
            variant: BtnVariant.secondary;
            size: BtnSize.md;
            icon: Icons.refresh;
            loading: AccountBridge.refreshing;
            text: AccountBridge.refreshing ? T.tr("vault.refreshing") : T.tr("vault.refresh");
            // the label ellipsises instead of pushing the button off the page
            font-size-override: root.page-width < 1200px ? Theme.text-xs : 0px;
            clicked => { AccountBridge.refresh(); }
        }
    }
}

// ---------------------------------------------------------------------------
// pedestal
// ---------------------------------------------------------------------------

component MetaItem inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    Text {
        text: root.label.to-uppercase();
        font-size: Theme.text-xs;
        font-weight: 600;
        letter-spacing: 0.6px;
        color: Theme.muted;
    }
    Text {
        text: root.value;
        font-size: Theme.text-sm;
        font-weight: 500;
        color: Theme.text;
    }
}

component PedestalMeta inherits HorizontalLayout {
    in property <AccountRow> acc;
    spacing: Theme.space-6;
    alignment: start;
    min-width: 0px;
    padding-top: Theme.space-3 - Theme.space-2;
    MetaItem {
        label: T.tr("account.lastUsed");
        value: root.acc.last-used != "" ? Util.relative-time(root.acc.last-used, T.lang) : T.tr("vault.heroNever");
    }
    MetaItem {
        label: T.tr("account.created");
        value: root.acc.created-at != "" ? Util.relative-time(root.acc.created-at, T.lang) : "—";
    }
    VerticalLayout {
        spacing: 2px;
        min-width: 160px;
        Text { text: "UUID"; font-size: Theme.text-xs; font-weight: 600; letter-spacing: 0.6px; color: Theme.muted; }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            Rectangle {
                background: Theme.card-bg-soft;
                border-radius: Theme.radius-xs;
                border-width: 2px;
                border-color: Theme.border-solid;
                width: uuid-text.preferred-width + 12px;
                height: uuid-text.preferred-height + 4px;
                uuid-text := Text {
                    text: AccountBridge.truncate(root.acc.uuid, 14) + "…";
                    font-family: Theme.font-mono;
                    font-size: Theme.text-xs;
                    color: Theme.muted;
                }
            }
            Rectangle {
                width: 21px;
                height: 21px;
                border-radius: Theme.radius-xs;
                background: copy-ta.has-hover ? Theme.gold : transparent;
                copied := CopyFlag { }
                if copied.copied: Text { text: "✓"; color: Theme.accent-green; font-family: Theme.font-mono; font-size: Theme.text-sm; }
                if !copied.copied: Icon { data: Icons.copy; size: 13px; color: copy-ta.has-hover ? Theme.on-gold : Theme.muted; }
                copy-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.copy-text(root.acc.uuid);
                        copied.copied = true;
                    }
                }
            }
        }
    }
}

component Pedestal inherits Rectangle {
    property <bool> has: AccountBridge.has-active;
    property <AccountRow> acc: AccountBridge.active;
    border-radius: Theme.radius-lg;
    background: Theme.card-bg;
    border-width: 2px;
    // C1: the accent is the whole outline (gold, like the other selected cards)
    // so it follows the rounded corners; the old 2px gold rule across the top
    // got clipped at the corners. C2: one frame only — the rounded avatar tile
    // with its hard ink shadow (the dashed ring that overlapped it is gone).
    border-color: Theme.hover-border;
    // hard 4px ink block shadow (unchanged; only the top rule/misplaced ring go)
    drop-shadow-color: Theme.brand-ink;
    drop-shadow-blur: 0px;
    drop-shadow-offset-x: 4px;
    drop-shadow-offset-y: 4px;
    min-height: layout.preferred-height;
    clip: true;

    layout := HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-top: Theme.space-6;
        padding-bottom: Theme.space-6;
        spacing: Theme.space-8;
        min-width: 0px;
        // stage: soft pedestal patch + the avatar tile (the only frame);
        // no border on the patch so the avatar keeps a single frame (C2).
        Rectangle {
            width: 148px;
            height: 148px;
            background: Theme.card-bg-soft;
            border-radius: Theme.radius-md;
            // flat floor rule under the avatar (unchanged)
            Rectangle {
                x: 26px;
                y: 122px;
                width: 96px;
                height: 4px;
                border-radius: 2px;
                background: Theme.brand-purple;
            }
            MonogramTile {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.has ? root.acc.username : "?";
                hue: root.has ? root.acc.monogram-hue : Util.name-hue("?", -1);
                avatar: root.acc.avatar;
                has-avatar: root.has && root.acc.has-avatar;
                size: 104px;
                shape: MonogramShape.rounded;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-2;
            horizontal-stretch: 1;
            min-width: 0px;
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                min-width: 0px;
                Badge { text: T.tr("vault.heroActiveBadge"); variant: BadgeVariant.ok; dot: true; large: true; }
                if root.has && root.acc.token-kind == "msa": Badge { text: T.tr("vault.cardKindMsa"); variant: BadgeVariant.accent; large: true; }
                if !(root.has && root.acc.token-kind == "msa"): Badge { text: T.tr("vault.cardKindOffline"); variant: BadgeVariant.neutral; large: true; }
            }
            McTitle {
                text: root.has ? root.acc.username : T.tr("vault.heroNoActive");
                font-size: 24px;
                min-width: 0px;
                wrap: false;
            }
            HorizontalLayout {
                spacing: Theme.space-1;
                alignment: start;
                height: 19px;
                Text { text: "✦"; color: Theme.accent; font-size: Theme.text-xs; vertical-alignment: center; }
                Text { text: T.tr("vault.heroSkinHint"); color: Theme.muted; font-size: Theme.text-xs; vertical-alignment: center; }
            }
            if root.has: PedestalMeta { acc: root.acc; }
            if !root.has: Text {
                min-height: 22px;
                vertical-alignment: center;
                text: T.tr("vault.heroSelectPrompt");
                color: Theme.muted;
                font-size: Theme.text-sm;
                wrap: word-wrap;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// account directory
// ---------------------------------------------------------------------------

component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    in property <string> count;
    spacing: Theme.space-2;
    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        McTitle {
            text: root.title;
            font-size: 24px;
            min-width: 0px;
            horizontal-stretch: 0;
        }
        Text { text: root.sub; font-size: Theme.text-xs; color: Theme.muted; }
    }
    VerticalLayout {
        alignment: center;
        Badge { text: root.count; variant: BadgeVariant.neutral; }
    }
}

component RosterBox inherits Rectangle {
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: Theme.border-solid;
    border-radius: Theme.radius-lg;
    min-width: 0px;
}

component RosterEmpty inherits RosterBox {
    min-height: col.preferred-height;
    col := HorizontalLayout {
        padding: Theme.space-8;
        alignment: center;
        min-width: 0px;
        VerticalLayout {
            spacing: Theme.space-2;
            max-width: 360px;
            min-width: 0px;
            HorizontalLayout {
                alignment: center;
                padding-bottom: 4px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    opacity: 0.6;
                    Emoji { char: "👤"; size: 32px; }
                }
            }
            Text {
                text: T.tr("vault.rosterEmpty");
                color: Theme.title-color;
                font-family: Theme.font-title;
                font-size: Theme.pix(16px);
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: T.tr("vault.rosterEmptyHint");
                color: Theme.muted;
                font-size: Theme.text-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

component Swatch inherits Rectangle {
    in property <int> hue;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    width: 24px;
    height: 24px;
    Rectangle {
        property <length> s: ta.has-hover && root.enabled ? 24px : 20px;
        width: self.s;
        height: self.s;
        border-radius: self.s / 2;
        background: Theme.hsla(root.hue, 0.7, 0.5, 1);
        border-width: 2px;
        border-color: root.active ? Theme.gold : Theme.brand-ink;
        animate s { duration: Theme.dur-fast; }
    }
    opacity: enabled ? 1 : 0.5;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component AvatarEdit inherits VerticalLayout {
    in property <AccountRow> acc;
    property <bool> busy: AccountBridge.avatar-busy == acc.username;
    spacing: Theme.space-2;
    Rectangle { height: 2px; background: Theme.border-solid; }
    Text { text: T.tr("vault.avatarTitle"); font-size: Theme.text-xs; color: Theme.muted; }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for h in [4, 32, 48, 145, 190, 222, 265, 315]: Swatch {
            hue: h;
            active: root.acc.avatar-color == h;
            enabled: !root.busy;
            clicked => { AccountBridge.set-avatar-color(root.acc.username, root.acc.avatar-color == h ? -1 : h); }
        }
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: start;
        UploadChip {
            text: T.tr("vault.avatarUpload");
            enabled: !root.busy;
            clicked => { AccountBridge.upload-avatar(root.acc.username); }
        }
        if root.acc.has-avatar: Rectangle {
            width: rm.preferred-width + 13px;
            rm := Text { text: T.tr("vault.avatarRemove"); font-size: Theme.text-xs; color: Theme.accent-red; }
            TouchArea {
                enabled: !root.busy;
                mouse-cursor: pointer;
                clicked => { AccountBridge.remove-avatar(root.acc.username); }
            }
        }
    }
}

component LogoutConfirm inherits Rectangle {
    in property <string> username;
    background: Theme.card-bg;
    border-width: 2px;
    border-color: Theme.border-solid;
    border-radius: Theme.radius-lg;
    clip: true;
    TouchArea { }
    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-3;
        Text {
            text: T.tr1("vault.cardLogoutConfirm", "name", root.username);
            font-size: Theme.text-sm;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Btn {
                    variant: BtnVariant.danger;
                    size: BtnSize.sm;
                    loading: AccountBridge.logging-out;
                    text: T.tr("vault.cardLogoutBtn");
                    clicked => { AccountBridge.logout-msa(root.username); }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    variant: BtnVariant.ghost;
                    size: BtnSize.sm;
                    enabled: !AccountBridge.logging-out;
                    text: T.tr("vault.cardLogoutCancel");
                    clicked => { AccountBridge.confirming-logout = ""; }
                }
            }
        }
    }
}

component AccountCard inherits Rectangle {
    in property <AccountRow> acc;
    in property <bool> active;
    property <bool> hovered: ta.has-hover;
    property <bool> hot: active || hovered;
    property <length> lift: hovered ? -2px : 0px;
    animate lift { duration: Theme.dur-fast; easing: ease-out; }
    min-height: body.preferred-height;
    min-width: 0px;
    // hard 4px shadow: ink normally, purple when selected / hovered
    drop-shadow-color: root.hot ? Theme.brand-purple : Theme.brand-ink;
    drop-shadow-blur: 0px;
    drop-shadow-offset-x: 4px;
    drop-shadow-offset-y: 4px;
    border-radius: Theme.radius-lg;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { AccountBridge.set-active(root.acc.username); }
    }
    face := Rectangle {
        y: root.lift;
        height: root.height;
        border-radius: Theme.radius-lg;
        background: root.hot ? Theme.surface-up : Theme.card-bg;
        border-width: 2px;
        border-color: root.hot ? Theme.hover-border : Theme.border-solid;
        animate border-color, background { duration: Theme.dur-fast; }

        body := VerticalLayout {
            padding: Theme.space-4;
            spacing: Theme.space-3;
            // head
            HorizontalLayout {
                spacing: Theme.space-3;
                Rectangle {
                    width: 46px;
                    height: 46px;
                    MonogramTile {
                        name: root.acc.username;
                        hue: root.acc.monogram-hue;
                        avatar: root.acc.avatar;
                        has-avatar: root.acc.has-avatar;
                        size: 46px;
                        shape: MonogramShape.rounded;
                    }
                    if root.active: Rectangle {
                        x: parent.width - 12px;
                        y: parent.height - 12px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.gold;
                        border-width: 2px;
                        border-color: Theme.brand-ink;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        Text {
                            text: root.acc.username;
                            font-size: Theme.text-base;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.active: Badge { text: T.tr("vault.cardActive"); variant: BadgeVariant.ok; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        if root.acc.token-kind == "msa": Badge { text: T.tr("vault.cardKindMsa"); variant: BadgeVariant.accent; }
                        if root.acc.token-kind != "msa": Badge { text: T.tr("vault.cardKindOffline"); variant: BadgeVariant.neutral; }
                        Text {
                            text: AccountBridge.truncate(root.acc.uuid, 8) + "…";
                            font-family: Theme.font-mono;
                            font-size: Theme.text-xs;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            // footer: timestamps + actions
            VerticalLayout {
                spacing: Theme.space-2;
                padding-top: 2px;
                Rectangle { height: 2px; background: Theme.border-solid; }
                HorizontalLayout {
                    spacing: Theme.space-3;
                    min-height: 28px;
                    Text {
                        text: T.tr1("vault.cardLastUsed", "time", root.acc.last-used != "" ? Util.relative-time(root.acc.last-used, T.lang) : T.tr("vault.cardNever"));
                        font-size: Theme.text-xs;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if !root.active: Btn {
                        variant: BtnVariant.ghost;
                        size: BtnSize.sm;
                        text: T.tr("vault.cardSetActive");
                        clicked => { AccountBridge.set-active(root.acc.username); }
                    }
                    if root.acc.token-kind == "msa": Btn {
                        variant: BtnVariant.danger;
                        size: BtnSize.sm;
                        text: T.tr("vault.cardLogoutMsa");
                        clicked => { AccountBridge.confirming-logout = root.acc.username; }
                    }
                }
            }
            // avatar customization (clicks here do not activate the card)
            Rectangle {
                min-height: edit.preferred-height;
                TouchArea { }
                edit := AvatarEdit { acc: root.acc; }
            }
        }

        if AccountBridge.confirming-logout == root.acc.username: LogoutConfirm {
            width: parent.width;
            height: parent.height;
            username: root.acc.username;
        }
    }
}

component Roster inherits VerticalLayout {
    spacing: Theme.space-4;
    alignment: start;
    min-width: 0px;
    SectionHead {
        title: T.tr("vault.rosterTitle");
        sub: T.tr("vault.rosterSubtitle");
        count: AccountBridge.accounts.length;
    }
    if AccountBridge.loading && AccountBridge.accounts.length == 0: RosterBox {
        min-height: lr.preferred-height;
        lr := LoadingRow { text: T.tr("vault.loading"); padding: Theme.space-8; }
    }
    if !AccountBridge.loading && AccountBridge.accounts.length == 0: RosterEmpty { }
    if AccountBridge.accounts.length > 0: VerticalLayout {
        spacing: Theme.space-3;
        min-width: 0px;
        for acc[i] in AccountBridge.accounts: AccountCard {
            acc: acc;
            active: i == 0 && AccountBridge.has-active;
            min-width: 0px;
        }
    }
}

// ---------------------------------------------------------------------------
// identity forge
// ---------------------------------------------------------------------------

component ForgeTab inherits Rectangle {
    in property <string> emoji;
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 38px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.gold : ta.has-hover ? Theme.surface-up : transparent;
    border-width: root.active ? 2px : 0px;
    border-color: Theme.brand-ink;
    animate background { duration: Theme.dur-fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            Emoji { char: root.emoji; size: 14px; }
        }
        Text {
            text: root.text;
            font-size: Theme.text-sm;
            font-weight: 700;
            color: root.active ? Theme.on-gold : ta.has-hover ? Theme.title-color : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
        }
    }
}

component OfflinePane inherits VerticalLayout {
    property <string> name;
    property <int> created: AccountBridge.offline-created-serial;
    changed created => { input.text = ""; root.name = ""; }
    property <bool> valid: AccountBridge.valid-offline-name(root.name);
    spacing: Theme.space-4;
    Text {
        text: T.tr("vault.offlineDesc");
        font-size: Theme.text-sm;
        color: Theme.muted;
        wrap: word-wrap;
    }
    Field {
        label: T.tr("vault.offlineLabel");
        hint: T.tr("vault.offlineValidationHint");
        error: AccountBridge.offline-error;
        required: true;
        HorizontalLayout {
            spacing: Theme.space-2;
            VerticalLayout {
                alignment: center;
                MonogramTile {
                    name: root.name != "" ? root.name : "?";
                    size: 32px;
                    shape: MonogramShape.rounded;
                }
            }
            input := PlainInput {
                field-style: true;
                has-error: AccountBridge.offline-error != "";
                placeholder: T.tr("vault.offlinePlaceholder");
                max-length: 16;
                edited(t) => {
                    root.name = AccountBridge.trim(t);
                }
                accepted => {
                    if root.valid { AccountBridge.create-offline(root.name); }
                }
            }
        }
    }
    VerticalLayout {
        padding-top: Theme.space-2;
        Btn {
            variant: BtnVariant.primary;
            size: BtnSize.md;
            block: true;
            emoji: "⚡";
            enabled: root.valid && !AccountBridge.offline-creating;
            loading: AccountBridge.offline-creating;
            text: AccountBridge.offline-creating ? T.tr("vault.offlineCreating") : T.tr("vault.offlineCreateBtn");
            clicked => { AccountBridge.create-offline(root.name); }
        }
    }
}

component FlowStepHead inherits HorizontalLayout {
    in property <string> mark;
    in property <string> label;
    spacing: Theme.space-2;
    alignment: start;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.gold;
        border-width: 2px;
        border-color: Theme.brand-ink;
        Text {
            text: root.mark;
            // G1: at 8px the pixel font is a 1-px smudge; the body font at the
            // same cap height reads clean.
            font-family: Theme.label-family(8px);
            font-size: Theme.label-size(8px);
            font-weight: 700;
            color: Theme.on-gold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.label;
        font-size: Theme.text-sm;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

component UriPill inherits Rectangle {
    in property <string> label;
    in property <string> url;
    in property <bool> copy-button;
    background: Theme.card-bg-soft;
    border-radius: Theme.radius-sm;
    border-width: 2px;
    border-color: Theme.border-solid;
    min-height: row.preferred-height;
    copied := CopyFlag { }
    row := HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;
        Rectangle {
            horizontal-stretch: 1;
            min-height: link.preferred-height;
            link := Text {
                width: parent.width;
                text: root.label + " ↗";
                color: Theme.accent;
                font-size: Theme.text-sm;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { AppState.open-url(root.url); }
            }
        }
        if root.copy-button: VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.ghost;
                size: BtnSize.sm;
                text: copied.copied ? T.tr("vault.msLinkCopied") : T.tr("vault.msCopyLink");
                clicked => {
                    AppState.copy-text(root.url);
                    copied.copied = true;
                }
            }
        }
    }
}

component CodeBanner inherits Rectangle {
    background: Theme.surface-up;
    border-width: 2px;
    border-color: Theme.accent;
    border-radius: Theme.radius-md;
    min-height: row.preferred-height;
    copied := CopyFlag { }
    row := HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-3;
        Text {
            text: AccountBridge.ms-user-code;
            font-family: Theme.font-pixel;
            font-size: Theme.pix(24px);
            font-weight: 700;
            letter-spacing: 3px;
            color: Theme.title-color;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.primary;
                size: BtnSize.sm;
                emoji: "📋";
                text: copied.copied ? T.tr("vault.msCodeCopied") : T.tr("vault.msCopyCode");
                clicked => {
                    AppState.copy-text(AccountBridge.ms-user-code);
                    copied.copied = true;
                }
            }
        }
    }
}

component DeviceFlowCard inherits Rectangle {
    property <bool> complete: AccountBridge.ms-verification-uri-complete != "";
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: Theme.border-solid;
    border-radius: Theme.radius-md;
    min-height: col.preferred-height;
    col := VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-4;
        VerticalLayout {
            spacing: Theme.space-2;
            FlowStepHead {
                mark: root.complete ? "✓" : "1";
                label: root.complete ? T.tr("vault.msBrowserOpened") : T.tr("vault.msStep1");
            }
            UriPill {
                label: root.complete ? T.tr("vault.msReopenLink") : AccountBridge.ms-verification-uri;
                url: root.complete ? AccountBridge.ms-verification-uri-complete : AccountBridge.ms-verification-uri;
                copy-button: !root.complete;
            }
        }
        VerticalLayout {
            spacing: Theme.space-2;
            FlowStepHead {
                mark: root.complete ? "?" : "2";
                label: root.complete ? T.tr("vault.msFallbackLabel") : T.tr("vault.msStep2");
            }
            CodeBanner { }
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            VerticalLayout {
                alignment: center;
                // static status dot (flat, no glow)
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: Theme.accent;
                    border-width: 2px;
                    border-color: Theme.brand-ink;
                }
            }
            Text {
                text: T.tr("vault.msWaiting");
                font-size: Theme.text-sm;
                color: Theme.muted;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            alignment: end;
            Btn {
                variant: BtnVariant.ghost;
                size: BtnSize.sm;
                text: T.tr("vault.msCancelBtn");
                clicked => { AccountBridge.cancel-ms(); }
            }
        }
    }
}

component MsAlert inherits Rectangle {
    in property <bool> pending;
    border-radius: Theme.radius-md;
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: pending ? Theme.accent-alt : Theme.accent-red;
    min-height: col.preferred-height;
    col := HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        VerticalLayout {
            spacing: 4px;
            if root.pending: HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                VerticalLayout { alignment: center; Emoji { char: "⏳"; size: 14px; } }
                Text { text: T.tr("vault.msaPending"); color: Theme.accent-alt; font-size: Theme.text-sm; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
            }
            if root.pending: Text { text: T.tr("vault.msaPendingHint"); color: Theme.muted; font-size: Theme.text-xs; wrap: word-wrap; }
            if !root.pending: HorizontalLayout {
                spacing: Theme.space-2;
                VerticalLayout { alignment: start; Emoji { char: "⚠️"; size: 14px; } }
                Text { text: AccountBridge.ms-error; color: Theme.accent-red; font-size: Theme.text-xs; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
            }
        }
    }
}

/// Partner-style flat pill for the Microsoft sign-in (#00A4EF fill, ink
/// border, hard ink shadow) — the third-party brand button of the style guide.
component MsPartnerBtn inherits Rectangle {
    in property <string> text;
    in property <bool> loading: false;
    in property <bool> enabled: true;
    callback clicked();
    property <bool> interactive: enabled && !loading;
    property <bool> hot: ta.has-hover && interactive;
    property <length> depth: 4px;
    height: 48px + depth;
    horizontal-stretch: 1;
    opacity: enabled ? 1 : 0.45;

    Rectangle {
        y: root.depth;
        width: 100%;
        height: 48px;
        border-radius: Theme.radius-pill;
        background: Theme.brand-ink;
    }
    Rectangle {
        width: 100%;
        height: 48px;
        border-radius: Theme.radius-pill;
        border-width: 2px;
        border-color: Theme.brand-ink;
        background: root.hot ? #1fb4f5 : Theme.msa-blue;
        animate background { duration: Theme.dur-fast; }
    }
    HorizontalLayout {
        height: 48px;
        alignment: center;
        spacing: Theme.space-2;
        if root.loading: VerticalLayout {
            alignment: center;
            Spinner { size: 16px; tint: #ffffff; }
        }
        if !root.loading: VerticalLayout {
            alignment: center;
            MsLogo { size: 16px; }
        }
        Text {
            text: root.text;
            color: #ffffff;
            font-size: Theme.text-base;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component MsaPane inherits VerticalLayout {
    spacing: Theme.space-4;
    Text {
        text: T.tr("vault.msDesc");
        font-size: Theme.text-sm;
        color: Theme.muted;
        wrap: word-wrap;
    }
    if AccountBridge.ms-flow: DeviceFlowCard { }
    if !AccountBridge.ms-flow: MsPartnerBtn {
        loading: AccountBridge.ms-polling;
        text: AccountBridge.ms-polling ? T.tr("vault.msStarting") : T.tr("vault.msStartBtn");
        clicked => { AccountBridge.start-ms(); }
    }
    if AccountBridge.ms-pending: MsAlert { pending: true; }
    if !AccountBridge.ms-pending && AccountBridge.ms-error != "": MsAlert { pending: false; }
}

component Forge inherits GlassCard {
    in-out property <int> tab;
    title: T.tr("vault.addTitle");
    subtitle: T.tr("vault.addSubtitle");
    elevation: Elevation.md;
    spacing: Theme.space-4;
    // never widen the workbench column from its intrinsic content
    min-width: 0px;
    Rectangle {
        background: Theme.card-bg-soft;
        border-width: 2px;
        border-color: Theme.border-solid;
        border-radius: Theme.radius-md;
        height: 48px;
        HorizontalLayout {
            width: parent.width;
            padding: 4px;
            spacing: 4px;
            ForgeTab {
                horizontal-stretch: 1;
                emoji: "⚡";
                text: T.tr("vault.tabOffline");
                active: root.tab == 0;
                clicked => { root.tab = 0; }
            }
            ForgeTab {
                horizontal-stretch: 1;
                emoji: "🌐";
                text: T.tr("vault.tabMicrosoft");
                active: root.tab == 1;
                clicked => { root.tab = 1; }
            }
        }
    }
    if root.tab == 0: OfflinePane { }
    if root.tab == 1: MsaPane { }
}

component AdvancedClientId inherits Rectangle {
    in-out property <bool> open;
    property <string> value;
    property <int> serial: AccountBridge.client-id-serial;
    changed serial => { root.value = AccountBridge.client-id; }
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: Theme.border-solid;
    border-radius: Theme.radius-lg;
    min-height: col.preferred-height;
    min-width: 0px;
    clip: true;
    col := VerticalLayout {
        Rectangle {
            height: toggle-row.preferred-height;
            min-width: 0px;
            background: toggle-ta.has-hover ? Theme.surface-up : transparent;
            toggle-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = !root.open;
                    if root.open && root.value == "" { AccountBridge.load-client-id(); }
                }
            }
            toggle-row := HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-3;
                spacing: Theme.space-2;
                VerticalLayout { alignment: center; Emoji { char: "⚙️"; size: 14px; } }
                Text {
                    text: T.tr("vault.clientIdToggle");
                    font-size: Theme.text-sm;
                    font-weight: 600;
                    color: toggle-ta.has-hover ? Theme.title-color : Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "▼";
                    font-size: Theme.text-xs;
                    color: toggle-ta.has-hover ? Theme.title-color : Theme.muted;
                    vertical-alignment: center;
                    transform-rotation: root.open ? 180deg : 0deg;
                    animate transform-rotation { duration: Theme.dur-fast; }
                }
            }
        }
        if root.open: Rectangle {
            background: Theme.card-bg;
            min-height: pane.preferred-height;
            min-width: 0px;
            Rectangle { y: 0; height: 2px; background: Theme.border-solid; }
            pane := HorizontalLayout {
                padding: Theme.space-4;
                min-width: 0px;
                VerticalLayout {
                    spacing: Theme.space-3;
                    min-width: 0px;
                    Field {
                        label: T.tr("vault.clientIdLabel");
                        hint: T.tr("vault.clientIdHint");
                        error: AccountBridge.client-id-error;
                        PlainInput {
                            field-style: true;
                            text <=> root.value;
                            placeholder: T.tr("vault.clientIdPlaceholder");
                            enabled: !AccountBridge.client-id-loading && !AccountBridge.client-id-saving;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        Btn {
                            variant: BtnVariant.secondary;
                            size: BtnSize.sm;
                            loading: AccountBridge.client-id-saving;
                            enabled: !AccountBridge.client-id-loading;
                            text: AccountBridge.client-id-saving ? T.tr("vault.clientIdSaving") : T.tr("vault.clientIdSave");
                            clicked => { AccountBridge.save-client-id(root.value); }
                        }
                        Btn {
                            variant: BtnVariant.ghost;
                            size: BtnSize.sm;
                            enabled: !AccountBridge.client-id-saving && !AccountBridge.client-id-loading;
                            text: T.tr("vault.clientIdReset");
                            clicked => {
                                root.value = "";
                                AccountBridge.save-client-id("");
                            }
                        }
                    }
                }
            }
        }
    }
}

