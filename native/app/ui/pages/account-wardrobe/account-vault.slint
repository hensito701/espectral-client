        }
    }
}

component ForgeColumn inherits VerticalLayout {
    in-out property <int> tab;
    in-out property <bool> advanced-open;
    spacing: Theme.space-4;
    alignment: start;
    min-width: 0px;
    Forge { tab <=> root.tab; }
    AdvancedClientId { open <=> root.advanced-open; }
    LunarCard { }
}

// ---------------------------------------------------------------------------
// page
// ---------------------------------------------------------------------------

export component AccountPage inherits Rectangle {
    property <int> forge-tab: 0;
    property <bool> advanced-open: false;
    // CSS @media (max-width: 1024px): workbench stacks
    property <bool> narrow: root.width <= 1024px;
    // content box inside PageScaffold (1400 max incl. 2x32 padding)
    property <length> content-width: min(1400px, root.width) - 2 * Theme.space-8;
    property <length> workbench: max(0px, root.content-width - Theme.space-6);
    property <length> roster-width: root.workbench * 1.4 / 2.4;
    property <length> forge-width: root.workbench - root.roster-width;

    scaffold := PageScaffold {
        max-content-width: 1400px;
        content-padding: Theme.space-8;
        content-padding-top: Theme.space-6;
        content-padding-bottom: Theme.space-12;
        spacing: Theme.space-6;

        VaultHero { min-width: 0px; page-width: root.width; }
        Pedestal { min-width: 0px; }
        atelier := VerticalLayout {
            padding-top: Theme.space-4;
            min-width: 0px;
            SkinAtelier {
                min-width: 0px;
                scroll-request(top, bottom) => { root.ensure-visible(top, bottom); }
            }
        }
        if !root.narrow: HorizontalLayout {
            spacing: Theme.space-6;
            min-width: 0px;
            // fixed split (1.4 / 1) computed from the page width, so no child's
            // intrinsic min-width can stretch the content column
            Roster {
                width: root.roster-width;
            }
            ForgeColumn {
                width: root.forge-width;
                tab <=> root.forge-tab;
                advanced-open <=> root.advanced-open;
            }
        }
        if root.narrow: VerticalLayout {
            spacing: Theme.space-6;
            min-width: 0px;
            Roster { min-width: 0px; }
            ForgeColumn {
                min-width: 0px;
                tab <=> root.forge-tab;
                advanced-open <=> root.advanced-open;
            }
        }
        // Espectral identity of the active account: what the old Armario page
        // held (verification, Discord, ranks, cosmetics pointer, hidden players).
        IdentitySection { min-width: 0px; }
        CosmeticsSection { min-width: 0px; }
        HiddenSection { min-width: 0px; }
        MinecraftDisclaimer { min-width: 0px; }
    }

    /// Bring an absolute y-range (window coordinates) into the viewport.
    function ensure-visible(top: length, bottom: length) {
        let view-top = root.absolute-position.y;
        let view-bottom = view-top + root.height;
        if top < view-top {
            scaffold.content-y = min(0px, scaffold.content-y + (view-top - top) + Theme.space-4);
        } else if bottom > view-bottom {
            scaffold.content-y = scaffold.content-y - min(bottom - view-bottom + Theme.space-4, top - view-top);
        }
    }

    // #/account?section=skin: scroll the Skin Atelier under the header once laid out
    Timer {
        interval: 120ms;
        running: Router.query == "section=skin";
        triggered => {
            self.running = false;
            scaffold.content-y = -max(0px, atelier.absolute-position.y - root.absolute-position.y - scaffold.content-y + Theme.space-4 - 12px);
        }
    }
}
