component ForgeTab inherits Rectangle {
    in property <string> emoji;
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius-sm;
    background: active ? (Theme.dark ? rgba(255, 255, 255, 0.08) : Theme.surface-solid) : transparent;
    drop-shadow-color: active ? rgba(0, 0, 0, 0.2) : transparent;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    animate background { duration: Theme.dur-fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            Emoji { char: root.emoji; size: 14px; }
        }
        Text {
            text: root.text;
            font-size: Theme.text-sm;
            font-weight: 600;
            color: root.active || ta.has-hover ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
    }
}

component OfflinePane inherits VerticalLayout {
    property <string> name;
    property <int> created: AccountBridge.offline-created-serial;
    changed created => { input.text = ""; root.name = ""; }
    property <bool> valid: AccountBridge.valid-offline-name(root.name);
    spacing: Theme.space-4;
    Text {
        text: T.tr("vault.offlineDesc");
        font-size: Theme.text-sm;
        color: Theme.muted;
        wrap: word-wrap;
    }
    Field {
        label: T.tr("vault.offlineLabel");
        hint: T.tr("vault.offlineValidationHint");
        error: AccountBridge.offline-error;
        required: true;
        HorizontalLayout {
            spacing: Theme.space-2;
            VerticalLayout {
                alignment: center;
                MonogramTile {
                    name: root.name != "" ? root.name : "?";
                    size: 32px;
                    shape: MonogramShape.rounded;
                }
            }
            input := PlainInput {
                field-style: true;
                has-error: AccountBridge.offline-error != "";
                placeholder: T.tr("vault.offlinePlaceholder");
                max-length: 16;
                edited(t) => {
                    root.name = AccountBridge.trim(t);
                }
                accepted => {
                    if root.valid { AccountBridge.create-offline(root.name); }
                }
            }
        }
    }
    VerticalLayout {
        padding-top: Theme.space-2;
        Btn {
            variant: BtnVariant.primary;
            size: BtnSize.md;
            block: true;
            emoji: "⚡";
            enabled: root.valid && !AccountBridge.offline-creating;
            loading: AccountBridge.offline-creating;
            text: AccountBridge.offline-creating ? T.tr("vault.offlineCreating") : T.tr("vault.offlineCreateBtn");
            clicked => { AccountBridge.create-offline(root.name); }
        }
    }
}

component FlowStepHead inherits HorizontalLayout {
    in property <string> mark;
    in property <string> label;
    spacing: Theme.space-2;
    alignment: start;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.accent;
        Text { text: root.mark; color: #060a14; font-size: Theme.text-xs; font-weight: 700; }
    }
    Text {
        text: root.label;
        font-size: Theme.text-sm;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

component UriPill inherits Rectangle {
    in property <string> label;
    in property <string> url;
    in property <bool> copy-button;
    background: Theme.dark ? rgba(0, 0, 0, 0.4) : Theme.card-bg-soft;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    min-height: row.preferred-height;
    copied := CopyFlag { }
    row := HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;
        Rectangle {
            horizontal-stretch: 1;
            min-height: link.preferred-height;
            link := Text {
                width: parent.width;
                text: root.label + " ↗";
                color: Theme.accent;
                font-size: Theme.text-sm;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { AppState.open-url(root.url); }
            }
        }
        if root.copy-button: VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.ghost;
                size: BtnSize.sm;
                text: copied.copied ? T.tr("vault.msLinkCopied") : T.tr("vault.msCopyLink");
                clicked => {
                    AppState.copy-text(root.url);
                    copied.copied = true;
                }
            }
        }
    }
}

component CodeBanner inherits Rectangle {
    background: @linear-gradient(135deg, Theme.accent.with-alpha(0.15) 0%, rgba(6, 182, 212, 0.1) 100%);
    border-width: 1px;
    border-color: Theme.accent;
    border-radius: Theme.radius-md;
    min-height: row.preferred-height;
