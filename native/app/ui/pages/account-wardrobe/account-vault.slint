            text: AccountBridge.ms-user-code;
            font-family: Theme.font-pixel;
            font-size: Theme.text-xl;
            letter-spacing: 3.3px;
            color: Theme.dark ? #ffffff : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.primary;
                size: BtnSize.sm;
                emoji: "📋";
                text: copied.copied ? T.tr("vault.msCodeCopied") : T.tr("vault.msCopyCode");
