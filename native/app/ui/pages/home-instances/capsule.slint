// OWNER: home-instances agent. Port of components/TelemetryCapsule.svelte —
// the docked "flight deck": account picker, instance link + AOT status chip,
// boot-phase readout, Dry-Run and the JUGAR / DETENER button.
//
//     TelemetryCapsule { instance-name: HomeBridge.selected-instance; }
//
// Poster look: a flat block with a hard 4px ink shadow, the launch button as
// the site's gold pill (pixel label), Dry-Run as a 2px gold outline, and flat
// status chips. No glass, glow or gradients.
//
// Data lives in HomeBridge (capsule-*, aot-chip-*, launching / stopping);
// the capsule announces its instance with HomeBridge.capsule-target().

import { Theme, T, AppState, Router, Util, Icon, Icons, MonogramTile, MonogramShape, Badge, BadgeVariant, Spinner } from "../../widgets.slint";
import { HomeBridge } from "api.slint";

component PlayButton inherits Rectangle {
    in property <bool> running;
    in property <bool> busy;
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked();
    property <bool> hovered: touch.has-hover && enabled && !busy;
    property <length> depth: 4px;
    property <length> lift: hovered && !touch.pressed ? -2px : touch.pressed ? 2px : 0px;
    animate lift { duration: Theme.dur-fast; easing: ease-out; }
    min-width: max(148px, row.preferred-width);
    height: 44px + self.depth;
    opacity: enabled ? 1 : 0.45;
    background: transparent;

    // hard shadow under the pill (purple for launch, ink for stop)
    Rectangle {
        y: root.depth;
        width: 100%;
        height: 44px;
        border-radius: Theme.radius-pill;
        background: root.running ? Theme.brand-ink : Theme.brand-purple;
    }

    face := Rectangle {
        y: root.lift;
        width: 100%;
        height: 44px;
        border-radius: Theme.radius-pill;
        background: root.running ? (root.hovered ? #c81e1e : Theme.accent-red) : (root.hovered ? Theme.gold-hover : Theme.gold);
        clip: true;
        animate background { duration: Theme.dur-fast; }
        row := HorizontalLayout {
            padding-left: Theme.space-6;
            padding-right: Theme.space-6;
            spacing: Theme.space-2;
            alignment: center;
            VerticalLayout {
                alignment: center;
                if root.busy: Spinner { size: 15px; tint: root.running ? #ffffff : Theme.on-gold; }
                if !root.busy: Icon {
                    data: root.running ? Icons.stop : Icons.play;
                    filled: true;
                    weight: 0;
                    size: 14px;
                    color: root.running ? #ffffff : Theme.on-gold;
                }
            }
            Text {
                text: root.label;
                color: root.running ? #ffffff : Theme.on-gold;
                font-family: Theme.font-pixel;
                font-size: Theme.pix(16px);
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: root.enabled && !root.busy ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component AccountItem inherits Rectangle {
    in property <string> name;
    in property <int> hue;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <bool> msa;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.accent.with-alpha(0.16) : t.has-hover ? Theme.surface-up : transparent;
    border-width: active ? 2px : 0px;
    border-color: active ? Theme.hover-border : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            MonogramTile { name: root.name; hue: root.hue; avatar: root.avatar; has-avatar: root.has-avatar; size: 24px; shape: MonogramShape.rounded; }
        }
        Text {
            text: root.name;
            color: root.active ? Theme.accent : Theme.text;
            font-size: Theme.text-sm;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.msa: VerticalLayout {
            alignment: center;
            Badge { text: "MSA"; variant: BadgeVariant.accent; }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TelemetryCapsule inherits Rectangle {
    in property <string> instance-name;
    property <bool> running: HomeBridge.capsule-instance == instance-name && HomeBridge.capsule-running;
    property <bool> launching: instance-name != "" && HomeBridge.launching == instance-name;
    property <bool> stopping: instance-name != "" && HomeBridge.stopping == instance-name;
    property <string> acc-name: AppState.has-active-account ? AppState.active-account.username : "";

    changed instance-name => { HomeBridge.capsule-target(self.instance-name); }
    init => { HomeBridge.capsule-target(self.instance-name); }

    // The capsule is a section of the page, not a floating dock: it spans the
    // content column (its left edge lines up with the instance title) and its
    // face leaves the 4px the hard shadow hangs off to the right.
    height: 64px + 4px;
    min-width: 0;

    // hard shadow block under the capsule
    Rectangle {
        x: 4px;
        y: 4px;
        width: root.width - 4px;
        height: 64px;
        border-radius: Theme.radius-lg;
        background: root.running ? Theme.brand-purple : Theme.brand-ink;
    }

    capsule := Rectangle {
        x: 0;
        y: 0;
        width: root.width - 4px;
        height: 64px;
        border-radius: Theme.radius-lg;
        background: Theme.card-bg;
        border-width: 2px;
        border-color: root.running ? Theme.accent-green : Theme.border-solid;
        animate border-color { duration: Theme.dur-fast; }

        HorizontalLayout {
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-4;

            // ---- account picker ----
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                acc-btn := Rectangle {
                    height: 40px;
                    min-width: acc-row.preferred-width;
                    border-radius: Theme.radius-md;
                    background: acc-touch.has-hover ? Theme.surface-up : transparent;
                    border-width: acc-touch.has-hover ? 2px : 0px;
                    border-color: Theme.hover-border;
                    animate background { duration: Theme.dur-fast; }
                    acc-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: Theme.space-2;
                        VerticalLayout {
                            alignment: center;
                            MonogramTile {
                                name: root.acc-name != "" ? root.acc-name : "Steve";
                                hue: AppState.has-active-account ? AppState.active-account.monogram-hue : Util.name-hue("Steve", -1);
                                avatar: AppState.active-account.avatar;
                                has-avatar: AppState.has-active-account && AppState.active-account.has-avatar;
                                size: 32px;
                                shape: MonogramShape.rounded;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: root.acc-name != "" ? root.acc-name : T.tr("home.noActiveAccount");
                                color: Theme.text;
                                font-size: Theme.text-sm;
                                font-weight: 700;
                                min-width: 80px;
                                max-width: 160px;
                                overflow: elide;
                            }
                            Text {
                                text: AppState.has-active-account && AppState.active-account.token-kind == "msa" ? "Microsoft" : "Offline";
                                color: Theme.muted;
                                font-size: 11px;
                                font-weight: 500;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon { data: Icons.chevron-down; size: 14px; color: Theme.muted; weight: 2.5; }
                        }
                    }
                    acc-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { acc-popup.show(); }
                    }
                    acc-popup := PopupWindow {
                        x: 0;
                        y: -self.height - 12px;
                        width: 248px;
                        // 8px padding (x2) + 26px label + 41px link row + n * (36px item) + (n + 1) * 4px gaps
                        height: 87px + AppState.accounts.length * 40px;
                        close-policy: close-on-click-outside;
                        pop := Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.surface-solid;
                            border-width: 2px;
                            border-color: Theme.border-solid;
                            drop-shadow-color: Theme.brand-ink;
                            drop-shadow-blur: 0px;
                            drop-shadow-offset-x: Theme.shadow-lg-x;
                            drop-shadow-offset-y: Theme.shadow-lg-y;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Rectangle {
                                    height: 26px;
                                    Text {
                                        x: 8px;
                                        y: 6px;
                                        text: T.tr("home.capsuleSelectAccount").to-uppercase();
                                        color: Theme.muted;
                                        font-size: Theme.text-xs;
                                        font-weight: 700;
                                        letter-spacing: 0.6px;
                                    }
                                }
                                for acc in AppState.accounts: AccountItem {
                                    name: acc.username;
                                    hue: acc.monogram-hue;
                                    avatar: acc.avatar;
                                    has-avatar: acc.has-avatar;
                                    msa: acc.token-kind == "msa";
                                    active: acc.username == root.acc-name;
                                    clicked => {
                                        HomeBridge.select-account(acc.username);
                                        acc-popup.close();
                                    }
                                }
                                Rectangle {
                                    height: 41px;
                                    Rectangle { y: 0; height: 2px; background: Theme.border-solid; }
                                    link := Rectangle {
                                        y: 7px;
                                        height: 32px;
                                        border-radius: Theme.radius-sm;
                                        background: link-t.has-hover ? Theme.accent.with-alpha(0.14) : transparent;
                                        Text {
                                            x: 8px;
                                            text: "+ Administrar Cuentas";
                                            color: Theme.accent;
                                            font-size: Theme.text-xs;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        link-t := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                acc-popup.close();
                                                Router.navigate("#/account");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // divider
            VerticalLayout {
                alignment: center;
                Rectangle { width: 2px; height: 40px; background: Theme.border-solid; }
            }

            // ---- instance + phase ----
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: start;
                    if root.instance-name != "": Rectangle {
                        min-width: inst-row.preferred-width;
                        max-width: 220px;
                        horizontal-stretch: 0;
                        inst-row := HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: root.instance-name;
                                color: inst-t.has-hover ? Theme.accent : Theme.text;
                                font-size: Theme.text-base;
                                font-weight: 700;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Icon { data: Icons.more-vertical; size: 14px; color: Theme.muted; weight: 3.2; }
                            }
                        }
                        inst-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { HomeBridge.open-instance(root.instance-name); }
                        }
                    }
                    if root.instance-name == "": Text {
                        text: T.tr("home.capsuleSelectInstance");
                        color: Theme.muted;
                        font-size: Theme.text-sm;
                        font-italic: true;
                        vertical-alignment: center;
                    }
                    if root.instance-name != "" && HomeBridge.aot-chip-kind != "" && HomeBridge.capsule-instance == root.instance-name: VerticalLayout {
                        alignment: center;
                        aot-chip := Rectangle {
                            property <string> kind: HomeBridge.aot-chip-kind;
                            property <color> fg: kind == "ok" ? Theme.accent-green : kind == "warn" ? Theme.accent-alt : Theme.muted;
                            height: chip.preferred-height + 8px;
                            min-width: chip.preferred-width + 6px;
                            border-radius: Theme.radius-xs;
                            border-width: 2px;
                            border-color: kind == "ok" ? Theme.accent-green : kind == "warn" ? Theme.accent-alt : Theme.border-solid;
                            background: kind == "ok" ? Theme.accent-green.with-alpha(0.14) : kind == "warn" ? Theme.accent-alt.with-alpha(0.14) : Theme.card-bg-soft;
                            opacity: kind == "off" ? 0.85 : 1;
                            chip := HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 4px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Icon { data: Icons.zap; filled: true; weight: 0; size: 10px; color: aot-chip.fg; }
                                }
                                Text {
                                    text: T.tr(HomeBridge.aot-chip-key);
                                    color: aot-chip.fg;
                                    font-family: Theme.label-family(8px);
                                    font-size: Theme.label-size(8px);
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    if root.running: HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            // flat sticker dot (no glow)
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                background: Theme.accent-green;
                                border-width: 2px;
                                border-color: Theme.brand-ink;
                            }
                        }
                        Text { text: T.tr("home.capsuleStatusRunning"); color: Theme.accent-green; font-size: Theme.text-xs; font-weight: 700; }
                    }
                    if root.running && HomeBridge.capsule-tail != "": Text {
                        text: HomeBridge.capsule-tail;
                        color: Theme.muted;
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if !root.running && root.launching: Text { text: T.tr("home.capsuleStatusStarting"); color: Theme.accent-alt; font-size: Theme.text-xs; font-weight: 700; }
                    if !root.running && !root.launching: Text { text: T.tr("home.capsuleStatusIdle"); color: Theme.muted; font-size: Theme.text-xs; }
                }
                if HomeBridge.capsule-timing != "" && HomeBridge.capsule-instance == root.instance-name: Text {
                    text: HomeBridge.capsule-timing;
                    color: Theme.muted;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                }
            }

            // ---- actions ----
            HorizontalLayout {
                spacing: Theme.space-2;
                horizontal-stretch: 0;
                VerticalLayout {
                    alignment: center;
                    dry := Rectangle {
                        property <bool> enabled: root.instance-name != "";
                        height: 40px;
                        min-width: dry-t.preferred-width + 2 * Theme.space-4;
                        border-radius: Theme.radius-pill;
                        background: dry-touch.has-hover && self.enabled ? Theme.gold : transparent;
                        border-width: 2px;
                        border-color: self.enabled ? (dry-touch.has-hover ? Theme.gold : (Theme.dark ? Theme.gold : Theme.title-color)) : Theme.border-solid;
                        opacity: self.enabled ? 1 : 0.4;
                        animate background { duration: Theme.dur-fast; }
                        dry-t := Text {
                            text: T.tr("home.capsuleDryRun");
                            color: dry-touch.has-hover && dry.enabled ? Theme.on-gold : (Theme.dark ? Theme.gold : Theme.title-color);
                            font-size: Theme.text-sm;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        dry-touch := TouchArea {
                            enabled: dry.enabled;
                            mouse-cursor: pointer;
                            clicked => { HomeBridge.dryrun(root.instance-name); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PlayButton {
                        running: root.running;
                        busy: root.running ? root.stopping : root.launching;
                        enabled: root.instance-name != "";
                        label: root.running ? T.tr("home.capsuleStop") : root.launching ? T.tr("home.capsuleLaunching") : T.tr("home.capsuleLaunch");
                        clicked => {
                            if root.running {
                                HomeBridge.stop(root.instance-name);
                            } else {
                                HomeBridge.launch(root.instance-name);
                            }
                        }
                    }
                }
            }
        }
    }
}
