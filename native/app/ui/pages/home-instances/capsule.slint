// OWNER: home-instances agent. The glass play bar (was TelemetryCapsule.svelte —
// the docked "flight deck"): instance picker (dropdown on Home), account
// picker, live status line, Dry-Run (advanced) and the JUGAR / DETENER button —
// the one solid accent of its page.
//
//     TelemetryCapsule { instance-name: HomeBridge.selected-instance; picker: true; }
//
// Home uses it centred at the bottom (picker: the name opens the instance
// list above the bar); the instance page uses the same bar with the picker
// off (the name links to the hub). Data lives in HomeBridge (capsule-*,
// aot-chip-*, launching / stopping); the capsule announces its instance with
// HomeBridge.capsule-target().

import { Theme, T, AppState, Shell, Router, Util, Icon, Icons, MonogramTile, MonogramShape, Spinner, InstanceRow } from "../../widgets.slint";
import { GlassSheen } from "../../widgets/card.slint";
import { HomeBridge } from "api.slint";

/// The one solid accent on the page: Jugar / Detener (+ spinner while busy).
component PlayButton inherits Rectangle {
    in property <bool> running;
    in property <bool> busy;
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked();
    property <bool> hovered: touch.has-hover && enabled && !busy;
    // Fixed width: the bar's spare room goes to the status line, not the button.
    width: max(196px, row.preferred-width);
    height: 52px;
    border-radius: Theme.radius-md;
    opacity: enabled ? 1 : 0.45;
    background: root.running ? (root.hovered ? #c81e1e : Theme.accent-red)
        : root.hovered ? Theme.btn-fill-hover : Theme.btn-fill;
    // The gold glow only under Jugar; Detener gets none (a blur-less gold copy
    // read as a brown edge under the red button).
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: root.running ? transparent : Theme.glow-play-color;
    clip: true;
    animate background { duration: Theme.dur-fast; }
    row := HorizontalLayout {
        padding-left: Theme.space-6;
        padding-right: Theme.space-6;
        spacing: Theme.space-2;
        alignment: center;
        VerticalLayout {
            alignment: center;
            if root.busy: Spinner { size: 16px; tint: root.running ? #ffffff : Theme.on-gold; }
            if !root.busy: Icon {
                data: root.running ? Icons.stop : Icons.play;
                filled: true;
                weight: 0;
                size: 15px;
                color: root.running ? #ffffff : Theme.on-gold;
            }
        }
        Text {
            text: root.label;
            color: root.running ? #ffffff : Theme.on-gold;
            font-size: Theme.text-base;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: root.enabled && !root.busy ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// One row of the account popover list.
component AccountItem inherits Rectangle {
    in property <string> name;
    in property <int> hue;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <bool> msa;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.accent.with-alpha(0.14) : t.has-hover ? Theme.surface-up : transparent;
    border-width: active ? Theme.hairline : 0px;
    border-color: Theme.edge-strong;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            MonogramTile { name: root.name; hue: root.hue; avatar: root.avatar; has-avatar: root.has-avatar; size: 24px; shape: MonogramShape.rounded; }
        }
        Text {
            text: root.name;
            color: root.active ? Theme.accent-bright : Theme.text;
            font-size: Theme.text-sm;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.msa: Text {
            text: "MSA";
            color: Theme.accent;
            font-size: Theme.text-xs;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One row of the instance dropdown (the picker's list above the bar).
component InstanceItem inherits Rectangle {
    in property <InstanceRow> inst;
    in property <bool> active;
    callback clicked();
    height: 44px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.accent.with-alpha(0.14) : t.has-hover ? Theme.surface-up : transparent;
    border-width: active ? Theme.hairline : 0px;
    border-color: Theme.edge-strong;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: Theme.radius-sm;
                background: Theme.card-bg-soft;
                clip: true;
                if inst.has-icon: Image { width: 100%; height: 100%; source: inst.icon; image-fit: cover; image-rendering: inst.icon.width <= 32 ? ImageRendering.pixelated : ImageRendering.smooth; }
                if !inst.has-icon: Text {
                    text: Util.initial(inst.name);
                    font-size: Theme.text-sm;
                    font-weight: 700;
                    color: Theme.hsla(Util.name-hue(inst.name, inst.hue), 0.55, 0.62, 1);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 0;
            Text {
                text: inst.name;
                color: active ? Theme.accent-bright : Theme.text;
                font-size: Theme.text-sm;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: (inst.loader == "" ? "vanilla" : inst.loader) + " · " + inst.version;
                color: Theme.muted;
                font-size: Theme.text-xs;
                font-weight: 500;
                overflow: elide;
            }
        }
        if inst.running: VerticalLayout {
            alignment: center;
            Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Theme.accent-green; }
        }
        if root.active: VerticalLayout {
            alignment: center;
            Icon { data: Icons.check; size: 14px; color: Theme.accent-bright; weight: 3; }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Plain footer link row of a dropdown ("Ver todas las instancias"…).
component LinkItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    callback clicked();
    height: 32px;
    border-radius: Theme.radius-sm;
    background: t.has-hover ? Theme.surface-up : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: Theme.space-2;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { data: root.icon; size: 14px; color: t.has-hover ? Theme.accent-bright : Theme.muted; }
        }
        Text {
            text: root.text;
            color: t.has-hover ? Theme.text : Theme.muted-strong;
            font-size: Theme.text-xs;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Renders exactly the instance row whose name matches `target` (a `for` +
/// `if` combination is not valid Slint, so the row match takes a component).
component InstFace inherits Rectangle {
    in property <InstanceRow> inst;
    in property <string> target;
    visible: root.inst.name == root.target;
    width: 100%;
    height: 100%;
    // Nearest-neighbour only for small pixel art; store.rs shrinks big icons to size.
    if root.inst.has-icon: Image { width: 100%; height: 100%; source: root.inst.icon; image-fit: cover; image-rendering: root.inst.icon.width <= 32 ? ImageRendering.pixelated : ImageRendering.smooth; }
    if !root.inst.has-icon: Text {
        text: Util.initial(root.inst.name);
        font-size: Theme.text-lg;
        font-weight: 700;
        color: Theme.hsla(Util.name-hue(root.inst.name, root.inst.hue), 0.55, 0.62, 1);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// The matching row's loader · version line (empty when no row matches).
component InstMeta inherits Text {
    in property <InstanceRow> inst;
    in property <string> target;
    visible: root.inst.name == root.target;
    text: (root.inst.loader == "" ? "Vanilla" : root.inst.loader == "fabric" ? "Fabric" : root.inst.loader == "neoforge" ? "NeoForge" : root.inst.loader == "forge" ? "Forge" : root.inst.loader == "quilt" ? "Quilt" : root.inst.loader) + " " + root.inst.version;
    color: Theme.muted;
    font-size: Theme.text-xs;
    font-weight: 500;
    horizontal-alignment: left;
}

/// The matching row's icon (rendered for every row, visible on match).
component InstRowSlot inherits Rectangle {
    in property <InstanceRow> inst;
    in property <string> target;
    visible: root.inst.name == root.target;
    InstFace { inst: root.inst; target: root.target; }
}

/// Thin vertical separator between the bar's zones.
component BarDivider inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;
    Rectangle { width: Theme.hairline; height: 36px; background: Theme.border-solid; }
}

export component TelemetryCapsule inherits Rectangle {
    in property <string> instance-name;
    /// Home's play bar: the instance name opens the picker dropdown above the
    /// bar. Off (instance page): the name links to the hub.
    in property <bool> picker: false;
    /// Bottom-centre floating bar vs. the instance page's full-width strip.
    in property <bool> floating: false;
    property <bool> running: HomeBridge.capsule-instance == instance-name && HomeBridge.capsule-running;
    property <bool> launching: instance-name != "" && HomeBridge.launching == instance-name;
    property <bool> stopping: instance-name != "" && HomeBridge.stopping == instance-name;
    property <string> acc-name: AppState.has-active-account ? AppState.active-account.username : "";
    /// The selected instance row is rendered through a `for` + `if` face
    /// element (models cannot be indexed or searched in Slint).
    property <bool> empty: AppState.instances-loaded && AppState.instances.length == 0;

    changed instance-name => { HomeBridge.capsule-target(self.instance-name); }
    init => { HomeBridge.capsule-target(self.instance-name); }

    height: 88px;
    min-width: 0;

    bar := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-lg;
        background: Theme.card-bg;
        border-width: Theme.hairline;
        border-color: root.running ? Theme.accent-green.with-alpha(0.5) : Theme.glass-border;
        drop-shadow-blur: root.floating ? Theme.shadow-lg-blur : 0px;
        drop-shadow-offset-y: root.floating ? Theme.shadow-lg-y : 0px;
        drop-shadow-color: root.floating ? Theme.shadow-lg-color : transparent;
        clip: true;
        animate border-color { duration: Theme.dur-fast; }
        GlassSheen {
            width: 100%;
            height: 100%;
            radius: root.border-radius;
        }

        if root.empty && root.picker: HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                create := Rectangle {
                    height: 52px;
                    min-width: crow.preferred-width;
                    border-radius: Theme.radius-md;
                    background: cta.has-hover ? Theme.btn-fill-hover : Theme.btn-fill;
                    crow := HorizontalLayout {
                        padding-left: Theme.space-6;
                        padding-right: Theme.space-6;
                        spacing: Theme.space-2;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Icon { data: Icons.plus; size: 16px; color: Theme.on-gold; weight: 2.5; }
                        }
                        Text {
                            text: T.tr("home.createFirstInstance");
                            color: Theme.on-gold;
                            font-size: Theme.text-base;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    cta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Shell.wizard-open = true; }
                    }
                }
            }
        }

        if !(root.empty && root.picker): HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: Theme.space-3;

            // ---- instance (dropdown on Home, link on the instance page) ----
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                inst-btn := Rectangle {
                    height: 60px;
                    min-width: inst-row.preferred-width;
                    border-radius: Theme.radius-md;
                    background: inst-touch.has-hover ? Theme.surface-up : transparent;
                    animate background { duration: Theme.dur-fast; }
                    inst-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: Theme.space-3;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 38px;
                                height: 38px;
                                border-radius: Theme.radius-md;
                                background: Theme.card-bg-soft;
                                clip: true;
                                for i in AppState.instances: InstRowSlot {
                                    inst: i;
                                    target: root.instance-name;
                                }
                                if root.instance-name == "": Icon { data: Icons.package; size: 18px; color: Theme.muted; }
                            }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 2px;
                            Text {
                                text: root.instance-name != "" ? root.instance-name : T.tr("home.capsuleSelectInstance");
                                color: root.instance-name != "" ? Theme.text : Theme.muted;
                                font-size: Theme.text-base;
                                font-weight: 700;
                                max-width: 190px;
                                overflow: elide;
                                font-italic: root.instance-name == "";
                                horizontal-alignment: left;
                            }
                            // every row's meta stacked in one slot (a non-layout
                            // container: hidden rows take no layout space)
                            Rectangle {
                                height: 16px;
                                for i in AppState.instances: InstMeta {
                                    inst: i;
                                    target: root.instance-name;
                                    x: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                data: root.picker ? Icons.chevron-down : Icons.more-vertical;
                                size: root.picker ? 14px : 15px;
                                color: Theme.muted;
                                weight: 2.5;
                            }
                        }
                    }
                    inst-touch := TouchArea {
                        mouse-cursor: pointer;
                        enabled: root.instance-name != "" || root.picker;
                        clicked => {
                            if root.picker {
                                inst-popup.show();
                            } else {
                                HomeBridge.open-instance(root.instance-name);
                            }
                        }
                    }
                    // The instance list, above the bar (opaque floating layer).
                    inst-popup := PopupWindow {
                        x: -8px;
                        y: -self.height - 12px;
                        width: 300px;
                        // padding 16 + header 28 + list (n*44, max 268) + rule 1
                        // + 2 links * 32 + 4 gaps * 2
                        height: 117px + min(268px, AppState.instances.length * 44px);
                        close-policy: close-on-click-outside;
                        pop := Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.surface-solid;
                            border-width: Theme.hairline;
                            border-color: Theme.glass-border;
                            drop-shadow-blur: Theme.shadow-lg-blur;
                            drop-shadow-offset-y: Theme.shadow-lg-y;
                            drop-shadow-color: Theme.shadow-lg-color;
                            clip: true;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                Rectangle {
                                    height: 28px;
                                    Text {
                                        x: 8px;
                                        text: T.tr("home.capsuleSelectInstance").to-uppercase();
                                        color: Theme.muted;
                                        font-size: Theme.text-xs;
                                        font-weight: 700;
                                        letter-spacing: 0.6px;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    property <length> list-h: AppState.instances.length * 44px;
                                    height: min(268px, self.list-h);
                                    Flickable {
                                        content-height: parent.list-h;
                                        for inst[i] in AppState.instances: InstanceItem {
                                            y: i * 44px;
                                            width: parent.width;
                                            inst: inst;
                                            active: inst.name == root.instance-name;
                                            clicked => {
                                                HomeBridge.select-instance(inst.name);
                                                inst-popup.close();
                                            }
                                        }
                                    }
                                }
                                Rectangle { height: Theme.hairline; background: Theme.border-solid; }
                                LinkItem {
                                    icon: Icons.grid;
                                    text: T.tr("home.allInstances");
                                    clicked => {
                                        inst-popup.close();
                                        Router.navigate("#/instances");
                                    }
                                }
                                LinkItem {
                                    icon: Icons.plus;
                                    text: T.tr("home.newInstance");
                                    clicked => {
                                        inst-popup.close();
                                        Shell.wizard-open = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            BarDivider { }

            // ---- account picker ----
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                acc-btn := Rectangle {
                    height: 60px;
                    min-width: acc-row.preferred-width;
                    border-radius: Theme.radius-md;
                    background: acc-touch.has-hover ? Theme.surface-up : transparent;
                    animate background { duration: Theme.dur-fast; }
                    acc-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: Theme.space-2;
                        VerticalLayout {
                            alignment: center;
                            MonogramTile {
                                name: root.acc-name != "" ? root.acc-name : "Steve";
                                hue: AppState.has-active-account ? AppState.active-account.monogram-hue : Util.name-hue("Steve", -1);
                                avatar: AppState.active-account.avatar;
                                has-avatar: AppState.has-active-account && AppState.active-account.has-avatar;
                                size: 34px;
                                shape: MonogramShape.circle;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: root.acc-name != "" ? root.acc-name : T.tr("home.noActiveAccount");
                                color: Theme.text;
                                font-size: Theme.text-sm;
                                font-weight: 700;
                                min-width: 70px;
                                max-width: 130px;
                                overflow: elide;
                            }
                            Text {
                                text: AppState.has-active-account && AppState.active-account.token-kind == "msa" ? "Microsoft" : "Offline";
                                color: Theme.muted;
                                font-size: Theme.text-xs;
                                font-weight: 500;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon { data: Icons.chevron-down; size: 14px; color: Theme.muted; weight: 2.5; }
                        }
                    }
                    acc-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { acc-popup.show(); }
                    }
                    acc-popup := PopupWindow {
                        x: 0;
                        y: -self.height - 12px;
                        width: 248px;
                        // 8px padding (x2) + 28px label + 41px link row + n * (36px item) + gaps
                        height: 89px + AppState.accounts.length * 40px;
                        close-policy: close-on-click-outside;
                        accpop := Rectangle {
                            border-radius: Theme.radius-lg;
                            background: Theme.surface-solid;
                            border-width: Theme.hairline;
                            border-color: Theme.glass-border;
                            drop-shadow-blur: Theme.shadow-lg-blur;
                            drop-shadow-offset-y: Theme.shadow-lg-y;
                            drop-shadow-color: Theme.shadow-lg-color;
                            clip: true;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Rectangle {
                                    height: 28px;
                                    Text {
                                        x: 8px;
                                        y: 6px;
                                        text: T.tr("home.capsuleSelectAccount").to-uppercase();
                                        color: Theme.muted;
                                        font-size: Theme.text-xs;
                                        font-weight: 700;
                                        letter-spacing: 0.6px;
                                    }
                                }
                                for acc in AppState.accounts: AccountItem {
                                    name: acc.username;
                                    hue: acc.monogram-hue;
                                    avatar: acc.avatar;
                                    has-avatar: acc.has-avatar;
                                    msa: acc.token-kind == "msa";
                                    active: acc.username == root.acc-name;
                                    clicked => {
                                        HomeBridge.select-account(acc.username);
                                        acc-popup.close();
                                    }
                                }
                                Rectangle {
                                    height: 41px;
                                    Rectangle { y: 0; height: Theme.hairline; background: Theme.border-solid; }
                                    LinkItem {
                                        y: 5px;
                                        width: parent.width;
                                        icon: Icons.users;
                                        text: "+ " + T.tr("account.manageAll");
                                        clicked => {
                                            acc-popup.close();
                                            Router.navigate("#/account");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            BarDivider { }

            // ---- status (running / starting / idle) — click opens the PiP log ----
            status := Rectangle {
                horizontal-stretch: 1;
                min-width: 0;
                border-radius: Theme.radius-md;
                background: status-touch.has-hover ? Theme.card-bg-soft : transparent;
                animate background { duration: Theme.dur-fast; }
                VerticalLayout {
                    x: 10px;
                    width: parent.width - 20px;
                    alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        if root.instance-name != "" && Shell.show-advanced && HomeBridge.aot-chip-kind != "" && HomeBridge.capsule-instance == root.instance-name: VerticalLayout {
                            alignment: center;
                            aot-chip := Rectangle {
                                property <string> kind: HomeBridge.aot-chip-kind;
                                property <color> fg: kind == "ok" ? Theme.accent-green : kind == "warn" ? Theme.accent-alt : Theme.muted;
                                height: chip.preferred-height + 10px;
                                min-width: chip.preferred-width + 6px;
                                border-radius: Theme.radius-xs;
                                border-width: Theme.hairline;
                                border-color: kind == "off" ? Theme.border-solid : self.fg.with-alpha(0.45);
                                background: self.fg.with-alpha(0.12);
                                chip := HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { data: Icons.zap; filled: true; weight: 0; size: 10px; color: aot-chip.fg; }
                                    }
                                    Text {
                                        text: T.tr(HomeBridge.aot-chip-key);
                                        color: aot-chip.fg;
                                        font-size: Theme.text-xs;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        if root.running || root.launching: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.running ? Theme.accent-green : root.launching ? Theme.accent-alt : Theme.muted;
                            }
                        }
                        if root.running || root.launching: Text {
                            text: root.running ? T.tr("home.capsuleStatusRunning")
                                : T.tr("home.capsuleStatusStarting");
                            color: root.running ? Theme.accent-green : Theme.accent-alt;
                            font-size: Theme.text-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if root.running && HomeBridge.capsule-tail != "": Text {
                            text: HomeBridge.capsule-tail;
                            color: Theme.muted;
                            font-family: Theme.font-mono;
                            font-size: 11px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                    if HomeBridge.capsule-timing != "" && HomeBridge.capsule-instance == root.instance-name: Text {
                        text: HomeBridge.capsule-timing;
                        color: Theme.muted;
                        font-family: Theme.font-mono;
                        font-size: 11px;
                    }
                }
                status-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Shell.pip-log-open = !Shell.pip-log-open; }
                }
            }

            // ---- actions ----
            if Shell.show-advanced: VerticalLayout {
                alignment: center;
                dry := Rectangle {
                    property <bool> enabled: root.instance-name != "";
                    height: 38px;
                    min-width: dry-t.preferred-width + 2 * Theme.space-4;
                    border-radius: Theme.radius-md;
                    background: dry-touch.has-hover && self.enabled ? Theme.card-bg-soft : transparent;
                    border-width: Theme.hairline;
                    border-color: self.enabled ? (dry-touch.has-hover ? Theme.edge-strong : Theme.border-solid) : Theme.border-solid;
                    opacity: self.enabled ? 1 : 0.4;
                    animate background, border-color { duration: Theme.dur-fast; }
                    dry-t := Text {
                        text: T.tr("home.capsuleDryRun");
                        color: dry-touch.has-hover && dry.enabled ? Theme.accent-bright : Theme.muted-strong;
                        font-size: Theme.text-xs;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    dry-touch := TouchArea {
                        enabled: dry.enabled;
                        mouse-cursor: pointer;
                        clicked => { HomeBridge.dryrun(root.instance-name); }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                PlayButton {
                    running: root.running;
                    busy: root.running ? root.stopping : root.launching;
                    enabled: root.instance-name != "";
                    label: root.running ? T.tr("home.capsuleStop") : root.launching ? T.tr("home.capsuleLaunching") : T.tr("home.capsuleLaunch");
                    clicked => {
                        if root.running {
                            HomeBridge.stop(root.instance-name);
                        } else {
                            HomeBridge.launch(root.instance-name);
                        }
                    }
                }
            }
        }
    }
}
