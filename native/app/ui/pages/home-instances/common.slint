// OWNER: home-instances agent. Small widgets shared by Home / InstanceHub /
// the PiP drawer that the foundation catalogue does not cover.

import { Theme, T, Icon, Icons, SelectOption, Spinner, TextField } from "../../widgets.slint";
import { HiLogLine } from "api.slint";
import { ListView } from "std-widgets.slint";

/// <select class="glass-select"> with a scrollable option list (version lists are long).
export component HiSelect inherits Rectangle {
    in property <[SelectOption]> options;
    in-out property <int> current-index: -1;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <length> list-height: 280px;
    callback selected(index: int, value: string);

    property <string> current-label: current-index >= 0 && current-index < options.length ? options[current-index].label : "";

    height: 37px;
    min-width: 100px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: Theme.dark ? rgba(8, 12, 24, 0.7) : Theme.surface-solid;
    border-width: 1px;
    border-color: touch.has-hover && enabled ? Theme.hover-border : Theme.dark ? rgba(255, 255, 255, 0.08) : Theme.border;
    opacity: enabled ? 1 : 0.5;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        Text {
            text: root.current-label != "" ? root.current-label : root.placeholder;
            color: root.current-label != "" ? Theme.text : Theme.muted;
            font-size: Theme.text-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon { data: Icons.chevron-down; size: 14px; color: Theme.text; weight: 2.5; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.list-height, root.options.length * 34px + 10px);
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.surface-solid;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: Theme.shadow-lg-color;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            clip: true;
            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: root.options.length * 34px;
                VerticalLayout {
                    for o[i] in root.options: Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-sm;
                        background: i == root.current-index ? Theme.accent.with-alpha(0.14) : ot.has-hover ? Theme.surface-up : transparent;
                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-3;
                            Text {
                                text: o.label;
                                color: i == root.current-index ? Theme.accent : Theme.text;
                                font-size: Theme.text-sm;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        ot := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current-index = i;
                                popup.close();
                                root.selected(i, o.value);
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Small native-checkbox look (accent-color) with a label.
export component HiCheck inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <length> box: 14px;
    callback toggled(checked: bool);
    width: box;
    height: box;
    border-radius: 3px;
    background: checked ? Theme.accent : Theme.dark ? rgba(255, 255, 255, 0.08) : #ffffff;
    border-width: 1px;
    border-color: checked ? Theme.accent : Theme.dark ? rgba(255, 255, 255, 0.35) : #767676;
    opacity: enabled ? 1 : 0.5;
    if root.checked: Icon { data: Icons.check; size: root.box - 2px; color: Theme.dark ? #0d1222 : #ffffff; weight: 3.5; }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// Monospace log view (virtualized) that sticks to the bottom while `autoscroll`.
export component HiLogView inherits Rectangle {
    in property <[HiLogLine]> lines;
    in property <int> serial;
    in property <bool> autoscroll: true;
    in property <bool> numbers: true;
    in property <length> font-size: 12px;
    in property <color> base-color: Theme.text;
    out property <bool> at-bottom: flick.content-y <= flick.visible-height - flick.content-height + 28px;
    property <bool> pending;
    changed serial => { if root.autoscroll { root.pending = true; } }
    changed autoscroll => { if root.autoscroll { root.pending = true; } }
    public function scroll-bottom() { flick.content-y = min(0px, flick.visible-height - flick.content-height); }
    init => { root.pending = true; }

    // one frame later the ListView knows the new viewport height
    Timer {
        running: root.pending;
        interval: 16ms;
        triggered => {
            root.scroll-bottom();
            root.pending = false;
        }
    }

    flick := ListView {
        width: 100%;
        height: 100%;
        for line in root.lines: HorizontalLayout {
            spacing: Theme.space-3;
            padding-right: 6px;
            if root.numbers: Text {
                width: 32px;
                text: line.num;
                font-family: Theme.font-mono;
                font-size: 11px;
                color: Theme.muted.with-alpha(0.4);
                horizontal-alignment: right;
            }
            Rectangle {
                horizontal-stretch: 1;
                background: line.kind == 2 ? rgba(239, 68, 68, 0.08) : line.kind == 1 ? Theme.accent-alt.with-alpha(0.05) : transparent;
                preferred-height: t.preferred-height;
                t := Text {
                    width: parent.width;
                    text: line.text;
                    font-family: Theme.font-mono;
                    font-size: root.font-size;
                    color: line.kind == 2 ? #f87171 : line.kind == 1 ? #fbbf24 : root.base-color;
                    wrap: char-wrap;
                }
            }
        }
    }
}

/// Status chip "⚡ AOT …" style tiny pill.
export component HiChip inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.muted-strong;
    in property <brush> bg: Theme.surface-up;
    in property <color> border: Theme.border;
    in property <length> font-size: 11px;
    height: lbl.preferred-height + 6px;
    min-width: lbl.preferred-width + 18px;
    preferred-width: lbl.preferred-width + 18px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: bg;
    border-width: 1px;
    border-color: border;
    lbl := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: 600;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Centered spinner + label (loading states).
export component HiLoading inherits VerticalLayout {
    in property <string> text;
    alignment: center;
    spacing: Theme.space-4;
    padding-top: 64px;
    padding-bottom: 64px;
    HorizontalLayout {
        alignment: center;
        Spinner { size: 36px; tint: Theme.accent; }
    }
    Text {
        text: root.text;
        color: Theme.muted;
        font-size: Theme.text-md;
        horizontal-alignment: center;
    }
}

/// The foundation TextField (kept as an alias for the existing call sites).
export component HiTextField inherits TextField { }

/// Multi-line text input (JVM args, notes).
