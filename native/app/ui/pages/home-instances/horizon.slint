// OWNER: home-instances agent. The instance tiles of #/instances (was
// HorizonRail.svelte + HorizonTile.svelte; Home no longer shows a rail).
//
// Glass look: each tile is a glass card — icon/monogram, name, loader badge,
// memory/mods chips — with the instance hue as a subtle tint wash and a
// colour strip along the top, never a solid colour block or giant pixel
// numerals. The selected tile takes the accent edge (style guide §2).
//
// Tiles read AppState.instances directly; selection is HomeBridge.selected-instance.

import { Theme, T, AppState, Shell, InstanceRow, Util, LoaderBadge, LoaderBadgeSize, Badge, BadgeVariant, Btn, BtnVariant, BtnSize, Icon, Icons, McTitle } from "../../widgets.slint";
import { GlassSheen } from "../../widgets/card.slint";
import { HomeBridge } from "api.slint";

export global TileArt {
    /// Loader accent (#06b6d4 fabric, #f97316 neoforge, #a855f7 quilt, #10b981 vanilla).
    public pure function accent(loader: string) -> color {
        return loader == "fabric" ? #06b6d4 : (loader == "neoforge" || loader == "forge") ? #f97316 : loader == "quilt" ? #a855f7 : #10b981;
    }
    /// Loader ambient hue (HorizonTile loaderMeta.hue).
    public pure function loader-hue(loader: string) -> int {
        return loader == "fabric" ? 190 : (loader == "neoforge" || loader == "forge") ? 24 : loader == "quilt" ? 280 : 160;
    }
    /// The instance hue resolved (instance hue, else the loader's).
    public pure function hue-of(hue: int, loader: string) -> int {
        return hue >= 0 ? hue : TileArt.loader-hue(loader);
    }
}

/// Tiny chip under the name (memory / mods).
component TileChip inherits Rectangle {
    in property <string> text;
    height: l.preferred-height + 6px;
    min-width: l.preferred-width + 12px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-xs;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: Theme.border-solid;
    l := Text {
        text: root.text;
        color: Theme.muted-strong;
        font-size: Theme.text-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component HorizonTile inherits Rectangle {
    in property <InstanceRow> inst;
    in property <bool> selected;
    callback select();
    callback open();

    property <string> loader: inst.loader.to-lowercase();
    property <int> tile-hue: TileArt.hue-of(inst.hue, loader);
    property <bool> hovered: touch.has-hover;
    property <bool> running: inst.running;
    property <bool> hot: selected || hovered;

    width: 280px;
    height: 190px;
    border-radius: Theme.radius-tile;
    background: Theme.card-bg;
    border-width: Theme.hairline;
    border-color: root.selected ? Theme.edge-strong : root.hovered ? Theme.hover-border : Theme.glass-border;
    clip: true;
    animate background, border-color { duration: Theme.dur-fast; }
    // selected: faint accent wash; hovered: slightly brighter glass
    if root.selected: Rectangle {
        background: Theme.accent.with-alpha(0.08);
    }
    if root.hovered && !root.selected: Rectangle {
        background: Theme.surface-up;
    }

    GlassSheen {
        width: 100%;
        height: 100%;
        radius: root.border-radius;
    }

    // instance hue: a faint wash over the glass + a colour strip along the top
    Rectangle {
        background: @linear-gradient(180deg, Theme.hsla(root.tile-hue, 0.5, 0.5, 0.16) 0%, transparent 55%);
    }
    Rectangle {
        y: 0;
        height: 3px;
        background: @linear-gradient(90deg, transparent 0%, Theme.hsla(root.tile-hue, 0.6, 0.55, root.hot ? 0.9 : 0.6) 18%, Theme.hsla(root.tile-hue, 0.6, 0.55, root.hot ? 0.9 : 0.6) 82%, transparent 100%);
    }

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-2;
        alignment: start;
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: Theme.radius-md;
                    background: Theme.hsla(root.tile-hue, 0.35, 0.35, 0.35);
                    border-width: Theme.hairline;
                    border-color: Theme.border-solid;
                    clip: true;
                    if root.inst.has-icon: Image { width: 100%; height: 100%; source: root.inst.icon; image-fit: cover; image-rendering: root.inst.icon.width <= 32 ? ImageRendering.pixelated : ImageRendering.smooth; }
                    if !root.inst.has-icon: Text {
                        text: Util.initial(root.inst.name);
                        font-size: Theme.text-xl;
                        font-weight: 700;
                        color: Theme.hsla(root.tile-hue, 0.6, Theme.dark ? 0.72 : 0.4, 1);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                min-width: 0;
                Text {
                    text: root.inst.name;
                    color: Theme.text;
                    font-size: Theme.text-base;
                    font-weight: 700;
                    overflow: elide;
                }
                HorizontalLayout {
                    alignment: start;
                    LoaderBadge { loader: root.inst.loader; version: root.inst.version; size: LoaderBadgeSize.sm; }
                }
            }
            if root.running: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: Theme.accent-green;
                }
            }
        }
        Rectangle { height: 2px; }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            TileChip { text: Util.format-memory(root.inst.memory-mb > 0 ? root.inst.memory-mb : 3072); }
            if root.inst.mod-count > 0: TileChip {
                text: T.tr2("home.tileModsActive", "enabled", root.inst.enabled-mod-count, "total", root.inst.mod-count);
            }
            if Shell.show-advanced && root.inst.aot-cache-exists: TileChip { text: "⚡ AOT"; }
        }
        Rectangle { horizontal-stretch: 1; vertical-stretch: 1; }
        Text {
            text: root.selected ? T.tr("home.tileSelected") : T.tr("home.tileDoubleClickHint");
            color: root.selected ? Theme.accent-bright : Theme.muted;
            font-size: Theme.text-xs;
            font-weight: 500;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
        double-clicked => { root.open(); }
    }
}


/// "+ Crear Nueva Instancia" end tile (glass well, accent on hover).
export component AddTile inherits Rectangle {
    callback clicked();
    property <bool> hovered: t.has-hover;
    width: 280px;
    height: 190px;
    border-radius: Theme.radius-tile;
    background: root.hovered ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: root.hovered ? Theme.hover-border : Theme.border-solid;
    animate border-color, background { duration: Theme.dur-fast; }
    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: Theme.radius-pill;
                background: root.hovered ? Theme.accent.with-alpha(0.16) : Theme.card-bg;
                border-width: Theme.hairline;
                border-color: root.hovered ? Theme.edge-strong : Theme.border-solid;
                Icon {
                    data: Icons.plus;
                    size: 20px;
                    weight: 2.2;
                    color: root.hovered ? Theme.accent-bright : Theme.muted;
                }
            }
        }
        Text {
            text: T.tr("home.tileCreateNew");
            color: Theme.text;
            font-size: Theme.text-base;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: T.tr("home.tileCreateNewHint");
            color: Theme.muted;
            font-size: Theme.text-xs;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SkeletonTile inherits Rectangle {
    width: 280px;
    height: 190px;
    border-radius: Theme.radius-tile;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: Theme.border-solid;
}

component EmptyRail inherits Rectangle {
    callback create();
    border-radius: Theme.radius-lg;
    background: Theme.card-bg;
    border-width: Theme.hairline;
    border-color: Theme.glass-border;
    clip: true;
    GlassSheen { width: 100%; height: 100%; radius: root.border-radius; }
    min-height: 280px;
    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        VerticalLayout {
            alignment: center;
            padding-top: Theme.space-8;
            padding-bottom: Theme.space-8;
            spacing: Theme.space-3;
            HorizontalLayout {
                alignment: center;
                padding-bottom: Theme.space-1;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: Theme.radius-pill;
                    background: Theme.card-bg-soft;
                    border-width: Theme.hairline;
                    border-color: Theme.border-solid;
                    Icon { data: Icons.package; size: 24px; color: Theme.muted; }
                }
            }
            McTitle {
                text: T.tr("home.noInstancesTitle");
                font-size: 28px;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                padding-bottom: Theme.space-4;
                Text {
                    max-width: 480px;
                    text: T.tr("home.noInstancesSubtitle");
                    color: Theme.muted;
                    font-size: Theme.text-md;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                alignment: center;
                Btn {
                    variant: BtnVariant.primary;
                    size: BtnSize.lg;
                    text: "+ " + T.tr("home.createFirstInstance");
                    clicked => { root.create(); }
                }
            }
        }
    }
}

/// The instances wrap: tiles in rows of ~280px (was a horizontal rail; the
/// page is now dedicated to instances so a grid reads better than a rail).
export component HorizonRail inherits Rectangle {
    callback open-wizard();
    property <int> count: AppState.instances.length;
    property <bool> loading: !AppState.instances-loaded && count == 0;
    property <int> cols: max(1, floor((root.width + Theme.space-4) / (280px + Theme.space-4)));
    property <length> cw: (root.width - (root.cols - 1) * Theme.space-4) / root.cols;
    property <int> rows: ceil((root.count + 1) / root.cols);
    property <length> tile-h: 190px;

    height: root.loading ? root.tile-h
        : root.count == 0 ? 344px
        : root.rows * root.tile-h + max(0, root.rows - 1) * Theme.space-4;

    if root.loading: grid-load := Rectangle {
        for c in [0, 1, 2, 3]: SkeletonTile {
            x: mod(c, root.cols) * (root.cw + Theme.space-4);
            width: root.cw;
        }
    }

    if !root.loading && root.count == 0: HorizontalLayout {
        EmptyRail { create => { root.open-wizard(); } }
    }

    if !root.loading && root.count > 0: Rectangle {
        for inst[i] in AppState.instances: HorizonTile {
            x: mod(i, root.cols) * (root.cw + Theme.space-4);
            y: floor(i / root.cols) * (root.tile-h + Theme.space-4);
            width: root.cw;
            height: root.tile-h;
            inst: inst;
            selected: inst.name == HomeBridge.selected-instance;
            select => { HomeBridge.select-instance(inst.name); }
            open => { HomeBridge.open-instance(inst.name); }
        }
        AddTile {
            x: mod(root.count, root.cols) * (root.cw + Theme.space-4);
            y: floor(root.count / root.cols) * (root.tile-h + Theme.space-4);
            width: root.cw;
            height: root.tile-h;
            clicked => { root.open-wizard(); }
        }
    }
}
