// OWNER: home-instances agent. Port of components/HorizonRail.svelte +
// HorizonTile.svelte (compact density: 280 x 260 tiles, always on).
//
// Tiles read AppState.instances directly; selection is HomeBridge.selected-instance.
// The CSS 3D parallax on hover is not reproduced (it needs per-frame pointer
// tracking); hover keeps the accent border + glow.

import { Theme, T, AppState, InstanceRow, Util, LoaderBadge, LoaderBadgeSize, Badge, BadgeVariant, Btn, BtnVariant, BtnSize, Emoji } from "../../widgets.slint";
import { HomeBridge } from "api.slint";

export global TileArt {
    /// Loader accent (#06b6d4 fabric, #f97316 neoforge, #a855f7 quilt, #10b981 vanilla).
    public pure function accent(loader: string) -> color {
        return loader == "fabric" ? #06b6d4 : (loader == "neoforge" || loader == "forge") ? #f97316 : loader == "quilt" ? #a855f7 : #10b981;
    }
    /// Loader ambient hue (HorizonTile loaderMeta.hue).
    public pure function loader-hue(loader: string) -> int {
        return loader == "fabric" ? 190 : (loader == "neoforge" || loader == "forge") ? 24 : loader == "quilt" ? 280 : 160;
    }
    public pure function banner(loader: string, hue: int) -> brush {
        return hue >= 0
            ? @linear-gradient(135deg, Theme.hsla(hue, 0.45, 0.08, 0.85) 0%, Theme.hsla(hue, 0.6, 0.2, 0.85) 45%, Theme.hsla(hue, 0.7, 0.3, 0.85) 80%, Theme.hsla(hue + 30, 0.8, 0.45, 0.85) 100%)
            : loader == "fabric" ? @linear-gradient(135deg, #042f2ed9 0%, #0891b2d9 45%, #06b6d4d9 80%, #38bdf8d9 100%)
            : (loader == "neoforge" || loader == "forge") ? @linear-gradient(135deg, #431407d9 0%, #ea580cd9 45%, #f97316d9 80%, #fb923cd9 100%)
            : loader == "quilt" ? @linear-gradient(135deg, #3b0764d9 0%, #9333ead9 45%, #a855f7d9 80%, #c084fcd9 100%)
            : @linear-gradient(135deg, #022c22d9 0%, #059669d9 45%, #10b981d9 80%, #34d399d9 100%);
    }
    public pure function mesh(loader: string, hue: int) -> color {
        return hue >= 0 ? Theme.hsla(hue, 0.8, 0.55, 0.54) : TileArt.accent(loader).with-alpha(0.54);
    }
}

component TileChip inherits Rectangle {
    in property <string> text;
    height: l.preferred-height + 4px;
    min-width: l.preferred-width + 12px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-xs;
    background: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    l := Text {
        text: root.text;
        color: #ffffff;
        font-size: Theme.text-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component HorizonTile inherits Rectangle {
    in property <InstanceRow> inst;
    in property <bool> selected;
    callback select();
    callback open();

    property <string> loader: inst.loader.to-lowercase();
    property <color> tile-accent: TileArt.accent(loader);
    property <bool> hovered: touch.has-hover;
    property <bool> running: inst.running;

    width: 280px;
    height: 260px;

    // selected: translateY(-6px) scale(1.02)
    property <length> grow: selected ? 2.8px : 0px;
    animate grow { duration: Theme.dur-med; easing: ease-out; }
    property <length> shift: selected ? -6px : 0px;
    animate shift { duration: Theme.dur-med; easing: ease-out; }

    card := Rectangle {
        background: Theme.card-bg;
        x: -root.grow;
        y: root.shift - root.grow * 260 / 280;
        width: root.width + 2 * root.grow;
        height: root.height + 2 * root.grow * 260 / 280;
        border-radius: Theme.radius-tile;
        drop-shadow-color: root.selected ? root.tile-accent.with-alpha(0.45) : root.hovered ? root.tile-accent.with-alpha(0.3) : Theme.shadow-md-color;
        drop-shadow-blur: root.selected ? 36px : root.hovered ? 28px : Theme.shadow-md-blur;
        drop-shadow-offset-y: root.selected || root.hovered ? 4px : Theme.shadow-md-y;

        inner := Rectangle {
            border-radius: Theme.radius-tile;
            background: Theme.card-bg;
            clip: true;

            // ---- banner art ----
            Rectangle { background: TileArt.banner(root.loader, root.inst.hue); }
            // radial mesh "circle at 80% 20%" (Slint gradients are centered: offset a big square)
            Rectangle {
                width: 600px;
                height: 600px;
                x: parent.width * 0.8 - 300px;
                y: parent.height * 0.2 - 300px;
                background: @radial-gradient(circle, TileArt.mesh(root.loader, root.inst.hue) 0%, TileArt.mesh(root.loader, root.inst.hue).transparentize(0.6) 22%, transparent 50%);
            }
            if root.inst.has-icon: Image {
                width: parent.width;
                height: parent.height;
                source: root.inst.icon;
                image-fit: cover;
                opacity: 0.9;
            }
            // decorative 24px grid
            for i in 13: Rectangle { x: i * 24px; y: 0; width: 1px; height: parent.height; background: rgba(255, 255, 255, 0.04); }
            for i in 12: Rectangle { x: 0; y: i * 24px; width: parent.width; height: 1px; background: rgba(255, 255, 255, 0.04); }
            // monogram watermark (Press Start 2P 80px, right -8px top 8px)
            Text {
                x: parent.width - self.width + 8px;
                y: 8px;
                text: Util.initial(root.inst.name);
                font-family: Theme.font-pixel;
                font-size: 80px;
                color: rgba(255, 255, 255, 0.16);
            }
            // big version typography (left 16px, bottom 64px)
            Text {
                x: 16px;
                y: parent.height - 64px - self.height;
                text: root.inst.version;
                font-size: 32px;
                font-weight: 700;
                letter-spacing: -1.28px;
                // under the blurred body overlay in CSS: barely visible
                color: rgba(255, 255, 255, 0.06);
            }
            // sheen
            Rectangle { background: @linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.02) 40%, transparent 100%); }

            // ---- header overlay ----
            HorizontalLayout {
                y: 0;
                height: self.preferred-height;
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-3;
                spacing: Theme.space-2;
                alignment: space-between;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    LoaderBadge { loader: root.inst.loader; version: root.inst.version; size: LoaderBadgeSize.sm; }
                    if root.inst.aot-cache-exists: Badge { text: "⚡ AOT"; variant: BadgeVariant.ok; }
                }
                if root.running: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        Rectangle { border-radius: 7px; background: rgba(34, 197, 94, 0.35); }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: #22c55e;
                            drop-shadow-color: #22c55e;
                            drop-shadow-blur: 8px;
                        }
                    }
                }
            }

            // ---- body overlay ----
            body := Rectangle {
                y: parent.height - self.height;
                height: body-l.preferred-height;
                background: @linear-gradient(180deg, transparent 0%, Theme.bg.with-alpha(0.82) 40%, Theme.bg.with-alpha(0.96) 100%);
                body-l := VerticalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    padding-top: Theme.space-4;
                    padding-bottom: Theme.space-3;
                    spacing: Theme.space-1;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        TileChip { text: Util.format-memory(root.inst.memory-mb > 0 ? root.inst.memory-mb : 3072); }
                        if root.inst.mod-count > 0: TileChip {
                            text: T.tr2("home.tileModsActive", "enabled", root.inst.enabled-mod-count, "total", root.inst.mod-count);
                        }
                    }
                    Text {
                        text: root.inst.name;
                        color: #ffffff;
                        font-size: Theme.text-lg;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: T.tr("home.tileDoubleClickHint");
                        color: root.hovered ? root.tile-accent : Theme.muted-strong;
                        font-size: 11.2px;
                        font-weight: 500;
                    }
                }
            }

            // selection bar
            Rectangle {
                y: parent.height - self.height;
                height: root.selected ? 4px : 3px;
                background: root.tile-accent;
                opacity: root.selected ? 1 : 0;
                animate opacity { duration: Theme.dur-fast; }
            }
        }
        // border on top of the art
        Rectangle {
            border-radius: Theme.radius-tile;
            border-width: 1px;
            border-color: root.running ? #22c55e : root.selected ? root.tile-accent : root.hovered ? root.tile-accent.with-alpha(0.7) : Theme.border;
            animate border-color { duration: Theme.dur-med; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
        double-clicked => { root.open(); }
    }
}


/// "+ Crear Nueva Instancia" end tile (dashed border).
export component AddTile inherits Rectangle {
    callback clicked();
    property <bool> hovered: t.has-hover;
    property <length> lift: hovered ? -4px : 0px;
    animate lift { duration: Theme.dur-med; easing: ease-out; }
    width: 280px;
    height: 260px;
    face := Rectangle {
        y: root.lift;
        border-radius: Theme.radius-tile;
        background: root.hovered ? Theme.accent.with-alpha(0.08) : Theme.surface;
        drop-shadow-color: root.hovered ? Theme.accent.with-alpha(0.2) : transparent;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 8px;
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("assets/dashed-tile.svg");
            image-fit: fill;
            colorize: root.hovered ? Theme.accent : Theme.border;
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-2;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: root.hovered ? Theme.accent : rgba(255, 255, 255, 0.05);
                    border-width: 1px;
                    border-color: root.hovered ? Theme.accent : Theme.border;
                    drop-shadow-color: root.hovered ? Theme.accent : transparent;
                    drop-shadow-blur: 16px;
                    Text {
                        text: "+";
                        font-size: 24px;
                        font-weight: 400;
                        color: root.hovered ? #ffffff : Theme.muted-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: T.tr("home.tileCreateNew");
                color: Theme.text;
                font-size: Theme.text-base;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: T.tr("home.tileCreateNewHint");
                color: Theme.muted-strong;
                font-size: Theme.text-xs;
                horizontal-alignment: center;
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SkeletonTile inherits Rectangle {
    width: 280px;
    height: 260px;
    border-radius: Theme.radius-tile;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
}

component EmptyRail inherits Rectangle {
    callback create();
    border-radius: Theme.radius-xl;
    background: Theme.card-bg;
    min-height: 280px;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/dashed-tile.svg");
        image-fit: fill;
        colorize: Theme.border;
    }
    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        VerticalLayout {
            alignment: center;
            padding-top: Theme.space-8;
            padding-bottom: Theme.space-8;
            spacing: Theme.space-2;
            HorizontalLayout {
                alignment: center;
                padding-bottom: Theme.space-1;
                Emoji { char: "🎮"; size: 48px; }
            }
            Text {
                text: T.tr("home.noInstancesTitle");
                color: Theme.text;
                font-size: Theme.text-2xl;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                padding-bottom: Theme.space-4;
                Text {
                    max-width: 480px;
                    text: T.tr("home.noInstancesSubtitle");
                    color: Theme.muted-strong;
                    font-size: Theme.text-md;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                alignment: center;
                Btn {
                    variant: BtnVariant.primary;
                    size: BtnSize.lg;
                    text: "+ " + T.tr("home.createFirstInstance");
                    clicked => { root.create(); }
                }
            }
        }
    }
}

export component HorizonRail inherits Rectangle {
    callback open-wizard();
    property <int> count: AppState.instances.length;
    property <bool> loading: !AppState.instances-loaded && count == 0;
    // rail padding 16px 40px inside a 16px-padded wrapper
    property <length> content-w: count * (280px + Theme.space-6) + 280px + 80px;
    property <bool> overflowing: content-w > root.width + 8px;

    height: count == 0 && !loading ? 280px + 32px + 32px : 260px + 64px;

    if root.loading: HorizontalLayout {
        padding-left: 40px;
        padding-top: 32px;
        padding-bottom: 32px;
        spacing: Theme.space-6;
        alignment: start;
        SkeletonTile { }
        SkeletonTile { }
        SkeletonTile { }
        SkeletonTile { }
    }

    if !root.loading && root.count == 0: HorizontalLayout {
        padding-left: Theme.space-6;
        padding-right: Theme.space-6;
        padding-top: Theme.space-8;
        padding-bottom: Theme.space-8;
        EmptyRail { create => { root.open-wizard(); } }
    }

    if !root.loading && root.count > 0: rail := Rectangle {
        clip: true;
        property <length> max-off: max(0px, root.content-w - self.width);
        property <length> off: 0px;
        animate off { duration: Theme.dur-fast; easing: ease-out; }
        // vertical wheel -> horizontal scroll (only when the rail overflows; tiles reject wheel events)
        TouchArea {
            scroll-event(e) => {
                if !root.overflowing { return reject; }
                let d = abs(e.delta-y / 1px) > abs(e.delta-x / 1px) ? e.delta-y : e.delta-x;
                rail.off = clamp(rail.off - d * 1.5, 0px, rail.max-off);
                return accept;
            }
        }
        HorizontalLayout {
            x: -rail.off;
            width: max(parent.width, root.content-w);
            padding-left: 40px;
            padding-right: 40px;
            padding-top: 32px;
            padding-bottom: 32px;
            spacing: Theme.space-6;
            alignment: start;
            for inst in AppState.instances: HorizonTile {
                inst: inst;
                selected: inst.name == HomeBridge.selected-instance;
                select => { HomeBridge.select-instance(inst.name); }
                open => { HomeBridge.open-instance(inst.name); }
            }
            AddTile { clicked => { root.open-wizard(); } }
        }
        // edge fades (mask-image) approximated with background-colored gradients
        if root.overflowing && rail.off > 10px: Rectangle {
            x: 0;
            width: 48px;
            background: @linear-gradient(90deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%);
        }
        if root.overflowing && rail.off < rail.max-off - 10px: Rectangle {
            x: parent.width - 48px;
            width: 48px;
            background: @linear-gradient(90deg, Theme.bg.transparentize(1) 0%, Theme.bg 100%);
        }
    }
}
