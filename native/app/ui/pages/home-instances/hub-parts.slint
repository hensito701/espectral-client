// OWNER: home-instances agent. Building blocks of the InstanceHub workbench.
// Glass look: HubCard is the GlassCard recipe (translucent fill, 1px hairline,
// top sheen), the one soft shadow is reserved for floating layers only.

import { Theme, T, Icon, Icons, McTitle } from "../../widgets.slint";
import { GlassSheen } from "../../widgets/card.slint";

component CardHead inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Theme.space-1;
    McTitle {
        text: root.title;
        font-size: 16px;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.muted;
        font-size: Theme.text-xs;
        wrap: word-wrap;
    }
}

component CardFoot inherits VerticalLayout {
    in property <string> text;
    padding-top: Theme.space-3;
    spacing: Theme.space-3;
    Rectangle { height: Theme.hairline; background: Theme.border-solid; }
    Text { text: root.text; color: Theme.muted; font-size: Theme.text-xs; wrap: word-wrap; }
}

/// Glass card (InstanceHub cards) with overridable border / fill.
export component HubCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> footer;
    in property <brush> fill: Theme.card-bg;
    in property <color> stroke: Theme.glass-border;
    in property <length> pad: Theme.space-5;
    in property <length> gap: Theme.space-3;

    min-width: content.min-width;
    min-height: content.min-height;
    preferred-width: content.preferred-width;
    preferred-height: content.preferred-height;

    border-radius: Theme.radius-lg;
    background: root.fill;
    border-width: Theme.hairline;
    border-color: root.stroke;
    clip: true;

    GlassSheen {
        width: 100%;
        height: 100%;
        radius: root.border-radius;
    }

    content := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        VerticalLayout {
            padding-top: root.pad;
            padding-bottom: root.pad;
            spacing: root.gap;
            if root.title != "" || root.subtitle != "": CardHead { title: root.title; subtitle: root.subtitle; }
            @children
            if root.footer != "": CardFoot { text: root.footer; }
        }
    }
}



/// Right-aligned action row (CSS .card-action-footer, margin-top 8px).
export component ActionFooter inherits HorizontalLayout {
    padding-top: Theme.space-2;
    spacing: Theme.space-2;
    alignment: end;
    @children
}

/// Memory preset pill: active = accent tint + accent edge.
export component PresetPill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: l.preferred-height + 11px;
    min-width: l.preferred-width + 21px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: active ? Theme.accent.with-alpha(0.14) : t.has-hover ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: active ? Theme.edge-strong : t.has-hover ? Theme.hover-border : Theme.border-solid;
    opacity: enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.dur-fast; }
    l := Text {
        text: root.text;
        color: root.active ? Theme.accent-bright : t.has-hover ? Theme.text : Theme.muted-strong;
        font-size: Theme.text-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Inset panel (jvm-spec-grid / aot-stats-grid background): soft glass well.
export component Inset inherits Rectangle {
    in property <length> pad: Theme.space-3;
    border-radius: Theme.radius-md;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: Theme.border-solid;
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        padding-top: root.pad;
        padding-bottom: root.pad;
        spacing: Theme.space-3;
        @children
    }
}

/// Uppercase micro label (spec-label / stat-label).
export component MicroLabel inherits Text {
    color: Theme.muted;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.56px;
}

/// Checkbox row with title + hint (toggle-checkbox-row).
export component CheckRow inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> title;
    in property <string> hint;
    callback toggled();
    opacity: enabled ? 1 : 0.65;
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    row := HorizontalLayout {
        spacing: Theme.space-3;
        VerticalLayout {
            padding-top: 2px;
            alignment: start;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                background: root.checked ? Theme.accent : Theme.card-bg-soft;
                border-width: Theme.hairline;
                border-color: root.checked ? Theme.edge-strong : Theme.border-solid;
                if root.checked: Icon { data: Icons.check; size: 14px; color: Theme.on-gold; weight: 3.5; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            Text { text: root.title; color: Theme.text; font-size: Theme.text-sm; font-weight: 600; wrap: word-wrap; }
            Text { text: root.hint; color: Theme.muted; font-size: Theme.text-xs; wrap: word-wrap; }
        }
        @children
    }
}

/// Feedback line (options-feedback / options-hint).
export component Note inherits Text {
    in property <bool> hint;
    color: hint ? Theme.muted : Theme.accent-green;
    font-size: hint ? 11.5px : Theme.text-xs;
    wrap: word-wrap;
}

/// Pill switch (client-feature toggle): accent track, round knob.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: on ? Theme.accent : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: on ? Theme.edge-strong : Theme.border-solid;
    opacity: enabled ? 1 : 0.5;
    animate background { duration: Theme.dur-fast; }
    Rectangle {
        x: root.on ? 22px : 4px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Theme.on-gold : Theme.muted;
        animate x { duration: Theme.dur-fast; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Small bordered "label button" (icon-upload-btn).
export component FileBtn inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: l.preferred-height + 13px;
    min-width: l.preferred-width + 26px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: t.has-hover ? Theme.surface-up : Theme.surface;
    border-width: Theme.hairline;
    border-color: t.has-hover ? Theme.accent.with-alpha(0.7) : Theme.edge-strong;
    opacity: enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.dur-fast; }
    l := Text {
        text: root.text;
        color: t.has-hover ? Theme.accent-bright : Theme.text;
        font-size: Theme.text-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
