// OWNER: home-instances agent. Port of pages/Home.svelte (+ HorizonRail,
// HorizonTile, TelemetryCapsule, InstanceWizardModal, MrpackModal, DryRunModal).
// Keep the exported component name and the empty interface used by app.slint.

import { Theme, T, AppState, Shell, Router, MonogramTile, MonogramShape, Util, Btn, BtnVariant, BtnSize, PageScaffold } from "../../widgets.slint";
import { ServerRadarCard } from "../settings-suite-servers/server-radar-card.slint";
import { HomeBridge } from "api.slint";
import { HorizonRail } from "horizon.slint";
import { TelemetryCapsule } from "capsule.slint";
import { InstanceWizardModal } from "wizard.slint";
import { DryRunModal } from "modals.slint";
// .mrpack import: the shared library-mods modal (drag & drop aware).
import { MrpackModal } from "../library-mods/mrpack-modal.slint";
import { LibraryBridge } from "../library-mods/api.slint";

component AccountChip inherits Rectangle {
    property <bool> hovered: t.has-hover;
    property <string> name: AppState.has-active-account ? AppState.active-account.username : "";
    property <length> lift: hovered ? -2px : 0px;
    animate lift { duration: Theme.dur-fast; }
    height: 44px;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: 22px;
    drop-shadow-color: hovered ? Theme.shadow-md-color : Theme.shadow-sm-color;
    drop-shadow-blur: hovered ? Theme.shadow-md-blur : Theme.shadow-sm-blur;
    drop-shadow-offset-y: Theme.shadow-sm-y;
    Rectangle {
        y: root.lift;
        border-radius: root.border-radius;
        background: root.hovered ? Theme.surface-up : Theme.surface;
        border-width: 1px;
        border-color: root.hovered ? Theme.accent : Theme.border;
        row := HorizontalLayout {
            padding-left: 6px;
            padding-right: 14px;
            spacing: Theme.space-3;
            VerticalLayout {
                alignment: center;
                MonogramTile {
                    name: root.name != "" ? root.name : "Steve";
                    hue: AppState.has-active-account ? AppState.active-account.monogram-hue : Util.name-hue("Steve", -1);
                    avatar: AppState.active-account.avatar;
                    has-avatar: AppState.has-active-account && AppState.active-account.has-avatar;
                    size: 36px;
                    shape: MonogramShape.rounded;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: T.tr("home.activeAccount"); color: Theme.muted-strong; font-size: 11px; font-weight: 500; }
                Text { text: root.name != "" ? root.name : T.tr("home.noActiveAccount"); color: Theme.text; font-size: Theme.text-sm; font-weight: 700; }
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Router.navigate("#/account"); }
    }
}

component MotdTicker inherits HorizontalLayout {
    spacing: Theme.space-2;
    alignment: end;
    VerticalLayout {
        alignment: center;
        Rectangle {
            height: badge.preferred-height + 6px;
            width: badge.preferred-width + 12px;
            border-radius: Theme.radius-xs;
            background: rgba(239, 68, 68, 0.15);
            border-width: 1px;
            border-color: rgba(239, 68, 68, 0.35);
            badge := HorizontalLayout {
                x: 6px;
                y: 3px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: #ef4444;
                        drop-shadow-color: #ef4444;
                        drop-shadow-blur: 6px;
                    }
                }
                Text {
                    text: T.tr("home.motdLive");
                    font-family: Theme.font-pixel;
                    font-size: 10px;
                    color: #ef4444;
                    vertical-alignment: center;
                }
            }
        }
    }
    Text {
        text: HomeBridge.motd-server + ":";
        color: Theme.text;
        font-size: Theme.text-xs;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: HomeBridge.motd-text != "" ? HomeBridge.motd-text : T.tr("home.motdDefault");
        color: Theme.muted-strong;
        font-size: Theme.text-xs;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        min-width: 40px;
    }
}

component ServersSection inherits Rectangle {
    border-radius: Theme.radius-xl;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-color: Theme.shadow-sm-color;
    drop-shadow-blur: Theme.shadow-sm-blur;
    drop-shadow-offset-y: Theme.shadow-sm-y;
    HorizontalLayout {
        padding-left: Theme.space-6;
        padding-right: Theme.space-6;
        VerticalLayout {
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-6;
            spacing: Theme.space-4;
            HorizontalLayout {
                spacing: Theme.space-3;
                Text {
                    text: T.tr("home.serversTitle");
                    color: Theme.text;
                    font-size: Theme.text-lg;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: T.tr("home.serversSubtitle");
                    color: Theme.muted-strong;
                    font-size: Theme.text-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                more := Text {
                    text: T.tr("home.viewAllServers") + " →";
                    color: more-t.has-hover ? Theme.accent-alt : Theme.accent;
                    font-size: Theme.text-sm;
                    font-weight: 600;
                    vertical-alignment: center;
                    more-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Router.navigate("#/servers"); }
                    }
                }
            }
            if HomeBridge.top-servers.length > 0: HorizontalLayout {
                spacing: Theme.space-4;
                for s in HomeBridge.top-servers: ServerRadarCard {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    server: s;
                    compact: true;
                    interactive: true;
                    clicked => { Router.navigate("#/servers"); }
                }
            }
            if HomeBridge.top-servers.length == 0: Rectangle {
                height: 68px;
                Text {
                    text: T.tr("home.noServers");
                    color: Theme.muted-strong;
                    font-size: Theme.text-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    property <string> player: AppState.has-active-account ? AppState.active-account.username : "Jugador";

    PageScaffold {
        width: root.width;
        height: root.height;
        content-padding: Theme.space-6;
        content-padding-top: Theme.space-4;
        content-padding-bottom: Theme.space-12;
        spacing: Theme.space-6;

        // ---- hero header ----
        HorizontalLayout {
            padding-top: Theme.space-2;
            spacing: Theme.space-6;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                Text {
                    text: HomeBridge.greeting == 0 ? T.tr1("home.greetingMorning", "name", root.player)
                        : HomeBridge.greeting == 1 ? T.tr1("home.greetingAfternoon", "name", root.player)
                        : T.tr1("home.greetingEvening", "name", root.player);
                    font-size: Theme.text-hero(root.width);
                    font-weight: 700;
                    letter-spacing: Theme.text-hero(root.width) * -0.03;
                    color: @linear-gradient(135deg, Theme.text 30%, Theme.muted-strong 100%);
                    overflow: elide;
                }
                Text {
                    text: T.tr("home.motdDefault");
                    color: Theme.text;
                    font-size: Theme.text-sm;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                AccountChip { }
            }
        }

        // ---- quick action toolbar ----
        Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: Theme.shadow-sm-color;
            drop-shadow-blur: Theme.shadow-sm-blur;
            drop-shadow-offset-y: Theme.shadow-sm-y;
            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-3;
                spacing: Theme.space-4;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    horizontal-stretch: 0;
                    Btn {
                        variant: BtnVariant.primary;
                        emoji: "✨";
                        text: "+ " + T.tr("home.newInstance");
                        clicked => { Shell.wizard-open = true; }
                    }
                    Btn {
                        variant: BtnVariant.secondary;
                        emoji: "📦";
                        text: T.tr("home.importModpack");
                        clicked => { LibraryBridge.mrpack-open = true; }
                    }
                    Btn {
                        variant: BtnVariant.ghost;
                        emoji: "🧩";
                        text: T.tr("home.clientSuite");
                        clicked => { Router.navigate("#/client"); }
                    }
                }
                MotdTicker {
                    horizontal-stretch: 1;
                    max-width: 620px;
                }
            }
        }

        // ---- instance rail ----
        VerticalLayout {
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-2;
            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-2;
                alignment: start;
                Text {
                    text: T.tr("home.instancesRailTitle");
                    color: Theme.text;
                    font-size: Theme.text-xl;
                    font-weight: 700;
                }
                Text {
                    text: "(" + AppState.instances.length + ")";
                    color: Theme.muted-strong;
                    font-size: Theme.text-sm;
                    font-weight: 600;
                    vertical-alignment: bottom;
                }
            }
            HorizonRail {
                open-wizard => { Shell.wizard-open = true; }
            }
        }

        // ---- launch capsule ----
        TelemetryCapsule {
            instance-name: HomeBridge.selected-instance;
        }

        // ---- server radar strip ----
        ServersSection { }
    }

    InstanceWizardModal { }
    MrpackModal { }
    DryRunModal { }
}
