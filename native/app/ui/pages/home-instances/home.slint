// OWNER: home-instances agent. The 1.9 Home: almost empty, built around Jugar.
// One centred column: logo + soft accent glow, the greeting with the
// player's head, the live-server MOTD line and the floating glass play bar
// (TelemetryCapsule with picker: the instance dropdown opens above it). The
// bar sits in the column, not at the window's bottom edge, so it stays
// clickable when the window's bottom is behind the taskbar.
// The instance rail lives on #/instances; the wizard / mrpack / dry-run
// modals are mounted by app.slint so every page can open them.

import { Theme, T, AppState, Router, Page, Shell, MonogramTile, MonogramShape, Icon, Icons } from "../../widgets.slint";
import { Backdrop } from "../../state.slint";
import { HomeBridge } from "api.slint";
import { NewsBridge } from "../news/api.slint";
import { TelemetryCapsule } from "capsule.slint";

/// Text that stays readable over a background picture: a soft dark halo
/// (four 1px offsets) plus a 2px drop shadow under the glyphs. In glass
/// mode it is plain text. Light theme: the halo is light instead.
component ShadowText inherits Rectangle {
    in property <string> text;
    in property <brush> text-color;
    in property <length> font-size;
    in property <int> font-weight: 600;
    /// Elide past this width (the MOTD).
    in property <length> max-text-width: 100000px;
    property <bool> shadow: Backdrop.mode == "image" && Backdrop.has-image;
    property <color> ink: Theme.dark ? rgba(0, 0, 0, 0.55) : rgba(255, 255, 255, 0.65);
    width: min(label.preferred-width, root.max-text-width);
    height: label.preferred-height;
    if root.shadow: Text { x: 0px; y: 2px; width: root.width; text: root.text; font-size: root.font-size; font-weight: root.font-weight; overflow: elide; color: Theme.dark ? rgba(0, 0, 0, 0.75) : rgba(255, 255, 255, 0.8); }
    if root.shadow: Text { x: -1px; y: 0px; width: root.width; text: root.text; font-size: root.font-size; font-weight: root.font-weight; overflow: elide; color: root.ink; }
    if root.shadow: Text { x: 1px; y: 0px; width: root.width; text: root.text; font-size: root.font-size; font-weight: root.font-weight; overflow: elide; color: root.ink; }
    if root.shadow: Text { x: 0px; y: -1px; width: root.width; text: root.text; font-size: root.font-size; font-weight: root.font-weight; overflow: elide; color: root.ink; }
    if root.shadow: Text { x: 0px; y: 1px; width: root.width; text: root.text; font-size: root.font-size; font-weight: root.font-weight; overflow: elide; color: root.ink; }
    label := Text {
        x: 0px;
        y: 0px;
        width: root.width;
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        overflow: elide;
    }
}

/// The live-server line: status dot + host + MOTD.
component ServerLine inherits HorizontalLayout {
    spacing: Theme.space-2;
    alignment: center;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: HomeBridge.motd-text != "" ? Theme.accent-green : Theme.muted;
        }
    }
    VerticalLayout {
        alignment: center;
        ShadowText {
            text: HomeBridge.motd-server;
            text-color: Theme.text;
            font-size: 13px;
            font-weight: 700;
        }
    }
    VerticalLayout {
        alignment: center;
        ShadowText {
            text: HomeBridge.motd-text != "" ? "· " + HomeBridge.motd-text : "· " + T.tr("home.motdDefault");
            text-color: Theme.muted-strong;
            font-size: 13px;
            font-weight: 600;
            max-text-width: 480px;
        }
    }
}
/// Round glass button at a Home edge: previous / next launcher picture.
component BackdropArrow inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: ta.has-hover ? Theme.surface-up : Theme.surface;
    border-width: Theme.hairline;
    border-color: ta.has-hover ? Theme.edge-strong : Theme.glass-border;
    animate background, border-color { duration: Theme.dur-fast; }
    Icon {
        data: root.icon;
        size: 18px;
        color: ta.has-hover ? Theme.accent-bright : Theme.muted-strong;
        animate color { duration: Theme.dur-fast; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One dot of the picture indicator under the arrows; clickable.
component BackdropDot inherits Rectangle {
    in property <bool> current;
    in property <string> key;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: root.current ? (Theme.dark ? #f2f2f2 : Theme.accent)
        : ta.has-hover ? Theme.muted-strong.with-alpha(0.7)
        : Theme.muted.with-alpha(0.45);
    animate background { duration: Theme.dur-fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Backdrop.select(root.key); }
    }
}

export component HomePage inherits Rectangle {
    property <string> player: AppState.has-active-account ? AppState.active-account.username : "Jugador";

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        padding-left: Theme.space-6;
        padding-right: Theme.space-6;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 220px;
                height: 220px;
                // soft accent glow behind the logo (backdrop.slint's radial)
                Rectangle {
                    x: -50px;
                    y: -50px;
                    width: 320px;
                    height: 320px;
                    background: @radial-gradient(circle, Theme.accent.with-alpha(0.20) 0%, Theme.accent.with-alpha(0.08) 40%, transparent 70%);
                }
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 120px;
                    height: 120px;
                    source: AppState.logo-lg.width > 0 ? AppState.logo-lg : @image-url("../../assets/logo_circle.png");
                    image-fit: contain;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-2;
            if AppState.has-active-account: VerticalLayout {
                alignment: center;
                MonogramTile {
                    name: AppState.active-account.username;
                    hue: AppState.active-account.monogram-hue;
                    avatar: AppState.active-account.avatar;
                    has-avatar: AppState.active-account.has-avatar;
                    size: 26px;
                    shape: MonogramShape.rounded;
                }
            }
            VerticalLayout {
                alignment: center;
                ShadowText {
                    text: HomeBridge.greeting == 0 ? T.tr1("home.greetingMorning", "name", root.player)
                        : HomeBridge.greeting == 1 ? T.tr1("home.greetingAfternoon", "name", root.player)
                        : T.tr1("home.greetingEvening", "name", root.player);
                    text-color: Theme.title-color;
                    font-size: 21px;
                    font-weight: 700;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            ServerLine { }
        }
        // ---- "Nuevo: …" — newest unread post; opens the news drawer ----
        if NewsBridge.latest-unread-title != "": HorizontalLayout {
            alignment: center;
            news-pill := Rectangle {
                width: min(news-label.preferred-width + 2 * Theme.space-4, 520px);
                height: 30px;
                border-radius: Theme.radius-pill;
                // Near-opaque glass so the accent text reads over any picture.
                background: news-ta.has-hover ? Theme.accent.with-alpha(0.22) : Theme.surface-solid.with-alpha(0.82);
                border-width: Theme.hairline;
                border-color: Theme.edge-strong;
                animate background { duration: Theme.dur-fast; }
                news-label := Text {
                    width: min(self.preferred-width, parent.width - 2 * Theme.space-4);
                    x: (parent.width - self.width) / 2;
                    text: T.tr("news.newPrefix") + " " + NewsBridge.latest-unread-title + " →";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.accent-bright;
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                news-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        NewsBridge.open = true;
                        NewsBridge.opened();
                    }
                }
            }
        }
        Rectangle { height: Theme.space-6; }
        // ---- the floating play bar ----
        HorizontalLayout {
            alignment: center;
            bar := TelemetryCapsule {
                instance-name: HomeBridge.selected-instance;
                picker: true;
                floating: true;
                // Room for the status column (● Minecraft / mod-problem chip)
                // between the two pickers and Jugar.
                width: min(860px, root.width - 2 * Theme.space-6);
                height: 88px;
            }
        }
    }
    // ---- launcher-picture arrows (image mode only, >= 2 pictures) ----
    if Backdrop.mode == "image" && Backdrop.items.length >= 2: BackdropArrow {
        x: Theme.space-6;
        y: (root.height - self.height) / 2;
        icon: Icons.chevron-left;
        clicked => { Backdrop.prev(); }
    }
    if Backdrop.mode == "image" && Backdrop.items.length >= 2: BackdropArrow {
        x: root.width - self.width - Theme.space-6;
        y: (root.height - self.height) / 2;
        icon: Icons.chevron-right;
        clicked => { Backdrop.next(); }
    }
    // dots: one per picture, centred just above the bottom edge (the play
    // bar sits higher, inside the centred column, so they never collide)
    if Backdrop.mode == "image" && Backdrop.items.length >= 2: HorizontalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: root.height - self.preferred-height - Theme.space-4;
        spacing: 7px;
        for item in Backdrop.items: BackdropDot {
            key: item.key;
            current: item.key == Backdrop.current;
        }
    }

    // Tell the launch-log drawer where the bar is (window coordinates).
    property <length> bar-top: bar.absolute-position.y;
    changed bar-top => { Shell.home-bar-top = self.bar-top; }
    init => { Shell.home-bar-top = self.bar-top; }
}
