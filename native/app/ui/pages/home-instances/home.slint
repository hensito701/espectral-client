// OWNER: home-instances agent. Port of pages/Home.svelte (+ HorizonRail,
// HorizonTile, TelemetryCapsule, InstanceWizardModal, MrpackModal, DryRunModal).
// Keep the exported component name and the empty interface used by app.slint.
//
// Poster look: the hero is a dark photo panel in both themes (local dark
// tokens, flat purple wash, gold pixel greeting), sections are flat blocks
// with 2px borders and hard ink shadows, buttons are the site's gold pills.

import { Theme, T, AppState, Shell, Router, MonogramTile, MonogramShape, Util, PageScaffold, McTitle, Emoji } from "../../widgets.slint";
import { ServerRadarCard } from "../settings-suite-servers/server-radar-card.slint";
import { HomeBridge } from "api.slint";
import { HorizonRail } from "horizon.slint";
import { TelemetryCapsule } from "capsule.slint";
import { InstanceWizardModal } from "wizard.slint";
import { DryRunModal } from "modals.slint";
// .mrpack import: the shared library-mods modal (drag & drop aware).
import { MrpackModal } from "../library-mods/mrpack-modal.slint";
import { LibraryBridge } from "../library-mods/api.slint";

component AccountChip inherits Rectangle {
    // dark-panel scope: the hero keeps the dark palette in both themes
    in property <bool> hovered: t.has-hover;
    in property <string> name: AppState.has-active-account ? AppState.active-account.username : "";
    property <length> lift: hovered ? -2px : 0px;
    property <length> depth: 3px;
    animate lift { duration: Theme.dur-fast; }

    height: 44px + self.depth;
    min-width: row.preferred-width + self.depth;
    horizontal-stretch: 0;
    background: transparent;

    // hard shadow block
    Rectangle {
        x: root.depth;
        y: root.depth;
        width: parent.width - root.depth;
        height: 44px;
        border-radius: Theme.radius-md;
        background: root.hovered ? Theme.brand-purple : #07021a;
        animate background { duration: Theme.dur-fast; }
    }

    face := Rectangle {
        y: root.lift;
        width: parent.width - root.depth;
        height: 44px;
        border-radius: Theme.radius-md;
        background: root.hovered ? #2a1a66 : #1f1252;
        border-width: 2px;
        border-color: root.hovered ? Theme.hover-border : #3a2488;
        animate background, border-color { duration: Theme.dur-fast; }
        row := HorizontalLayout {
            padding-left: 6px;
            padding-right: 14px;
            spacing: Theme.space-3;
            VerticalLayout {
                alignment: center;
                MonogramTile {
                    name: root.name != "" ? root.name : "Steve";
                    hue: AppState.has-active-account ? AppState.active-account.monogram-hue : Util.name-hue("Steve", -1);
                    avatar: AppState.active-account.avatar;
                    has-avatar: AppState.has-active-account && AppState.active-account.has-avatar;
                    size: 36px;
                    shape: MonogramShape.rounded;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: T.tr("home.activeAccount"); color: #cbbcf2; font-size: 11px; font-weight: 500; }
                Text { text: root.name != "" ? root.name : T.tr("home.noActiveAccount"); color: #f6f1ff; font-size: Theme.text-sm; font-weight: 700; }
            }
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { Router.navigate("#/account"); }
    }
}

/// Hero CTA: the site's button on the dark panel (gold pill + purple block
/// shadow, or the 2px gold outline). It keeps the dark-panel colours in both
/// themes, which the shared Btn cannot do (its outline follows the accent).
component HeroBtn inherits Rectangle {
    in property <string> text;
    in property <string> emoji;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    property <bool> hovered: t.has-hover && enabled;
    property <length> depth: root.primary ? 4px : 0px;
    property <length> lift: !root.primary ? 0px : root.hovered ? -2px : 0px;
    animate lift { duration: Theme.dur-fast; easing: ease-out; }
    height: 40px + self.depth;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    opacity: enabled ? 1 : 0.5;
    background: transparent;

    if root.primary: Rectangle {
        y: root.depth;
        width: 100%;
        height: 40px;
        border-radius: Theme.radius-pill;
        background: Theme.brand-purple;
    }
    face := Rectangle {
        y: root.lift;
        width: 100%;
        height: 40px;
        border-radius: Theme.radius-pill;
        border-width: root.primary ? 0px : 2px;
        border-color: root.primary ? transparent : Theme.gold;
        background: root.primary ? (root.hovered ? Theme.gold-hover : Theme.gold)
            : root.hovered ? Theme.gold : transparent;
        animate background { duration: Theme.dur-fast; }
        row := HorizontalLayout {
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            spacing: Theme.space-2;
            alignment: center;
            if root.emoji != "": VerticalLayout {
                alignment: center;
                Emoji { char: root.emoji; size: 14px; }
            }
            Text {
                text: root.text;
                color: root.primary || root.hovered ? Theme.on-gold : Theme.gold;
                font-size: Theme.text-sm;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The live MOTD line: flat red "EN VIVO" sticker chip + server + text.
component MotdTicker inherits HorizontalLayout {
    spacing: Theme.space-3;
    alignment: center;
    // flat red sticker chip (no glow): white sticker dot, then the pixel label.
    // Wrapped in a VerticalLayout: a fixed-height child of a HorizontalLayout
    // sits at the top of the row, not on the text's centre line.
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        Rectangle {
            height: 24px;
            width: live-row.preferred-width;
            border-radius: Theme.radius-xs;
            background: #e5484d;
            border-width: 2px;
            border-color: #07021a;
            // the row hugs its content (dot + label) and is centred in the chip
            live-row := HorizontalLayout {
                x: 0;
                y: (parent.height - self.height) / 2;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        background: #ffffff;
                    }
                }
                live := Text {
                    text: T.tr("home.motdLive");
                    // G1: small chip label; the pixel font smudges below 16 physical px.
                    font-family: Theme.label-family(8px);
                    font-size: Theme.label-size(8px);
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
        }
    }
    Text {
        text: HomeBridge.motd-server + ":";
        color: #f6f1ff;
        font-size: Theme.text-xs;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: HomeBridge.motd-text != "" ? HomeBridge.motd-text : T.tr("home.motdDefault");
        color: #cbbcf2;
        font-size: Theme.text-xs;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        min-width: 40px;
    }
}

/// Home hero: photo + flat purple wash (dark panel in both themes), pixel
/// greeting, the site's CTA buttons and the MOTD strip along the bottom.
component HeroPanel inherits Rectangle {
    in property <length> vw: 1280px;
    in property <string> greeting;

    height: col.preferred-height;
    background: #120a33;
    border-radius: Theme.radius-lg;
    border-width: 2px;
    border-color: Theme.border-solid;
    clip: true;
    drop-shadow-color: Theme.brand-ink;
    drop-shadow-blur: 0px;
    drop-shadow-offset-x: Theme.shadow-md-x;
    drop-shadow-offset-y: Theme.shadow-md-y;

    col := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        // photo band (grows only if the greeting wraps on a narrow window)
        Rectangle {
            height: max(hero-row.preferred-height, 248px);
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: @image-url("../../assets/hero-community.jpg");
                image-fit: cover;
            }
            // flat purple wash (not a gradient): the site's dark hero panel
            Rectangle {
                background: #120a33;
                opacity: 0.76;
            }
            hero-row := HorizontalLayout {
                width: parent.width;
                y: (parent.height - self.height) / 2;
                alignment: center;
                padding-left: Theme.space-8;
                padding-right: Theme.space-8;
                padding-top: Theme.space-6;
                padding-bottom: Theme.space-6;
                spacing: Theme.space-6;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Theme.space-3;
                    McTitle {
                        text: root.greeting;
                        font-size: root.vw < 1200px ? 32px : 48px;
                        ink: #ffd700;
                    }
                    Text {
                        text: T.tr("home.motdDefault");
                        color: #cbbcf2;
                        font-size: Theme.text-base;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        padding-top: Theme.space-2;
                        spacing: Theme.space-3;
                        alignment: start;
                        HeroBtn {
                            primary: true;
                            text: "+ " + T.tr("home.newInstance");
                            clicked => { Shell.wizard-open = true; }
                        }
                        HeroBtn {
                            emoji: "📦";
                            text: T.tr("home.importModpack");
                            clicked => { LibraryBridge.mrpack-open = true; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    AccountChip { }
                }
            }
        }
        // 2px rule between the photo and the ticker strip
        Rectangle {
            height: 2px;
            background: #3a2488;
        }
        Rectangle {
            height: 44px;
            background: #0c0626;
            MotdTicker {
                x: Theme.space-8;
                width: parent.width - 2 * Theme.space-8;
                height: parent.height;
            }
        }
    }
}

component ServersSection inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.card-bg;
    border-width: 2px;
    border-color: Theme.border-solid;
    drop-shadow-color: Theme.brand-ink;
    drop-shadow-blur: 0px;
    drop-shadow-offset-x: Theme.shadow-md-x;
    drop-shadow-offset-y: Theme.shadow-md-y;
    HorizontalLayout {
        padding-left: Theme.space-6;
        padding-right: Theme.space-6;
        VerticalLayout {
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-6;
            spacing: Theme.space-4;
            HorizontalLayout {
                spacing: Theme.space-3;
                McTitle {
                    text: T.tr("home.serversTitle");
                    font-size: 24px;
                    horizontal-stretch: 0;
                }
                Text {
                    text: T.tr("home.serversSubtitle");
                    color: Theme.muted;
                    font-size: Theme.text-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
            if HomeBridge.top-servers.length > 0: HorizontalLayout {
                spacing: Theme.space-4;
                for s in HomeBridge.top-servers: ServerRadarCard {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    server: s;
                }
            }
            if HomeBridge.top-servers.length == 0: Rectangle {
                height: 68px;
                border-radius: Theme.radius-md;
                background: Theme.card-bg-soft;
                border-width: 2px;
                border-color: Theme.border-solid;
                Text {
                    text: T.tr("home.noServers");
                    color: Theme.muted;
                    font-size: Theme.text-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    property <string> player: AppState.has-active-account ? AppState.active-account.username : "Jugador";

    PageScaffold {
        width: root.width;
        height: root.height;
        content-padding: Theme.space-6;
        content-padding-top: Theme.space-4;
        content-padding-bottom: Theme.space-12;
        spacing: Theme.space-6;

        // ---- hero ----
        HeroPanel {
            vw: root.width;
            greeting: HomeBridge.greeting == 0 ? T.tr1("home.greetingMorning", "name", root.player)
                : HomeBridge.greeting == 1 ? T.tr1("home.greetingAfternoon", "name", root.player)
                : T.tr1("home.greetingEvening", "name", root.player);
        }

        // ---- instance rail ----
        VerticalLayout {
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-2;
            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-3;
                alignment: start;
                McTitle {
                    text: T.tr("home.instancesRailTitle");
                    font-size: 24px;
                    horizontal-stretch: 0;
                }
                Text {
                    text: "(" + AppState.instances.length + ")";
                    color: Theme.muted;
                    font-size: Theme.text-sm;
                    font-weight: 700;
                    vertical-alignment: bottom;
                }
            }
            HorizonRail {
                open-wizard => { Shell.wizard-open = true; }
            }
        }

        // ---- launch capsule ----
        TelemetryCapsule {
            instance-name: HomeBridge.selected-instance;
        }

        // ---- server radar strip ----
        ServersSection { }
    }

    InstanceWizardModal { }
    MrpackModal { }
    DryRunModal { }
}
