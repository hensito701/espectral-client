// OWNER: library-mods agent. Port of src/ui/src/components/MrpackModal.svelte.
//
// Self-contained: driven by LibraryBridge.mrpack-open + mp-* (Rust:
// library_mods/mrpack.rs). Any page can host it — put `MrpackModal { }` as the
// LAST child of the page root Rectangle and open it with
// `LibraryBridge.mrpack-open = true;` (Home's "Importar modpack" button).

import { Theme, T, Modal, ModalFooter, Btn, BtnVariant, Field, Slider, ProgressBar, ProgressTone, ProgressThickness, Spinner, Emoji, Util } from "../../widgets.slint";
import { LibraryBridge } from "api.slint";
import { VText, CenterText } from "parts.slint";

component ErrorBanner inherits Rectangle {
    height: row.preferred-height;
    border-radius: Theme.radius-md;
    background: rgba(239, 68, 68, 0.15);
    border-width: 1px;
    border-color: rgba(239, 68, 68, 0.4);
    row := HorizontalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            Emoji { char: "⚠️"; size: 16px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: T.tr1("home.mrpackError", "error", LibraryBridge.mp-error);
                color: Theme.dark ? #fca5a5 : Theme.accent-red;
                font-size: Theme.text-sm;
                wrap: word-wrap;
            }
        }
    }
}

component SuccessView inherits VerticalLayout {
    padding-top: Theme.space-6;
    padding-bottom: Theme.space-6;
    spacing: Theme.space-2;
    HorizontalLayout {
        alignment: center;
        Emoji { char: "✨"; size: 48px; }
    }
    CenterText {
        text: LibraryBridge.mp-already-exists ? T.tr("home.mrpackAlreadyExists") : T.tr("home.mrpackPhaseDone");
        color: #22c55e;
        font-size: Theme.text-xl;
        font-weight: 700;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        Text { text: "Instancia:"; color: Theme.muted-strong; font-size: Theme.text-base; }
        Text { text: LibraryBridge.mp-instance; color: Theme.muted-strong; font-size: Theme.text-base; font-weight: 700; }
    }
}

component ProgressView inherits VerticalLayout {
    padding-top: Theme.space-4;
    padding-bottom: Theme.space-4;
    spacing: Theme.space-4;
    HorizontalLayout {
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            Spinner { size: 18px; tint: Theme.accent-cyan; }
        }
        VText {
            horizontal-stretch: 1;
            text: LibraryBridge.mp-phase == 1 ? T.tr("home.mrpackPhasePost")
                : LibraryBridge.mp-phase == 2 ? T.tr2("home.mrpackPhaseFiles", "done", LibraryBridge.mp-done, "total", LibraryBridge.mp-total)
                : LibraryBridge.mp-phase == 3 ? T.tr("home.mrpackPhaseOverrides")
                : T.tr("home.mrpackImporting");
            font-size: Theme.text-sm;
            font-weight: 600;
        }
    }
    ProgressBar {
        value: LibraryBridge.mp-total > 0 ? LibraryBridge.mp-done : 0;
        max: LibraryBridge.mp-total > 0 ? LibraryBridge.mp-total : 100;
        indeterminate: LibraryBridge.mp-phase == 1 || LibraryBridge.mp-total == 0;
        thickness: ProgressThickness.lg;
        show-value: LibraryBridge.mp-total > 0;
    }
}

component FormView inherits VerticalLayout {
    spacing: Theme.space-4;
    Field {
        label: T.tr("home.mrpackFile");
        required: true;
        HorizontalLayout {
            spacing: Theme.space-2;
            Rectangle {
                horizontal-stretch: 1;
                height: 38px;
                border-radius: Theme.radius-md;
                background: Theme.card-bg-soft;
                border-width: 1px;
                border-color: path.has-focus ? Theme.border-focus : Theme.border;
                TouchArea {
                    mouse-cursor: MouseCursor.text;
                    clicked => { path.focus(); }
                }
                path := TextInput {
                    x: Theme.space-3;
                    width: parent.width - 2 * Theme.space-3;
                    height: self.preferred-height;
                    y: (parent.height - self.height) / 2;
                    text <=> LibraryBridge.mp-path;
                    font-size: Theme.text-sm;
                    color: Theme.text;
                    single-line: true;
                    selection-background-color: Theme.accent.with-alpha(0.3);
                    accepted => { LibraryBridge.mp-start(); }
                }
                if LibraryBridge.mp-path == "": Text {
                    x: Theme.space-3;
                    height: parent.height;
                    text: T.tr("home.mrpackFilePlaceholder");
                    color: Theme.muted;
                    font-size: Theme.text-sm;
                    vertical-alignment: center;
                }
            }
            Btn {
                variant: BtnVariant.secondary;
                emoji: "📁";
                loading: LibraryBridge.mp-browsing;
                text: T.tr("home.mrpackBrowse");
                clicked => { LibraryBridge.mp-browse(); }
            }
        }
    }
    Field {
        label: T.tr("home.mrpackMemory");
        HorizontalLayout {
            spacing: Theme.space-4;
            Slider {
                horizontal-stretch: 1;
                minimum: 2048;
                maximum: 16384;
                step: 512;
                value <=> LibraryBridge.mp-memory;
                changed(v) => { LibraryBridge.mp-memory-touched = true; }
            }
            Text {
                min-width: 90px;
                text: Util.format-memory(LibraryBridge.mp-memory);
                color: Theme.accent-cyan;
                font-size: Theme.text-base;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

export component MrpackModal inherits Modal {
    property <bool> working: LibraryBridge.mp-busy || (LibraryBridge.mp-phase >= 1 && LibraryBridge.mp-phase <= 3);
    open <=> LibraryBridge.mrpack-open;
    title: T.tr("home.mrpackTitle");
    subtitle: T.tr("home.mrpackSubtitle");
    dialog-width: 600px;
    dismissable: !working;
    show-close: true;
    close => { LibraryBridge.mp-close(); }
    changed open => {
        if self.open { LibraryBridge.mp-opened(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-6;
        padding-right: Theme.space-6;
        VerticalLayout {
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-6;
            spacing: Theme.space-4;
            if LibraryBridge.mp-error != "": ErrorBanner { }
            if LibraryBridge.mp-phase == 4: SuccessView { }
            if LibraryBridge.mp-phase != 4 && root.working: ProgressView { }
            if LibraryBridge.mp-phase != 4 && !root.working: FormView { }
        }
    }
    ModalFooter {
        alignment: space-between;
        HorizontalLayout {
            alignment: start;
            if LibraryBridge.mp-phase == 4: Btn {
                emoji: "🚀";
                text: T.tr("home.mrpackGoToInstance");
                clicked => { LibraryBridge.mp-goto(); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: end;
            if LibraryBridge.mp-phase == 4: Btn {
                variant: BtnVariant.secondary;
                text: T.tr("home.mrpackClose");
                clicked => { LibraryBridge.mp-close(); }
            }
            if LibraryBridge.mp-phase != 4: Btn {
                variant: BtnVariant.ghost;
                enabled: !root.working;
                text: T.tr("home.wizardCancelBtn");
                clicked => { LibraryBridge.mp-close(); }
            }
            if LibraryBridge.mp-phase != 4: Btn {
                emoji: "📥";
                loading: root.working;
                enabled: LibraryBridge.mp-path != "" && !root.working;
                text: T.tr("home.mrpackImportBtn");
                clicked => { LibraryBridge.mp-start(); }
            }
        }
    }
}
