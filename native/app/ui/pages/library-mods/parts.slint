}

/// Loading state: spinner and a line of text.
export component LoadingPanel inherits StatePanel {
    in property <string> text;
    HorizontalLayout {
        alignment: center;
        Spinner { size: 16px; tint: Theme.accent; }
    }
    SelectableText { text: root.text; horizontal-alignment: center; wrap: word-wrap; }
}

/// Error line in a red-edged panel; `retry` adds a reload button (installed mods).
export component ErrorBanner inherits GlassPanel {
    in property <string> text;
    in property <bool> retry;
    fill: Theme.card-bg-soft;
    stroke: Theme.accent-red.with-alpha(0.45);
    height: row.preferred-height;
    row := HorizontalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        alignment: center;
        if root.retry: VText { text: "!"; color: Theme.accent-red; font-weight: 700; }
        VerticalLayout {
            alignment: center;
            SelectableText {
                text: root.text;
                color: Theme.accent-red;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
        }
        if root.retry: VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.ghost;
                size: BtnSize.sm;
                text: T.tr("versions.retry");
                clicked => { LibraryBridge.m-reload(); }
            }
        }
    }
}

/// Empty state: emoji, title and hint; `show-cta` offers the performance preset.
export component EmptyPanel inherits StatePanel {
    in property <string> emoji;
    in property <string> title;
    in property <string> hint;
    in property <bool> show-cta;
    HorizontalLayout {
        alignment: center;
        Emoji { char: root.emoji; size: 32px; }
    }
    SelectableText {
        text: root.title;
        color: Theme.text;
        font-size: Theme.text-xl;
        font-weight: 700;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    SelectableText { text: root.hint; horizontal-alignment: center; wrap: word-wrap; }
    if root.show-cta: HorizontalLayout {
        alignment: center;
        Btn {
            text: T.tr("mods.installPerformance");
            clicked => { LibraryBridge.m-set-tab(3); }
        }
    }
}
