// OWNER: library-mods agent. Port of src/ui/src/pages/ModCatalog.svelte.
// Keep the exported component name and the empty interface used by app.slint.
//
// State lives on LibraryBridge (m-*); Rust (library_mods/mods.rs) filters the
// installed list, runs Modrinth searches (12 per page, offset paging, explore
// when the query is empty), tracks mod-progress events and loads the result
// icons from cdn.modrinth.com through the engine HTTP client (LRU cache).

import { Theme, T, AppState, Router, GlassCard, Elevation, Btn, IconBtn, BtnVariant, BtnSize, Badge, BadgeVariant, McTitle, Icon, Icons, Spinner, Emoji, ProgressBar, ProgressThickness, MonogramTile, MonogramShape, LoaderBadge, LoaderBadgeSize, Toggle, SelectableText, Modal, ModalFooter, ConfirmDialog, ScrollArea } from "../../widgets.slint";
import { LibraryBridge, ModRow, ModCompatNote, ModVersionOption, ModChangeSummary, PinnedPill } from "api.slint";
import { LibScroll, GlassPanel, GlowDot, VText, StatePanel, CenterText, ModIcons, LoadingPanel, ErrorBanner, EmptyPanel } from "parts.slint";
import { ResourcePacksPane, ShadersPane, CopyFromModal, RpDeleteDialog, ShDeleteDialog } from "packs.slint";
import { ModrinthPane } from "modrinth-pane.slint";
import { ModrinthProjectDetailModal } from "project-detail-modal.slint";

component ModSpinner inherits Spinner {
    size: 16px;
    tint: Theme.accent;
}

// ---------------------------------------------------------------- header

component CatalogHeader inherits HorizontalLayout {
    spacing: Theme.space-4;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 0px;
        McTitle {
            text: T.tr("mods.title");
            font-size: 32px;
        }
        Rectangle { height: Theme.space-1; }
        SelectableText {
            min-height: 22px;
            vertical-alignment: center;
            text: T.tr("mods.subhead");
            color: Theme.muted;
            font-size: Theme.text-sm;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: start;
        Btn {
            variant: BtnVariant.secondary;
            size: BtnSize.sm;
            icon: Icons.folder;
            text: T.tr("mods.openFolder");
            enabled: LibraryBridge.m-has-target;
            clicked => { LibraryBridge.m-open-folder(); }
        }
    }
}

// ---------------------------------------------------------------- instance strip

component InstanceChip inherits Rectangle {
    in property <string> name;
    in property <string> tag;
    in property <bool> selected;
    callback clicked();
    property <bool> hovered: touch.has-hover;
    height: row.preferred-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: selected ? Theme.accent.with-alpha(0.14) : hovered ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: selected ? Theme.edge-strong : hovered ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    row := HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-2;
        VText {
            text: root.name;
            font-size: 13px;
            font-weight: 600;
            color: root.selected ? Theme.accent-bright : Theme.text;
        }
        VText {
            text: root.tag;
            font-size: Theme.text-xs;
            color: Theme.muted;
            font-weight: 500;
        }
        if root.selected: VerticalLayout {
            alignment: center;
            GlowDot { tint: Theme.accent; size: 5px; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component InstanceStrip inherits GlassCard {
    padding-size: 0px;
    col := VerticalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        HorizontalLayout {
            spacing: Theme.space-2;
            SelectableText {
                text: T.tr("mods.instance").to-uppercase();
                font-size: Theme.text-xs;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Theme.muted;
            }
            Rectangle { horizontal-stretch: 1; }
            if LibraryBridge.m-has-target && LibraryBridge.m-sel-version != "": VerticalLayout {
                alignment: center;
                LoaderBadge {
                    loader: LibraryBridge.m-sel-loader;
                    version: LibraryBridge.m-sel-version;
                    size: LoaderBadgeSize.sm;
                }
            }
            if LibraryBridge.m-has-target && LibraryBridge.m-sel-version != "": VerticalLayout {
                alignment: center;
                Badge {
                    text: T.tr1("mods.count", "count", LibraryBridge.m-count);
                    pixel: false;
                }
            }
        }
        if AppState.instances.length == 0: HorizontalLayout {
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            SelectableText {
                text: T.tr("mods.noInstances");
                color: Theme.muted;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    size: BtnSize.sm;
                    text: T.tr("mods.createFirst");
                    clicked => { Router.navigate("#/instances"); }
                }
            }
        }
        if AppState.instances.length > 0: Flickable {
            height: chips.preferred-height;
            content-width: chips.preferred-width;
            interactive: false;
            chips := HorizontalLayout {
                y: 0;
                height: self.preferred-height;
                spacing: Theme.space-2;
                alignment: start;
                for inst in AppState.instances: InstanceChip {
                    name: inst.name;
                    tag: inst.loader + " · " + inst.version;
                    selected: inst.name == LibraryBridge.m-target;
                    clicked => { LibraryBridge.m-select-instance(inst.name); }
                }
            }
        }
    }
}

component ProgressDeck inherits GlassCard {
    padding-size: 0px;
    border-color: Theme.edge-strong;
    height: col.preferred-height;
    col := VerticalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: 6.4px;
        HorizontalLayout {
            spacing: Theme.space-2;
            VerticalLayout {
                alignment: center;
                ModSpinner { }
            }
            VText {
                horizontal-stretch: 1;
                text: LibraryBridge.m-progress-file != "" ? T.tr1("mods.downloadingFile", "file", LibraryBridge.m-progress-file) : T.tr("mods.downloading");
                font-size: 13px;
                overflow: elide;
            }
            SelectableText {
                text: LibraryBridge.m-progress-done + " / " + LibraryBridge.m-progress-total;
                font-family: Theme.label-family(8px);
                font-size: Theme.label-size(8px);
                font-weight: 700;
            }
        }
        ProgressBar {
            value: LibraryBridge.m-progress-done;
            max: max(LibraryBridge.m-progress-total, 1);
            thickness: ProgressThickness.sm;
        }
    }
}

// ---------------------------------------------------------------- tabs

component CatalogTab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> icon-filled;
    in property <bool> active;
    in property <string> badge;
    in property <bool> badge-warn;
    callback clicked();
    property <bool> hovered: touch.has-hover;
    property <color> fg: active ? Theme.accent-bright : hovered ? Theme.text : Theme.muted;
    height: row.preferred-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: active ? Theme.accent.with-alpha(0.14) : hovered ? Theme.surface-up : transparent;
    border-width: Theme.hairline;
    border-color: active ? Theme.edge-strong : transparent;
    animate background, border-color { duration: Theme.dur-fast; }
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Icon { data: root.icon; size: 15px; color: root.fg; filled: root.icon-filled; }
        }
        VText { text: root.text; font-size: Theme.text-sm; font-weight: 600; color: root.fg; }
        if root.badge != "": VerticalLayout {
            alignment: center;
            Badge {
                text: root.badge;
                variant: root.badge-warn ? BadgeVariant.warn : BadgeVariant.neutral;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The three catalog tabs as one glass segmented control.
component CatalogTabs inherits Rectangle {
    height: tabs.preferred-height;
    border-radius: Theme.radius-sm;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: Theme.border-solid;
    tabs := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        alignment: start;
        CatalogTab {
            text: T.tr("mods.installedTab");
            icon: ModIcons.box;
            active: LibraryBridge.m-tab == 0;
            badge: "" + LibraryBridge.m-count;
            clicked => { LibraryBridge.m-set-tab(0); }
        }
        CatalogTab {
            text: T.tr("packs.packsTab");
            icon: Icons.image;
            active: LibraryBridge.m-tab == 1;
            clicked => { LibraryBridge.m-set-tab(1); }
        }
        CatalogTab {
            text: T.tr("packs.shadersTab");
            icon: Icons.sun;
            active: LibraryBridge.m-tab == 2;
            clicked => { LibraryBridge.m-set-tab(2); }
        }
        CatalogTab {
            text: T.tr("mods.presetsTab");
            icon: ModIcons.star;
            active: LibraryBridge.m-tab == 3;
            badge: LibraryBridge.m-perf-missing > 0 ? "" + LibraryBridge.m-perf-missing : "";
            badge-warn: true;
            clicked => { LibraryBridge.m-set-tab(3); }
        }
        CatalogTab {
            text: T.tr("mods.modrinthTab");
            icon: ModIcons.modrinth-tab;
            icon-filled: true;
            active: LibraryBridge.m-tab == 4;
            clicked => { LibraryBridge.m-set-tab(4); }
        }
    }
}

// ---------------------------------------------------------------- installed tab

component SmallSearch inherits Rectangle {
    min-width: 240px;
    height: 30px;
    border-radius: Theme.radius-sm;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.hover-border : Theme.border-solid;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    Icon { x: 9.6px; data: Icons.search; size: 14px; color: Theme.muted; }
    input := TextInput {
        x: 32px;
        width: parent.width - 32px - 28.8px;
        height: self.preferred-height;
        y: (parent.height - self.height) / 2;
        text <=> LibraryBridge.m-filter-query;
        font-size: 13px;
        color: Theme.text;
        single-line: true;
        selection-background-color: Theme.accent.with-alpha(0.3);
        edited => { LibraryBridge.m-set-filter-query(self.text); }
    }
    if LibraryBridge.m-filter-query == "": Text {
        x: 32px;
        width: parent.width - 32px - 28.8px;
        height: parent.height;
        text: "Filtrar por nombre o archivo…";
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    if LibraryBridge.m-filter-query != "": Text {
        x: parent.width - 8px - self.width;
        height: parent.height;
        text: "×";
        color: Theme.muted;
        font-size: 17.6px;
        vertical-alignment: center;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                LibraryBridge.m-filter-query = "";
                LibraryBridge.m-set-filter-query("");
            }
        }
    }
}

component InventoryToolbar inherits Rectangle {
    height: row.preferred-height;
    row := HorizontalLayout {
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-4;
        HorizontalLayout {
            spacing: Theme.space-1;
            alignment: start;
            horizontal-stretch: 1;
            for f in [0, 1, 2]: chip-root := Rectangle {
                property <bool> on: LibraryBridge.m-filter == f;
                property <string> label: f == 0 ? T.tr("mods.filterAll") + " (" + LibraryBridge.m-count + ")"
                    : f == 1 ? T.tr("mods.filterEnabled") + " (" + LibraryBridge.m-enabled-count + ")"
                    : T.tr("mods.filterDisabled") + " (" + LibraryBridge.m-disabled-count + ")";
                property <color> dot: f == 0 ? transparent : f == 1 ? Theme.accent-green : Theme.muted;
                property <length> dot-size: f == 0 ? 0px : 6px;
                height: 28px;
                min-width: chip-text.preferred-width + 20px;
                border-radius: Theme.radius-sm;
                background: self.on ? Theme.accent.with-alpha(0.14) : chip-touch.has-hover ? Theme.surface-up : transparent;
                border-width: Theme.hairline;
                border-color: self.on ? Theme.edge-strong : transparent;
                animate background, border-color { duration: Theme.dur-fast; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        width: chip-root.dot-size;
                        height: chip-root.dot-size;
                        border-radius: 3px;
                        background: chip-root.dot;
                    }
                    chip-text := Text {
                        text: chip-root.label;
                        font-size: Theme.text-xs;
                        font-weight: chip-root.on ? 600 : 500;
                        color: chip-root.on ? Theme.accent-bright : chip-touch.has-hover ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                }
                chip-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { LibraryBridge.m-set-filter(f); }
                }
            }
            if LibraryBridge.m-problem-count > 0: prob-chip := Rectangle {
                property <bool> on: LibraryBridge.m-filter == 3;
                height: 28px;
                min-width: prob-row.preferred-width;
                border-radius: Theme.radius-sm;
                background: self.on ? Theme.accent-red.with-alpha(0.18) : prob-touch.has-hover ? Theme.accent-red.with-alpha(0.10) : Theme.accent-red.with-alpha(0.06);
                border-width: Theme.hairline;
                border-color: self.on ? Theme.accent-red : Theme.accent-red.with-alpha(0.4);
                animate background, border-color { duration: Theme.dur-fast; }
                prob-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.accent-red;
                    }
                    Text {
                        text: T.tr("mods.filterProblems") + " (" + LibraryBridge.m-problem-count + ")";
                        font-size: Theme.text-xs;
                        font-weight: 600;
                        color: Theme.accent-red;
                        vertical-alignment: center;
                    }
                }
                prob-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { LibraryBridge.m-set-filter(3); }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            SmallSearch { width: 240px; }
        }
    }
}

/// The installed-mod switch: the shared Toggle (widgets/controls.slint).
component ModSwitch inherits Toggle {
    in property <bool> on;
    callback flipped();
    checked: root.on;
    toggled(v) => { root.flipped(); }
}

component CompatNoteStrip inherits Rectangle {
    in property <ModCompatNote> note;
    property <bool> is-err: note.severity == "error";
    property <color> tone: is-err ? Theme.accent-red : Theme.accent-alt;
    height: inner.preferred-height;
    border-radius: Theme.radius-sm;
    background: tone.with-alpha(0.10);
    border-width: Theme.hairline;
    border-color: tone.with-alpha(0.38);
    inner := HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            Icon {
                data: root.is-err ? Icons.alert-circle : Icons.alert-triangle;
                size: 14px;
                color: root.tone;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            SelectableText {
                text: root.note.text;
                font-size: Theme.text-xs;
                font-weight: 500;
                color: root.is-err ? Theme.accent-red : Theme.accent-alt;
                wrap: word-wrap;
            }
        }
        if root.note.fix-label != "": VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.secondary;
                size: BtnSize.sm;
                text: root.note.fix-label;
                clicked => { LibraryBridge.m-apply-fix(root.note.fix-kind, root.note.fix-target, root.note.fix-arg); }
            }
        }
    }
}

component ModEntryRow inherits Rectangle {
    in property <ModRow> entry;
    /// Last row of the list: no trailing separator.
    in property <bool> last: false;
    height: content.preferred-height;
    opacity: entry.enabled || entry.has-error || entry.has-warn ? 1 : 0.62;
    background: entry.has-error ? Theme.accent-red.with-alpha(hover.has-hover ? 0.08 : 0.04)
        : entry.has-warn ? Theme.accent-alt.with-alpha(hover.has-hover ? 0.07 : 0.03)
        : hover.has-hover ? Theme.surface-up : transparent;
    animate background { duration: Theme.dur-fast; }
    // Left severity accent stripe when the row has compat issues
    if root.entry.has-error || root.entry.has-warn: Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: root.height;
        background: root.entry.has-error ? Theme.accent-red : Theme.accent-alt;
    }
    // hairline list separator
    Rectangle {
        y: root.height - Theme.hairline;
        height: Theme.hairline;
        background: Theme.border-solid;
        visible: !root.last;
    }
    hover := TouchArea { }
    content := VerticalLayout {
        padding-top: 7px;
        padding-bottom: 7px;
        padding-left: 11px;
        padding-right: 11px;
        spacing: 6px;
        HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout {
                alignment: center;
                MonogramTile { name: root.entry.name; size: 32px; shape: MonogramShape.rounded; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2.4px;
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    VText { text: root.entry.name; font-size: 13px; font-weight: 600; overflow: elide; }
                    if root.entry.version != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            border-radius: Theme.radius-pill;
                            background: Theme.card-bg-soft;
                            border-width: Theme.hairline;
                            border-color: Theme.border-solid;
                            min-width: ver.preferred-width + 16px;
                            height: ver.preferred-height + 6px;
                            ver := Text {
                                text: root.entry.version;
                                font-family: Theme.label-family(8px);
                                font-size: Theme.label-size(8px);
                                font-weight: 700;
                                color: Theme.muted;
                            }
                        }
                    }
                    if root.entry.slug != "": VText {
                        text: root.entry.slug;
                        font-family: Theme.font-mono;
                        font-size: Theme.text-xs;
                        color: Theme.muted;
                        font-weight: 500;
                    }
                }
                HorizontalLayout {
                    spacing: 5.6px;
                    alignment: start;
                    Text {
                        text: root.entry.filename;
                        font-family: Theme.font-mono;
                        font-size: Theme.text-xs;
                        color: Theme.muted;
                        opacity: 0.85;
                        overflow: elide;
                        font-weight: 500;
                    }
                    if root.entry.meta != "": SelectableText {
                        text: root.entry.meta;
                        font-size: Theme.text-xs;
                        color: Theme.muted;
                        font-weight: 500;
                    }
                }
                if root.entry.requires != "" || root.entry.required-by != "": HorizontalLayout {
                    padding-top: 3.2px;
                    spacing: 5.6px;
                    alignment: start;
                    if root.entry.requires != "": Badge { text: root.entry.requires; variant: BadgeVariant.warn; }
                    if root.entry.required-by != "": Badge { text: root.entry.required-by; variant: BadgeVariant.ok; }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 6px;
                alignment: end;
                if root.entry.can-switch-version: VerticalLayout {
                    alignment: center;
                    Btn {
                        variant: BtnVariant.ghost;
                        size: BtnSize.sm;
                        icon: Icons.refresh;
                        text: T.tr("mods.changeVersion");
                        clicked => { LibraryBridge.m-open-versions(root.entry.filename); }
                    }
                }
                if root.entry.can-delete: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: del-ta.has-hover ? Theme.accent-red.with-alpha(0.14) : transparent;
                        animate background { duration: Theme.dur-fast; }
                        Icon {
                            data: Icons.trash;
                            size: 14px;
                            color: del-ta.has-hover ? Theme.accent-red : Theme.muted;
                        }
                        del-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { LibraryBridge.m-ask-delete(root.entry.filename); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ModSwitch {
                        on: root.entry.enabled;
                        flipped => { LibraryBridge.m-toggle(root.entry.filename); }
                    }
                }
            }
        }
        if root.entry.issues.length > 0: VerticalLayout {
            padding-left: 44px;
            spacing: 4px;
            for n in root.entry.issues: CompatNoteStrip { note: n; }
        }
    }
}

component CompatSummaryBanner inherits GlassPanel {
    property <bool> has-err: LibraryBridge.m-compat-errors > 0;
    property <color> tone: has-err ? Theme.accent-red : Theme.accent-alt;
    fill: tone.with-alpha(0.09);
    stroke: tone.with-alpha(0.45);
    height: row.preferred-height;
    row := HorizontalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            Icon {
                data: root.has-err ? Icons.alert-circle : Icons.alert-triangle;
                size: 16px;
                color: root.tone;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            SelectableText {
                text: LibraryBridge.m-compat-errors == 1 ? T.tr("mods.compatBannerErrorOne")
                    : LibraryBridge.m-compat-errors > 1 ? T.tr1("mods.compatBannerErrors", "count", LibraryBridge.m-compat-errors)
                    : T.tr1("mods.compatBannerWarnings", "count", LibraryBridge.m-compat-warnings);
                color: root.tone;
                font-size: Theme.text-sm;
                font-weight: 600;
                wrap: word-wrap;
            }
        }
        if LibraryBridge.m-filter != 3: VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.ghost;
                size: BtnSize.sm;
                text: T.tr("mods.filterProblems") + " (" + LibraryBridge.m-problem-count + ")";
                clicked => { LibraryBridge.m-set-filter(3); }
            }
        }
    }
}

component InstalledPane inherits VerticalLayout {
    spacing: Theme.space-3;
    InventoryToolbar { }
    if LibraryBridge.m-compat-errors > 0 || LibraryBridge.m-compat-warnings > 0: CompatSummaryBanner { }
    if LibraryBridge.m-loading && LibraryBridge.m-count == 0: LoadingPanel { text: T.tr("mods.loading"); }
    if !(LibraryBridge.m-loading && LibraryBridge.m-count == 0) && LibraryBridge.m-error != "": ErrorBanner {
        text: LibraryBridge.m-error;
        retry: true;
    }
    if !(LibraryBridge.m-loading && LibraryBridge.m-count == 0) && LibraryBridge.m-error == "" && LibraryBridge.m-rows.length == 0: EmptyPanel {
        emoji: "📦";
        title: LibraryBridge.m-count == 0 ? T.tr("mods.noMods") : T.tr("mods.noResults");
        hint: LibraryBridge.m-count == 0 ? T.tr("mods.emptyHint") : T.tr("mods.noResultsHint");
        show-cta: LibraryBridge.m-count == 0;
    }
    if !(LibraryBridge.m-loading && LibraryBridge.m-count == 0) && LibraryBridge.m-error == "" && LibraryBridge.m-rows.length > 0: GlassCard {
        elevation: Elevation.md;
        padding-size: 0px;
        spacing: 0px;
        for row[i] in LibraryBridge.m-rows: ModEntryRow { entry: row; last: i == LibraryBridge.m-rows.length - 1; }
    }
}

// ---------------------------------------------------------------- presets tab

component Pill inherits Rectangle {
    in property <PinnedPill> pill;
    height: row.preferred-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: pill.installed ? Theme.accent-green.with-alpha(0.10) : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: pill.installed ? Theme.accent-green.with-alpha(0.5) : Theme.border-solid;
    row := HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            GlowDot { size: 5px; tint: root.pill.installed ? Theme.accent-green : Theme.muted; }
        }
        SelectableText {
            text: root.pill.slug;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            color: root.pill.installed ? Theme.text : Theme.muted;
            font-weight: 500;
        }
        if root.pill.requires != "": SelectableText {
            text: root.pill.requires;
            font-size: Theme.text-xs;
            color: Theme.muted;
            font-weight: 500;
        }
    }
}

component PresetsPane inherits VerticalLayout {
    spacing: Theme.space-4;
    if LibraryBridge.m-preset-note != "": GlassPanel {
        fill: Theme.accent-cyan.with-alpha(0.08);
        stroke: Theme.accent-cyan.with-alpha(0.4);
        height: note-row.preferred-height;
        note-row := HorizontalLayout {
            padding-top: Theme.space-3;
            padding-bottom: Theme.space-3;
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            spacing: Theme.space-2;
            Icon { data: Icons.info; size: 15px; color: Theme.accent-cyan; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                SelectableText { text: LibraryBridge.m-preset-note; color: Theme.text; font-size: Theme.text-md; wrap: word-wrap; }
            }
        }
    }
    GlassCard {
        featured: true;
        elevation: Elevation.md;
        spacing: 0px;
        HorizontalLayout {
            padding-bottom: Theme.space-2;
            spacing: 9.6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius-md;
                    background: Theme.accent-green.with-alpha(0.12);
                    border-width: Theme.hairline;
                    border-color: Theme.accent-green.with-alpha(0.45);
                    Emoji { char: "⚡"; size: 16px; }
                }
            }
            VerticalLayout {
                alignment: center;
                SelectableText { text: T.tr("mods.performance"); font-size: Theme.text-base; font-weight: 700; color: Theme.text; }
                SelectableText { text: T.tr1("mods.performanceCount", "count", LibraryBridge.m-pinned.length); font-family: Theme.label-family(8px); font-size: Theme.label-size(8px); font-weight: 700; color: Theme.muted; }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                if LibraryBridge.m-perf-missing == 0: Badge { text: T.tr("mods.upToDate"); variant: BadgeVariant.ok; dot: true; }
                if LibraryBridge.m-perf-missing > 0: Badge { text: T.tr1("mods.perfPending", "count", LibraryBridge.m-perf-missing); variant: BadgeVariant.warn; dot: true; }
            }
        }
        HorizontalLayout {
            padding-bottom: Theme.space-3;
            SelectableText {
                text: T.tr("mods.performanceDesc");
                color: Theme.muted;
                font-size: 13px;
                line-height-factor: 1.6 / 1.28;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            padding-bottom: Theme.space-3;
            spacing: 5.6px;
            alignment: start;
            for p in LibraryBridge.m-pinned: Pill { pill: p; }
        }
        Rectangle { height: Theme.hairline; background: Theme.border-solid; }
        HorizontalLayout {
            padding-top: Theme.space-3;
            spacing: Theme.space-3;
            VText {
                horizontal-stretch: 1;
                text: T.tr1("mods.installTarget", "name", LibraryBridge.m-target != "" ? LibraryBridge.m-target : "—");
                font-size: Theme.text-xs;
                color: Theme.muted;
                font-weight: 500;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    text: LibraryBridge.m-perf-missing > 0 ? T.tr("mods.installUpdate") : T.tr("mods.installPerformance");
                    loading: LibraryBridge.m-installing-preset;
                    enabled: !LibraryBridge.m-installing-preset && LibraryBridge.m-preset-available;
                    clicked => { LibraryBridge.m-install-preset(); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- modals

component DeleteModModal inherits Modal {
    open <=> LibraryBridge.m-delete-open;
    title: T.tr("mods.deleteTitle");
    dialog-width: 460px;
    dismissable: !LibraryBridge.m-deleting;
    close => { LibraryBridge.m-cancel-delete(); }
    VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-3;
        SelectableText {
            text: T.tr2("mods.deleteConfirm", "name", LibraryBridge.m-delete-name, "file", LibraryBridge.m-delete-filename);
            color: Theme.muted-strong;
            font-size: Theme.text-sm;
            wrap: word-wrap;
        }
        if LibraryBridge.m-delete-dependents != "": GlassPanel {
            fill: Theme.accent-alt.with-alpha(0.10);
            stroke: Theme.accent-alt.with-alpha(0.45);
            height: warn-r.preferred-height;
            warn-r := HorizontalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: start;
                    Icon { data: Icons.alert-triangle; size: 15px; color: Theme.accent-alt; }
                }
                SelectableText {
                    horizontal-stretch: 1;
                    text: T.tr1("mods.deleteDependentWarn", "deps", LibraryBridge.m-delete-dependents);
                    color: Theme.accent-alt;
                    font-size: Theme.text-xs;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }
        }
    }
    ModalFooter {
        Btn {
            variant: BtnVariant.secondary;
            text: T.tr("home.wizardCancelBtn");
            enabled: !LibraryBridge.m-deleting;
            clicked => { LibraryBridge.m-cancel-delete(); }
        }
        Btn {
            variant: BtnVariant.danger;
            text: T.tr("mods.delete");
            loading: LibraryBridge.m-deleting;
            enabled: !LibraryBridge.m-deleting;
            clicked => { LibraryBridge.m-confirm-delete(); }
        }
    }
}

component VersionOptionRow inherits Rectangle {
    in property <ModVersionOption> opt;
    in property <bool> selected;
    callback clicked();
    height: r.preferred-height;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.surface-up : transparent;
    border-width: Theme.hairline;
    border-color: selected ? Theme.edge-strong : transparent;
    animate background, border-color { duration: Theme.dur-fast; }
    r := HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: Theme.space-2;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                Text {
                    text: root.opt.version-number;
                    font-size: Theme.text-sm;
                    font-weight: 700;
                    color: root.selected ? Theme.accent-bright : Theme.text;
                    overflow: elide;
                }
                Badge {
                    text: root.opt.version-type;
                    variant: root.opt.version-type == "release" ? BadgeVariant.ok
                        : root.opt.version-type == "beta" ? BadgeVariant.warn : BadgeVariant.err;
                }
                if root.opt.installed: Badge {
                    text: T.tr("mods.versionCurrent");
                    variant: BadgeVariant.accent;
                }
            }
            if root.opt.name != "" && root.opt.name != root.opt.version-number: Text {
                text: root.opt.name;
                font-size: Theme.text-xs;
                color: Theme.muted;
                overflow: elide;
            }
        }
        if root.opt.date != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.opt.date;
                font-family: Theme.font-mono;
                font-size: Theme.text-xs;
                color: Theme.muted;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: root.opt.installed ? default : pointer;
        enabled: !root.opt.installed;
        clicked => { root.clicked(); }
    }
}

component ModVersionModal inherits Modal {
    open <=> LibraryBridge.m-ver-open;
    title: T.tr("mods.versionModalTitle") + (LibraryBridge.m-ver-title != "" ? " · " + LibraryBridge.m-ver-title : "");
    subtitle: LibraryBridge.m-ver-current != "" ? T.tr("mods.versionCurrent") + ": " + LibraryBridge.m-ver-current : "";
    dialog-width: 560px;
    dismissable: !LibraryBridge.m-ver-applying;
    close => { LibraryBridge.m-close-versions(); }

    VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;
        if LibraryBridge.m-ver-loading: VerticalLayout {
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-6;
            spacing: Theme.space-2;
            HorizontalLayout { alignment: center; ModSpinner { } }
            SelectableText { text: T.tr("mods.versionLoading"); color: Theme.muted; horizontal-alignment: center; }
        }
        if !LibraryBridge.m-ver-loading && LibraryBridge.m-ver-error != "": ErrorBanner {
            text: LibraryBridge.m-ver-error;
        }
        if !LibraryBridge.m-ver-loading && LibraryBridge.m-ver-error == "" && LibraryBridge.m-ver-options.length == 0: SelectableText {
            text: T.tr2("mods.versionEmpty", "loader", LibraryBridge.m-sel-loader, "mc", LibraryBridge.m-sel-version);
            color: Theme.muted;
            wrap: word-wrap;
        }
        if !LibraryBridge.m-ver-loading && LibraryBridge.m-ver-options.length > 0: Rectangle {
            height: min(260px, ver-list.preferred-height + 8px);
            border-radius: Theme.radius-md;
            background: Theme.card-bg-soft;
            border-width: Theme.hairline;
            border-color: Theme.border-solid;
            clip: true;
            ScrollArea {
                width: 100%;
                height: 100%;
                ver-list := VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for opt in LibraryBridge.m-ver-options: VersionOptionRow {
                        opt: opt;
                        selected: opt.version-id == LibraryBridge.m-ver-selected;
                        clicked => { LibraryBridge.m-select-version(opt.version-id); }
                    }
                }
            }
        }
        if LibraryBridge.m-ver-planning: HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            ModSpinner { }
            VText { text: T.tr("mods.versionPlanning"); font-size: Theme.text-xs; color: Theme.muted; }
        }
        if !LibraryBridge.m-ver-planning && LibraryBridge.m-ver-companions.length > 0: GlassPanel {
            fill: Theme.accent-cyan.with-alpha(0.08);
            stroke: Theme.accent-cyan.with-alpha(0.4);
            height: comp-col.preferred-height;
            comp-col := VerticalLayout {
                padding: Theme.space-3;
                spacing: 4px;
                SelectableText {
                    text: T.tr("mods.versionCompanionsTitle");
                    font-size: Theme.text-xs;
                    font-weight: 700;
                    color: Theme.accent-cyan;
                    wrap: word-wrap;
                }
                for c in LibraryBridge.m-ver-companions: SelectableText {
                    text: "• " + c.title + ": " + c.from-ver + " → " + c.to-ver;
                    font-size: Theme.text-xs;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        if !LibraryBridge.m-ver-planning && LibraryBridge.m-ver-warnings.length > 0: GlassPanel {
            fill: Theme.accent-alt.with-alpha(0.10);
            stroke: Theme.accent-alt.with-alpha(0.45);
            height: vw-col.preferred-height;
            vw-col := VerticalLayout {
                padding: Theme.space-3;
                spacing: 4px;
                SelectableText {
                    text: T.tr("mods.versionWarnTitle");
                    font-size: Theme.text-xs;
                    font-weight: 700;
                    color: Theme.accent-alt;
                }
                for w in LibraryBridge.m-ver-warnings: SelectableText {
                    text: "• " + w;
                    font-size: Theme.text-xs;
                    color: Theme.accent-alt;
                    wrap: word-wrap;
                }
            }
        }
    }
    ModalFooter {
        Btn {
            variant: BtnVariant.secondary;
            text: T.tr("home.wizardCancelBtn");
            enabled: !LibraryBridge.m-ver-applying;
            clicked => { LibraryBridge.m-close-versions(); }
        }
        Btn {
            variant: BtnVariant.primary;
            text: LibraryBridge.m-ver-companions.length > 0
                ? T.tr1("mods.versionApplyWith", "count", LibraryBridge.m-ver-companions.length + 1)
                : T.tr("mods.versionApply");
            loading: LibraryBridge.m-ver-applying;
            enabled: LibraryBridge.m-ver-selected != "" && !LibraryBridge.m-ver-planning && !LibraryBridge.m-ver-applying;
            clicked => { LibraryBridge.m-apply-version(); }
        }
    }
}

component InstallPreviewModal inherits Modal {
    open <=> LibraryBridge.m-prev-open;
    title: T.tr1("mods.previewTitle", "name", LibraryBridge.m-prev-title);
    dialog-width: 540px;
    dismissable: !LibraryBridge.m-prev-committing;
    close => { LibraryBridge.m-prev-cancel(); }

    VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;
        if LibraryBridge.m-prev-upgrades.length > 0: GlassPanel {
            fill: Theme.accent-cyan.with-alpha(0.08);
            stroke: Theme.accent-cyan.with-alpha(0.4);
            height: up-col.preferred-height;
            up-col := VerticalLayout {
                padding: Theme.space-3;
                spacing: 4px;
                SelectableText {
                    text: T.tr("mods.previewUpgrades");
                    font-size: Theme.text-xs;
                    font-weight: 700;
                    color: Theme.accent-cyan;
                    wrap: word-wrap;
                }
                for u in LibraryBridge.m-prev-upgrades: SelectableText {
                    text: "• " + u.title + ": " + u.from-ver + " → " + u.to-ver;
                    font-size: Theme.text-xs;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        if LibraryBridge.m-prev-enables.length > 0: GlassPanel {
            fill: Theme.accent-green.with-alpha(0.08);
            stroke: Theme.accent-green.with-alpha(0.4);
            height: en-col.preferred-height;
            en-col := VerticalLayout {
                padding: Theme.space-3;
                spacing: 4px;
                SelectableText {
                    text: T.tr("mods.previewEnable");
                    font-size: Theme.text-xs;
                    font-weight: 700;
                    color: Theme.accent-green;
                }
                for f in LibraryBridge.m-prev-enables: SelectableText {
                    text: "• " + f;
                    font-size: Theme.text-xs;
                    color: Theme.text;
                }
            }
        }
        if LibraryBridge.m-prev-conflicts != "": GlassPanel {
            fill: Theme.accent-red.with-alpha(0.10);
            stroke: Theme.accent-red.with-alpha(0.45);
            height: cf-r.preferred-height;
            cf-r := HorizontalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-2;
                Icon { data: Icons.alert-circle; size: 15px; color: Theme.accent-red; }
                SelectableText {
                    horizontal-stretch: 1;
                    text: T.tr1("mods.previewConflicts", "mods", LibraryBridge.m-prev-conflicts);
                    color: Theme.accent-red;
                    font-size: Theme.text-xs;
                    wrap: word-wrap;
                }
            }
        }
        if LibraryBridge.m-prev-missing != "": GlassPanel {
            fill: Theme.accent-alt.with-alpha(0.10);
            stroke: Theme.accent-alt.with-alpha(0.45);
            height: ms-r.preferred-height;
            ms-r := HorizontalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-2;
                Icon { data: Icons.alert-triangle; size: 15px; color: Theme.accent-alt; }
                SelectableText {
                    horizontal-stretch: 1;
                    text: T.tr1("mods.previewMissing", "mods", LibraryBridge.m-prev-missing);
                    color: Theme.accent-alt;
                    font-size: Theme.text-xs;
                    wrap: word-wrap;
                }
            }
        }
        if LibraryBridge.m-prev-issues.length > 0: GlassPanel {
            fill: Theme.accent-red.with-alpha(0.10);
            stroke: Theme.accent-red.with-alpha(0.45);
            height: iss-col.preferred-height;
            iss-col := VerticalLayout {
                padding: Theme.space-3;
                spacing: 4px;
                SelectableText {
                    text: T.tr("mods.previewCompatWarn");
                    font-size: Theme.text-xs;
                    font-weight: 700;
                    color: Theme.accent-red;
                }
                for line in LibraryBridge.m-prev-issues: SelectableText {
                    text: "• " + line;
                    font-size: Theme.text-xs;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
    }
    ModalFooter {
        Btn {
            variant: BtnVariant.secondary;
            text: T.tr("home.wizardCancelBtn");
            enabled: !LibraryBridge.m-prev-committing;
            clicked => { LibraryBridge.m-prev-cancel(); }
        }
        Btn {
            variant: LibraryBridge.m-prev-has-errors ? BtnVariant.danger : BtnVariant.primary;
            text: LibraryBridge.m-prev-upgrades.length > 0 && !LibraryBridge.m-prev-has-errors
                ? T.tr("mods.previewInstallAndUpdate")
                : T.tr("mods.previewInstallAnyway");
            loading: LibraryBridge.m-prev-committing;
            enabled: !LibraryBridge.m-prev-committing;
            clicked => { LibraryBridge.m-prev-confirm(true); }
        }
    }
}

export component ModsPage inherits Rectangle {
    property <int> instance-count: AppState.instances.length;
    changed instance-count => { LibraryBridge.instances-changed(); }
    // the page may be instantiated after the list arrived (route entered first)
    init => { LibraryBridge.instances-changed(); }
    // infinite scroll on the Modrinth tab (the "show more" button stays for parity)
    property <bool> want-more: scroll.near-bottom && LibraryBridge.m-tab == 4 && LibraryBridge.m-has-more && !LibraryBridge.m-loading-more && !LibraryBridge.m-searching;
    changed want-more => {
        if self.want-more { LibraryBridge.m-load-more(); }
    }

    scroll := LibScroll {
        spacing: Theme.space-4;
        near-margin: 240px;
        CatalogHeader { }
        InstanceStrip { }
        if LibraryBridge.m-progress-active: ProgressDeck { }
        CatalogTabs { }
        if LibraryBridge.m-tab == 0: InstalledPane { }
        if LibraryBridge.m-tab == 1: ResourcePacksPane { }
        if LibraryBridge.m-tab == 2: ShadersPane { }
        if LibraryBridge.m-tab == 3: PresetsPane { }
        if LibraryBridge.m-tab == 4: ModrinthPane { }
    }

    DeleteModModal { }
    ModVersionModal { }
    InstallPreviewModal { }
    ModrinthProjectDetailModal { }
    CopyFromModal { }
    RpDeleteDialog { }
    ShDeleteDialog { }
}
