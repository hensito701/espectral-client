// OWNER: library-mods agent. Port of src/ui/src/pages/ImportCenter.svelte.
// Keep the exported component name and the empty interface used by app.slint.
//
// Lane A: .mrpack installer (file picker, OS drag & drop onto the window — see
// library_mods/drop.rs —, memory presets, import-progress / import-done
// tracking). Lane B: launcher profile migrator (engine import_sources /
// import_profile). Bottom: session-local history. State: LibraryBridge.i-*.

import { Theme, T, Router, AppState, GlassCard, Elevation, Btn, BtnVariant, BtnSize, Badge, BadgeVariant, GradientText, GradientKind, Icon, Icons, Spinner, Emoji, ProgressBar, ProgressTone, ProgressThickness, Field, Select, SelectOption } from "../../widgets.slint";
import { LibraryBridge, ImportSourceRow, RecentImportRow } from "api.slint";
import { LibScroll, GlassPanel, GlowDot, VText, Chip, CenterText } from "parts.slint";
import { MrpackModal } from "mrpack-modal.slint";

/// 2px dashed rounded border (CSS border: 2px dashed) — dashes along the
/// straight edges + solid corner arcs.
component DashedBorder inherits Rectangle {
    in property <color> stroke;
    in property <length> radius: Theme.radius-lg;
    property <length> dash: 6px;
    property <length> period: 10px;
    property <length> run-x: self.width - 2 * radius;
    property <length> run-y: self.height - 2 * radius;
    property <int> nx: max(0, floor(run-x / period));
    property <int> ny: max(0, floor(run-y / period));
    property <length> off-x: radius + (run-x - nx * period + period - dash) / 2;
    property <length> off-y: radius + (run-y - ny * period + period - dash) / 2;
    for i in root.nx: Rectangle { x: root.off-x + i * root.period; y: 0; width: root.dash; height: 2px; background: root.stroke; }
    for i in root.nx: Rectangle { x: root.off-x + i * root.period; y: root.height - 2px; width: root.dash; height: 2px; background: root.stroke; }
    for i in root.ny: Rectangle { x: 0; y: root.off-y + i * root.period; width: 2px; height: root.dash; background: root.stroke; }
    for i in root.ny: Rectangle { x: root.width - 2px; y: root.off-y + i * root.period; width: 2px; height: root.dash; background: root.stroke; }
    // corners
    property <float> r: root.radius / 1px - 1;
    property <float> w: root.width / 1px - 1;
    property <float> h: root.height / 1px - 1;
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: root.stroke;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 1 " + (root.r + 1) + " A " + root.r + " " + root.r + " 0 0 1 " + (root.r + 1) + " 1"
            + " M " + (root.w - root.r) + " 1 A " + root.r + " " + root.r + " 0 0 1 " + root.w + " " + (root.r + 1)
            + " M " + root.w + " " + (root.h - root.r) + " A " + root.r + " " + root.r + " 0 0 1 " + (root.w - root.r) + " " + root.h
            + " M " + (root.r + 1) + " " + root.h + " A " + root.r + " " + root.r + " 0 0 1 1 " + (root.h - root.r);
    }
}

component LaneHeader inherits VerticalLayout {
    in property <string> badge;
    in property <BadgeVariant> badge-variant;
    in property <string> tag;
    in property <string> title;
    in property <string> desc;
    spacing: Theme.space-2;
    padding-bottom: Theme.space-5;
    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Badge { text: root.badge; variant: root.badge-variant; }
        }
        VText { text: root.tag; font-family: Theme.font-mono; font-size: Theme.text-xs; color: Theme.muted; }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.text-xl;
        font-weight: 700;
        letter-spacing: -0.44px;
        wrap: word-wrap;
    }
    Text {
        text: root.desc;
        color: Theme.muted;
        font-size: Theme.text-sm;
        line-height-factor: 1.5 / 1.28;
        wrap: word-wrap;
    }
}

// ---------------------------------------------------------------- lane A

component DropZone inherits Rectangle {
    property <bool> working: LibraryBridge.i-busy || (LibraryBridge.i-phase >= 1 && LibraryBridge.i-phase <= 3);
    property <bool> dragging: LibraryBridge.dragging-file && !working;
    property <bool> selected: LibraryBridge.i-path != "";
    property <bool> hovered: touch.has-hover;
    height: col.preferred-height;
    border-radius: Theme.radius-lg;
    background: dragging ? Theme.surface-up : hovered ? Theme.surface-up : Theme.surface-solid;
    drop-shadow-color: dragging ? Theme.accent-gold.with-alpha(0.2) : transparent;
    drop-shadow-blur: 24px;
    animate background { duration: Theme.dur-fast; }
    // radial glow
    Rectangle {
        border-radius: parent.border-radius;
        clip: true;
        Rectangle {
            width: parent.width * 1.4;
            height: parent.width * 1.4;
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.3 - self.height / 2;
            background: @radial-gradient(circle, Theme.accent.with-alpha(0.08) 0%, transparent 50%);
        }
    }
    if root.selected && !root.dragging: Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.4);
    }
    if !root.selected || root.dragging: DashedBorder {
        stroke: root.dragging ? Theme.accent-gold : root.hovered ? Theme.accent : Theme.border;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { LibraryBridge.i-browse(); }
    }
    col := VerticalLayout {
        padding-top: Theme.space-6;
        padding-bottom: Theme.space-6;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-3;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: Theme.accent.with-alpha(0.12);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.25);
                Emoji { char: root.dragging ? "📥" : "📦"; size: 26px; }
            }
        }
        VerticalLayout {
            spacing: Theme.space-1;
            CenterText {
                text: root.dragging ? T.tr("import.mrpack.dropTitle") : LibraryBridge.i-file-name != "" ? LibraryBridge.i-file-name : T.tr("import.mrpack.dropTitle");
                color: Theme.text;
                font-size: Theme.text-md;
                font-weight: 600;
            }
            CenterText {
                text: LibraryBridge.i-file-name != "" ? LibraryBridge.i-path : T.tr("import.mrpack.dropSubtitle");
                font-size: Theme.text-xs;
                max-text-width: 400px;
            }
        }
        HorizontalLayout {
            alignment: center;
            Btn {
                variant: LibraryBridge.i-file-name != "" ? BtnVariant.ghost : BtnVariant.secondary;
                size: BtnSize.sm;
                enabled: !root.working;
                text: LibraryBridge.i-file-name != "" ? "Cambiar archivo" : T.tr("import.mrpack.browseButton");
                clicked => { LibraryBridge.i-browse(); }
            }
        }
    }
}

component FileChip inherits Rectangle {
    property <bool> working: LibraryBridge.i-busy || (LibraryBridge.i-phase >= 1 && LibraryBridge.i-phase <= 3);
    height: row.preferred-height;
    border-radius: Theme.radius-md;
    background: Theme.surface-up-solid;
    border-width: 1px;
    border-color: Theme.border;
    row := HorizontalLayout {
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;
        VerticalLayout {
            alignment: center;
            Emoji { char: "📄"; size: 16px; }
        }
        VText {
            text: LibraryBridge.i-file-name;
            font-family: Theme.font-mono;
            font-size: Theme.text-xs;
            font-weight: 600;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Badge { text: ".mrpack"; }
        }
        Rectangle { horizontal-stretch: 1; }
        if !root.working: VerticalLayout {
            alignment: center;
            Rectangle {
                width: clear.preferred-width + 12px;
                height: clear.preferred-height + 4px;
                border-radius: Theme.radius-sm;
                background: clear-touch.has-hover ? rgba(239, 68, 68, 0.12) : transparent;
                clear := Text {
                    text: "✕";
                    font-size: Theme.text-sm;
                    color: clear-touch.has-hover ? Theme.accent-red : Theme.muted;
                }
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { LibraryBridge.i-clear(); }
                }
            }
        }
    }
}

component MemChip inherits Chip {
    in property <int> mb;
    property <bool> working: LibraryBridge.i-busy || (LibraryBridge.i-phase >= 1 && LibraryBridge.i-phase <= 3);
    active: LibraryBridge.i-memory-mb == mb;
    enabled: !working;
    pad-x: 10px;
    pad-y: 4px;
    radius: Theme.radius-sm;
    font-weight: 600;
    idle-bg: Theme.surface-solid;
    idle-border: Theme.border;
    idle-fg: Theme.muted;
    active-bg: Theme.accent.with-alpha(0.2);
    active-glow: false;
    clicked => {
        LibraryBridge.i-memory-mb = self.mb;
        LibraryBridge.i-memory-text = self.mb > 0 ? "" + self.mb : "";
    }
}

component MemoryConfig inherits VerticalLayout {
    property <bool> working: LibraryBridge.i-busy || (LibraryBridge.i-phase >= 1 && LibraryBridge.i-phase <= 3);
    padding-top: Theme.space-1;
    Field {
        label: T.tr("import.mrpack.memoryLabel");
        hint: T.tr("import.mrpack.memoryHint");
        VerticalLayout {
            spacing: Theme.space-2;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: 200px;
                    height: 36px;
                    border-radius: Theme.radius-md;
                    background: Theme.card-bg-soft;
                    border-width: 1px;
                    border-color: mem.has-focus ? Theme.border-focus : Theme.border;
                    opacity: root.working ? 0.5 : 1;
                    TouchArea {
                        mouse-cursor: MouseCursor.text;
                        clicked => { mem.focus(); }
                    }
                    mem := TextInput {
                        x: Theme.space-3;
                        width: parent.width - 2 * Theme.space-3;
                        height: self.preferred-height;
                        y: (parent.height - self.height) / 2;
                        text <=> LibraryBridge.i-memory-text;
                        enabled: !root.working;
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        color: Theme.text;
                        input-type: InputType.number;
                        single-line: true;
                        edited => { LibraryBridge.i-set-memory-text(self.text); }
                    }
                    if LibraryBridge.i-memory-text == "": Text {
                        x: Theme.space-3;
                        height: parent.height;
                        text: T.tr("instance.memoryAuto");
                        color: Theme.muted;
                        font-size: Theme.text-sm;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                MemChip { text: T.tr("instance.memoryAuto"); mb: 0; }
                MemChip { text: "2 GB"; mb: 2048; }
                MemChip { text: "3 GB"; mb: 3072; }
                MemChip { text: "4 GB"; mb: 4096; }
                MemChip { text: "6 GB"; mb: 6144; }
                MemChip { text: "8 GB"; mb: 8192; }
            }
        }
    }
}

component MrpackProgress inherits Rectangle {
    property <int> phase: LibraryBridge.i-phase;
    height: col.preferred-height;
    border-radius: Theme.radius-md;
    background: Theme.surface-solid;
    border-width: 1px;
    border-color: Theme.border;
    col := VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;
        HorizontalLayout {
            spacing: Theme.space-2;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.phase == 1 ? T.tr("import.mrpack.phasePost")
                        : root.phase == 2 ? T.tr2("import.mrpack.phaseFiles", "done", LibraryBridge.i-done, "total", LibraryBridge.i-total > 0 ? "" + LibraryBridge.i-total : "…")
                        : root.phase == 3 ? T.tr2("import.mrpack.phaseOverrides", "done", LibraryBridge.i-done, "total", LibraryBridge.i-total > 0 ? "" + LibraryBridge.i-total : "…")
                        : root.phase == 5 ? T.tr1("import.mrpack.phaseError", "error", LibraryBridge.i-error)
                        : T.tr("import.mrpack.installing");
                    color: root.phase == 5 ? Theme.accent-red : Theme.text;
                    font-size: Theme.text-xs;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }
            if root.phase == 2 || root.phase == 3: VText {
                text: LibraryBridge.i-done + " / " + LibraryBridge.i-total;
                font-family: Theme.font-mono;
                font-size: Theme.text-xs;
                font-weight: 600;
                color: Theme.accent;
            }
        }
        ProgressBar {
            value: LibraryBridge.i-total > 0 ? LibraryBridge.i-done : 0;
            max: LibraryBridge.i-total > 0 ? LibraryBridge.i-total : 100;
            indeterminate: root.phase == 1;
            tone: root.phase == 5 ? ProgressTone.danger : ProgressTone.accent;
        }
    }
}

component MrpackSuccess inherits VerticalLayout {
    padding-top: Theme.space-8;
    padding-bottom: Theme.space-8;
    padding-left: Theme.space-4;
    padding-right: Theme.space-4;
    spacing: Theme.space-4;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: @radial-gradient(circle, Theme.accent-green.with-alpha(0.2) 0%, transparent 70%);
            border-width: 1px;
            border-color: Theme.accent-green;
            Emoji { char: "✨"; size: 32px; }
        }
    }
    VerticalLayout {
        spacing: Theme.space-1;
        HorizontalLayout {
            alignment: center;
            Badge {
                text: LibraryBridge.i-already-exists ? "INSTANCIA VINCULADA" : "INSTALACIÓN COMPLETADA";
                variant: BadgeVariant.ok;
                large: true;
            }
        }
        CenterText {
            text: LibraryBridge.i-result-instance;
            color: Theme.text;
            font-size: Theme.text-2xl;
            font-weight: 700;
        }
        CenterText {
            text: LibraryBridge.i-already-exists ? T.tr1("import.mrpack.alreadyExists", "name", LibraryBridge.i-result-instance) : T.tr1("import.mrpack.successDesc", "name", LibraryBridge.i-result-instance);
            max-text-width: 360px;
        }
    }
    HorizontalLayout {
        alignment: center;
        padding-top: Theme.space-2;
        VerticalLayout {
            max-width: 320px;
            preferred-width: 320px;
            spacing: Theme.space-2;
            Btn {
                block: true;
                text: T.tr("import.mrpack.viewInstance");
                clicked => { LibraryBridge.i-open-instance(LibraryBridge.i-result-instance); }
            }
            Btn {
                block: true;
                variant: BtnVariant.ghost;
                text: T.tr("import.mrpack.importAnother");
                clicked => { LibraryBridge.i-reset(); }
            }
        }
    }
}

component MrpackForm inherits VerticalLayout {
    property <bool> working: LibraryBridge.i-busy || (LibraryBridge.i-phase >= 1 && LibraryBridge.i-phase <= 3);
    spacing: Theme.space-5;
    DropZone { }
    if LibraryBridge.i-file-name != "": FileChip { }
    MemoryConfig { }
    if root.working || LibraryBridge.i-phase == 5: MrpackProgress { }
    VerticalLayout {
        padding-top: Theme.space-2;
        Btn {
            size: BtnSize.lg;
            block: true;
            enabled: LibraryBridge.i-path != "" && !root.working;
            loading: root.working;
            text: root.working ? T.tr("import.mrpack.installing") : T.tr("import.mrpack.installButton");
            clicked => { LibraryBridge.i-install(); }
        }
    }
}

component LaneA inherits GlassCard {
    padding-size: Theme.space-6;
    // content stays at the top when the sibling lane is taller (CSS grid stretch)
    fill: Theme.surface;
    spacing: 0px;
    LaneHeader {
        badge: T.tr("import.laneA.badge");
        badge-variant: BadgeVariant.accent;
        tag: ".mrpack";
        title: T.tr("import.laneA.title");
        desc: T.tr("import.laneA.description");
    }
    if LibraryBridge.i-phase == 4: MrpackSuccess { vertical-stretch: 0; }
    if LibraryBridge.i-phase != 4: MrpackForm { vertical-stretch: 0; }
    Rectangle { vertical-stretch: 1; }
}

// ---------------------------------------------------------------- lane B

component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: Theme.text-xs;
    font-weight: 600;
    letter-spacing: 0.6px;
}

component MetaPill inherits Rectangle {
    in property <string> emoji;
    in property <string> text;
    height: row.preferred-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-pill;
    background: Theme.dark ? rgba(255, 255, 255, 0.05) : rgba(0, 0, 0, 0.04);
    row := HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: Theme.space-1;
        VerticalLayout {
            alignment: center;
            Emoji { char: root.emoji; size: 11px; }
        }
        VText { text: root.text; font-size: 11px; color: Theme.muted; }
    }
}

component SourceCard inherits Rectangle {
    in property <ImportSourceRow> src;
    property <bool> selected: LibraryBridge.i-source-id == src.id;
    property <bool> lunar: src.kind == "lunar";
    property <bool> hovered: touch.has-hover;
    height: col.preferred-height;
    border-radius: Theme.radius-md;
    background: selected || hovered ? Theme.surface-up : Theme.surface-solid;
    border-width: 1px;
    border-color: selected ? (lunar ? Theme.accent-purple : Theme.accent) : hovered ? Theme.hover-border : Theme.border;
    drop-shadow-color: selected ? (lunar ? rgba(168, 85, 247, 0.15) : Theme.accent.with-alpha(0.12)) : transparent;
    drop-shadow-blur: 16px;
    animate background, border-color { duration: Theme.dur-fast; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { LibraryBridge.i-source-id = root.src.id; }
    }
    col := VerticalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;
        HorizontalLayout {
            spacing: Theme.space-2;
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-3;
                VerticalLayout {
                    alignment: start;
                    padding-top: 2px;
                    Emoji {
                        char: root.src.kind == "vanilla" ? "⛏️" : root.src.kind == "fastclient" ? "⚡" : root.src.kind == "lunar" ? "🌙" : "📦";
                        size: 20px;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        VText { text: root.src.label != "" ? root.src.label : root.src.id; font-size: Theme.text-sm; font-weight: 600; }
                        VerticalLayout {
                            alignment: center;
                            Badge {
                                text: root.src.kind;
                                variant: root.src.kind == "vanilla" ? BadgeVariant.vanilla : root.src.kind == "fastclient" ? BadgeVariant.accent : root.src.kind == "lunar" ? BadgeVariant.purple : BadgeVariant.fabric;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            max-width: 320px;
                            border-radius: Theme.radius-xs;
                            background: Theme.dark ? rgba(255, 255, 255, 0.04) : rgba(0, 0, 0, 0.04);
                            border-width: 1px;
                            border-color: Theme.border;
                            min-width: min(320px, path.preferred-width + 12px);
                            height: path.preferred-height + 4px;
                            path := Text {
                                x: 6px;
                                width: parent.width - 12px;
                                text: root.src.path;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                color: Theme.muted;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.dark ? rgba(255, 255, 255, 0.2) : rgba(0, 0, 0, 0.2);
                    background: Theme.surface-solid;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.selected ? (root.lunar ? Theme.accent-purple : Theme.accent) : transparent;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            MetaPill { emoji: "📋"; text: T.tr1("import.profile.optionsCount", "count", root.src.options-count); }
            MetaPill { emoji: "🌐"; text: T.tr1("import.profile.serversCount", "count", root.src.servers-count); }
            if root.src.lunar-ram > 0: MetaPill { emoji: "⚡"; text: T.tr1("import.profile.lunarRam", "ram", root.src.lunar-ram); }
        }
        if root.lunar: Rectangle {
            height: shield.preferred-height;
            border-radius: Theme.radius-sm;
            background: rgba(168, 85, 247, 0.1);
            border-width: 1px;
            border-color: rgba(168, 85, 247, 0.25);
            shield := HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                padding-top: Theme.space-1;
                padding-bottom: Theme.space-1;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Emoji { char: "🛡️"; size: 12px; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: T.tr("import.profile.lunarTokenShield");
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.dark ? #d8b4fe : #7e22ce;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

component SourceInfoBox inherits Rectangle {
    in property <string> emoji;
    in property <string> text;
    in property <bool> spinner;
    in property <bool> retry;
    height: col.preferred-height;
    border-radius: Theme.radius-md;
    background: Theme.surface-solid;
    border-width: 1px;
    border-color: Theme.border;
    col := VerticalLayout {
        padding: Theme.space-6;
        spacing: Theme.space-3;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: center;
            if root.spinner: VerticalLayout {
                alignment: center;
                Spinner { size: 18px; tint: Theme.accent; }
            }
            if root.emoji != "": VerticalLayout {
                alignment: center;
                Emoji { char: root.emoji; size: 20px; }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.text;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        if root.retry: HorizontalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.secondary;
                size: BtnSize.sm;
                text: T.tr("import.profile.retrySources");
                clicked => { LibraryBridge.i-load-sources(); }
            }
        }
    }
}

component PolicyCard inherits Rectangle {
    in property <bool> active;
    in property <string> title;
    in property <string> desc;
    callback picked();
    property <bool> hovered: touch.has-hover;
    height: row.preferred-height;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent.with-alpha(0.08) : hovered ? Theme.surface-up : Theme.surface-solid;
    border-width: 1px;
    border-color: active ? Theme.accent.with-alpha(0.5) : Theme.border;
    opacity: LibraryBridge.i-profile-importing ? 0.6 : 1;
    animate background, border-color { duration: Theme.dur-fast; }
    touch := TouchArea {
        enabled: !LibraryBridge.i-profile-importing;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    row := HorizontalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: start;
            padding-top: 3px;
            Rectangle {
                width: 13px;
                height: 13px;
                border-radius: 6.5px;
                background: root.active ? Theme.accent : transparent;
                border-width: 1px;
                border-color: root.active ? Theme.accent : Theme.muted;
                if root.active: Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.surface-solid;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: Theme.text-xs; font-weight: 600; wrap: word-wrap; }
            Text { text: root.desc; color: Theme.muted; font-size: 11px; line-height-factor: 1.4 / 1.28; wrap: word-wrap; }
        }
    }
}

component NoInstancesAlert inherits Rectangle {
    height: row.preferred-height;
    border-radius: Theme.radius-md;
    background: Theme.accent-alt.with-alpha(0.1);
    border-width: 1px;
    border-color: Theme.accent-alt.with-alpha(0.3);
    row := HorizontalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: T.tr("import.profile.noInstances"); color: Theme.accent-alt; font-size: Theme.text-xs; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                variant: BtnVariant.secondary;
                size: BtnSize.sm;
                text: T.tr("import.profile.createInstance");
                clicked => { LibraryBridge.i-open-wizard(); }
            }
        }
    }
}

component ProfileForm inherits VerticalLayout {
    spacing: Theme.space-5;
    Field {
        label: T.tr("import.profile.targetInstance");
        hint: T.tr("import.profile.targetHint");
        if AppState.instances.length > 0: Select {
            options: LibraryBridge.i-target-options;
            current-index: LibraryBridge.i-target-index;
            enabled: !LibraryBridge.i-profile-importing;
            selected(i, v) => { LibraryBridge.i-target = v; LibraryBridge.i-target-index = i; }
        }
        if AppState.instances.length == 0: NoInstancesAlert { }
    }
    VerticalLayout {
        spacing: Theme.space-2;
        HorizontalLayout {
            SectionLabel { text: T.tr("import.profile.sourceListTitle").to-uppercase(); horizontal-stretch: 1; vertical-alignment: center; }
            if LibraryBridge.i-sources-loading: Badge { text: "Buscando…"; }
        }
        if LibraryBridge.i-sources-loading: SourceInfoBox { spinner: true; text: T.tr("import.profile.loadingSources"); }
        if !LibraryBridge.i-sources-loading && LibraryBridge.i-sources-error != "": SourceInfoBox {
            text: T.tr1("import.profile.errorSources", "error", LibraryBridge.i-sources-error);
            retry: true;
        }
        if !LibraryBridge.i-sources-loading && LibraryBridge.i-sources-error == "" && LibraryBridge.i-sources.length == 0: SourceInfoBox {
            emoji: "🔍";
            text: T.tr("import.profile.noSourcesFound");
        }
        if !LibraryBridge.i-sources-loading && LibraryBridge.i-sources-error == "" && LibraryBridge.i-sources.length > 0: Flickable {
            height: min(280px, cards.preferred-height);
            interactive: false;
            content-height: cards.preferred-height;
            cards := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                spacing: Theme.space-3;
                for s in LibraryBridge.i-sources: SourceCard { src: s; }
            }
        }
    }
    VerticalLayout {
        spacing: Theme.space-2;
        SectionLabel { text: T.tr("import.profile.overwriteTitle").to-uppercase(); }
        PolicyCard {
            active: !LibraryBridge.i-overwrite-if-older;
            title: T.tr("import.profile.policyNever");
            desc: T.tr("import.profile.policyNeverDesc");
            picked => { LibraryBridge.i-overwrite-if-older = false; }
        }
        PolicyCard {
            active: LibraryBridge.i-overwrite-if-older;
            title: T.tr("import.profile.policyIfOlder");
            desc: T.tr("import.profile.policyIfOlderDesc");
            picked => { LibraryBridge.i-overwrite-if-older = true; }
        }
    }
    if LibraryBridge.i-profile-error != "": Rectangle {
        height: err.preferred-height;
        border-radius: Theme.radius-sm;
        background: rgba(239, 68, 68, 0.12);
        border-width: 1px;
        border-color: rgba(239, 68, 68, 0.3);
        err := HorizontalLayout {
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            Text { text: "⚠️ " + LibraryBridge.i-profile-error; color: Theme.accent-red; font-size: Theme.text-xs; wrap: word-wrap; }
        }
    }
    VerticalLayout {
        padding-top: Theme.space-2;
        Btn {
            size: BtnSize.lg;
            block: true;
            enabled: LibraryBridge.i-target != "" && LibraryBridge.i-source-id != "" && !LibraryBridge.i-profile-importing;
            loading: LibraryBridge.i-profile-importing;
            text: LibraryBridge.i-profile-importing ? T.tr("import.profile.importing") : T.tr("import.profile.importButton");
            clicked => { LibraryBridge.i-import-profile(); }
        }
    }
}

component StatChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tint;
    height: col.preferred-height;
    border-radius: Theme.radius-md;
    background: Theme.surface-solid;
    border-width: 1px;
    border-color: Theme.border;
    col := VerticalLayout {
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        Text { text: root.label; color: Theme.muted; font-size: 11px; overflow: elide; }
        Text { text: root.value; color: root.tint; font-size: Theme.text-lg; font-weight: 700; font-family: Theme.font-mono; }
    }
}

component ResultBox inherits Rectangle {
    in property <string> title;
    height: col.preferred-height;
    border-radius: Theme.radius-md;
    background: Theme.surface-solid;
    border-width: 1px;
    border-color: Theme.border;
    col := VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;
        Text { text: root.title; color: Theme.text; font-size: Theme.text-xs; font-weight: 600; }
        @children
    }
}

component ProfileResult inherits VerticalLayout {
    spacing: Theme.space-4;
    VerticalLayout {
        spacing: Theme.space-1;
        HorizontalLayout {
            alignment: start;
            Badge { text: "MIGRACIÓN COMPLETADA"; variant: BadgeVariant.ok; large: true; }
        }
        Text { text: T.tr("import.result.title"); color: Theme.text; font-size: Theme.text-lg; font-weight: 700; }
        Text { text: "Destino: " + LibraryBridge.i-target; color: Theme.muted; font-size: Theme.text-xs; }
    }
    GridLayout {
        spacing: Theme.space-2;
        Row {
            StatChip { label: T.tr1("import.result.copied", "count", LibraryBridge.i-res-copied.length); value: LibraryBridge.i-res-copied.length; tint: Theme.accent-green; }
            StatChip { label: T.tr1("import.result.skipped", "count", LibraryBridge.i-res-skipped.length); value: LibraryBridge.i-res-skipped.length; tint: Theme.muted; }
        }
        Row {
            StatChip { label: T.tr1("import.result.servers", "count", LibraryBridge.i-res-servers.length); value: LibraryBridge.i-res-servers.length; tint: Theme.accent-cyan; }
            StatChip { label: "Claves de opciones"; value: LibraryBridge.i-res-options; tint: Theme.accent-gold; }
        }
    }
    if LibraryBridge.i-res-copied.length > 0: ResultBox {
        title: "Archivos copiados con éxito:";
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for f in LibraryBridge.i-res-copied: Badge { text: f; variant: BadgeVariant.ok; }
        }
    }
    if LibraryBridge.i-res-skipped.length > 0: ResultBox {
        title: "Archivos omitidos:";
        VerticalLayout {
            spacing: Theme.space-1;
            for sk in LibraryBridge.i-res-skipped: HorizontalLayout {
                spacing: Theme.space-1;
                alignment: start;
                Text { text: sk.file; font-family: Theme.font-mono; font-size: 11px; color: Theme.muted; }
                Text { text: "(" + sk.reason + ")"; font-size: 11px; color: Theme.muted; opacity: 0.8; overflow: elide; }
            }
        }
    }
    if LibraryBridge.i-res-servers.length > 0: ResultBox {
        title: "Servidores importados:";
        Flickable {
            height: min(120px, srv.preferred-height);
            interactive: false;
            content-height: srv.preferred-height;
            srv := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                spacing: 6px;
                for s in LibraryBridge.i-res-servers: Rectangle {
                    height: srow.preferred-height;
                    border-radius: Theme.radius-sm;
                    background: Theme.dark ? rgba(255, 255, 255, 0.03) : rgba(0, 0, 0, 0.03);
                    srow := HorizontalLayout {
                        padding-top: Theme.space-1;
                        padding-bottom: Theme.space-1;
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;
                        VText { text: s.name != "" ? s.name : s.ip; font-size: Theme.text-xs; font-weight: 600; }
                        VText { text: s.ip; font-family: Theme.font-mono; font-size: 11px; color: Theme.muted; horizontal-stretch: 1; }
                        if s.has-icon: VerticalLayout {
                            alignment: center;
                            Badge { text: T.tr("import.result.hasIcon"); variant: BadgeVariant.accent; }
                        }
                    }
                }
            }
        }
    }
    VerticalLayout {
        padding-top: Theme.space-2;
        spacing: Theme.space-2;
        Btn {
            block: true;
            text: "Ver instancia " + LibraryBridge.i-target;
            clicked => { LibraryBridge.i-open-instance(LibraryBridge.i-target); }
        }
        Btn {
            block: true;
            variant: BtnVariant.secondary;
            text: T.tr("import.result.newImport");
            clicked => { LibraryBridge.i-reset-result(); }
        }
    }
}

component LaneB inherits GlassCard {
    padding-size: Theme.space-6;
    fill: Theme.surface;
    spacing: 0px;
    LaneHeader {
        badge: T.tr("import.laneB.badge");
        badge-variant: BadgeVariant.purple;
        tag: "Vanilla • FastClient • Lunar";
        title: T.tr("import.laneB.title");
        desc: T.tr("import.laneB.description");
    }
    if LibraryBridge.i-has-result: ProfileResult { vertical-stretch: 0; }
    if !LibraryBridge.i-has-result: ProfileForm { vertical-stretch: 0; }
    Rectangle { vertical-stretch: 1; }
}

// ---------------------------------------------------------------- recent

component RecentItem inherits Rectangle {
    in property <RecentImportRow> item;
    height: row.preferred-height;
    border-radius: Theme.radius-md;
    background: Theme.surface-solid;
    border-width: 1px;
    border-color: Theme.border;
    row := HorizontalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-4;
        HorizontalLayout {
            spacing: Theme.space-2;
            VText { text: root.item.time; font-family: Theme.font-mono; font-size: Theme.text-xs; color: Theme.muted; }
            VerticalLayout {
                alignment: center;
                Badge {
                    text: root.item.is-mrpack ? T.tr("import.recent.typeMrpack") : T.tr1("import.recent.typeProfile", "kind", root.item.kind != "" ? root.item.kind : "Perfil");
                    variant: root.item.is-mrpack ? BadgeVariant.accent : BadgeVariant.purple;
                }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-3;
            HorizontalLayout {
                spacing: 6px;
                VText { text: "Instancia:"; font-size: Theme.text-xs; color: Theme.muted; }
                VText {
                    text: root.item.instance + " ↗";
                    font-size: Theme.text-xs;
                    font-weight: 600;
                    color: link.has-hover ? Theme.accent-gold : Theme.accent;
                    link := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { LibraryBridge.i-open-instance(root.item.instance); }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.item.summary;
                    font-size: Theme.text-xs;
                    color: Theme.text;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }
    }
}

component RecentSection inherits Rectangle {
    height: col.preferred-height;
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.dark ? rgba(255, 255, 255, 0.1) : Theme.border;
    col := VerticalLayout {
        padding: Theme.space-5;
        spacing: Theme.space-3;
        HorizontalLayout {
            spacing: Theme.space-3;
            VText { text: T.tr("import.recent.title"); font-size: Theme.text-base; font-weight: 700; }
            VerticalLayout {
                alignment: center;
                Badge { text: T.tr("import.recent.badge"); variant: BadgeVariant.accent; pixel: true; }
            }
            Rectangle { horizontal-stretch: 1; }
            VText {
                text: LibraryBridge.i-recent.length + " " + (LibraryBridge.i-recent.length == 1 ? "registro" : "registros");
                font-size: Theme.text-xs;
                color: Theme.muted;
            }
        }
        if LibraryBridge.i-recent.length == 0: VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-2;
            HorizontalLayout {
                alignment: center;
                Emoji { char: "📑"; size: 28px; opacity: 0.6; }
            }
            CenterText { text: T.tr("import.recent.empty"); font-size: 13px; }
        }
        if LibraryBridge.i-recent.length > 0: VerticalLayout {
            spacing: Theme.space-2;
            for item in LibraryBridge.i-recent: RecentItem { item: item; }
        }
    }
}

export component ImportPage inherits Rectangle {
    property <int> instance-count: AppState.instances.length;
    changed instance-count => { LibraryBridge.instances-changed(); }
    // the page may be instantiated after the list arrived (route entered first)
    init => { LibraryBridge.instances-changed(); }
    // CSS grid 1fr 1fr: explicit lane width from the page width (no layout loop)
    property <length> lane-width: (min(Theme.content-max, root.width) - 2 * Theme.space-6 - Theme.space-6) / 2;
    LibScroll {
        content-padding-bottom: Theme.space-10;
        // header
        VerticalLayout {
            spacing: Theme.space-2;
            HorizontalLayout {
                spacing: Theme.space-3;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Badge { text: "MIGRATION & PACKS"; variant: BadgeVariant.accent; pixel: true; }
                }
                VText { text: "#/library/import"; font-family: Theme.font-mono; font-size: Theme.text-xs; color: Theme.muted; opacity: 0.8; }
            }
            GradientText {
                text: T.tr("import.pageTitle");
                gradient: GradientKind.emerald-gold;
                font-size: Theme.text-3xl;
                font-weight: 700;
                letter-spacing: -1.08px;
            }
            HorizontalLayout {
                Text {
                    text: T.tr("import.pageSubtitle");
                    color: Theme.muted;
                    font-size: Theme.text-md;
                    max-width: 780px;
                    wrap: word-wrap;
                }
            }
        }
        // lanes (grid 1fr 1fr, single column below 1024px)
        if root.width > 1024px: HorizontalLayout {
            spacing: Theme.space-6;
            alignment: start;
            LaneA { width: root.lane-width; }
            LaneB { width: root.lane-width; }
        }
        if root.width <= 1024px: VerticalLayout {
            spacing: Theme.space-6;
            LaneA { }
            LaneB { }
        }
        RecentSection { }
    }

    // MrpackModal can be hosted here too (drag & drop while it is open, palette)
    MrpackModal { }
}
