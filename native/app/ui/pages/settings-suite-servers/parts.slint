// OWNER: settings-suite-servers agent. Small building blocks shared by the
// Settings / Client Suite / Server Radar pages (not exported to other groups).
//
// Poster look: flat blocks, 2px borders, hard offset shadows, pixel-font card
// titles (16px, title colour). No glass, glow or gradient.

import { Theme, Icon, TextField, McTitle } from "../../widgets.slint";

/// `.preset-chip`: flat pill, 2px border; the active one is a gold pill with
/// purple ink and a hard 3px ink shadow.
export component PresetChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: lbl.preferred-height + 2 * 5.6px + 4px;
    min-width: lbl.preferred-width + 24px + 4px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: active ? Theme.gold : ta.has-hover ? Theme.surface-up-solid : Theme.card-bg-soft;
    border-width: 2px;
    border-color: active ? Theme.brand-ink : ta.has-hover ? Theme.hover-border : Theme.border-solid;
    drop-shadow-color: active ? Theme.brand-purple : transparent;
    drop-shadow-blur: 0px;
    drop-shadow-offset-x: 3px;
    drop-shadow-offset-y: 3px;
    opacity: enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.dur-fast; }
    lbl := Text {
        text: root.text;
        font-size: 12.8px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.on-gold : ta.has-hover ? Theme.text : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Badge variant="warn" size="sm" dot (local copy so CardHead can embed it).
export component WarnBadge inherits Rectangle {
    in property <string> text;
    height: row.preferred-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: Theme.accent-alt.with-alpha(0.14);
    border-width: 2px;
    border-color: Theme.accent-alt.with-alpha(0.5);
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent-alt;
            }
        }
        Text {
            text: root.text;
            color: Theme.accent-alt;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

/// `.card-head`: pixel title (+ optional badge) and muted description on the
/// left, slot on the right.
export component CardHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> desc;
    /// Optional warn badge next to the title ("" = none).
    in property <string> badge;
    spacing: 16px;
    VerticalLayout {
        spacing: 4px;
        horizontal-stretch: 1;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: root.title;
                color: Theme.title-color;
                font-family: Theme.font-title;
                font-size: Theme.pix(16px);
                font-weight: 700;
                line-height-factor: 1.25;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.badge != "": VerticalLayout {
                alignment: center;
                WarnBadge { text: root.badge; }
            }
        }
        if root.desc != "": Text {
            text: root.desc;
            color: Theme.muted;
            font-size: 13.2px;
            line-height-factor: 1.09;
            wrap: word-wrap;
        }
    }
    @children
}

/// `.section-header`: h2 in the pixel font (24px, title colour) + muted description.
export component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> desc;
    spacing: 4px;
    horizontal-stretch: 1;
    McTitle {
        text: root.title;
        font-size: 24px;
    }
    if root.desc != "": Text {
        text: root.desc;
        color: Theme.muted;
        font-size: 13.6px;
        line-height-factor: 1.25;
        wrap: word-wrap;
    }
}

/// Tinted rectangle with an icon + wrapped text (explainer box, probe banner, error banners).
export component InfoBox inherits Rectangle {
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    in property <string> text;
    in property <string> icon;
    in property <color> icon-color: Theme.accent-cyan;
    in property <color> text-color: Theme.muted;
    in property <length> font-size: 12.8px;
    in property <length> pad-x: 16px;
    in property <length> pad-y: 12px;
    in property <bool> top-icon: true;
    border-radius: Theme.radius-md;
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: Theme.border-solid;
    inner := HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        spacing: 12px;
        VerticalLayout {
            padding-top: root.pad-y + (root.top-icon ? 1.6px : 0px);
            padding-bottom: root.pad-y;
            alignment: root.top-icon ? start : center;
            Icon { data: root.icon; size: 16px; color: root.icon-color; }
        }
        VerticalLayout {
            padding-top: root.pad-y;
            padding-bottom: root.pad-y;
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.text;
                color: root.text-color;
                font-size: root.font-size;
                line-height-factor: 1.13;
                wrap: word-wrap;
            }
        }
    }
}

/// The foundation TextField (widgets/field.slint) with `min-h` as the minimum
/// height; `pad-y`, `fill` and `focus-color` come from TextField.
export component SsTextField inherits TextField {
    in property <length> min-h: 36px;
    field-height: root.min-h;
}
