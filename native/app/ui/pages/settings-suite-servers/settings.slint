// ---- data dir + diagnostics ----------------------------------------------------------

component SubfolderChip inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    callback clicked();
    horizontal-stretch: 1;
    preferred-width: 1px;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: ta.has-hover ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { data: root.icon; size: 16px; color: ta.has-hover ? Theme.text : Theme.muted; }
        }
        Text {
            text: root.text;
            font-size: 13.6px;
            font-weight: 500;
            color: ta.has-hover ? Theme.text : Theme.muted;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DataDirCard inherits SettingCard {
    in property <bool> narrow;
    VerticalLayout {
        alignment: start;
        CardHead {
            title: T.tr("dash.data.rootLabel");
            desc: T.tr("dash.data.rootDesc");
        }
        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.card-bg-soft;
            border-width: Theme.hairline;
            border-color: Theme.border-solid;
            HorizontalLayout {
                padding: 16px;
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 1px;
                            Icon { data: Icons.folder; size: 16px; color: Theme.accent; }
                        }
                        SelectableText {
                            horizontal-stretch: 1;
                            text: SettingsBridge.cfg-data-dir != "" ? SettingsBridge.cfg-data-dir : "—";
                            font-family: Theme.font-mono;
                            font-size: 13.6px;
                            color: Theme.text;
                            wrap: char-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn {
                            variant: BtnVariant.ghost;
                            size: BtnSize.sm;
                            icon: SettingsBridge.data-dir-copied ? Icons.check : Icons.copy;
                            text: SettingsBridge.data-dir-copied ? T.tr("dash.data.copied") : T.tr("dash.data.copyPath");
                            clicked => { SettingsBridge.copy-data-dir(); }
                        }
                        Btn {
                            variant: BtnVariant.secondary;
                            size: BtnSize.sm;
                            icon: Icons.external-link;
                            text: T.tr("dash.data.openRoot");
                            clicked => { SettingsBridge.open-data-folder(""); }
                        }
                    }
                }
            }
        }
        // One instance of each chip, positioned by `root.narrow`: a responsive
        // `if` pair would compile a second copy of all three chips for the
        // other branch. Wide geometry mirrors the old `HorizontalLayout`:
        // each cell got its own bounded preferred width (the chips' implicit
        // minimum, since their `preferred-width: 1px` clamps up to the
        // content minimum) plus an equal share of the leftover space, with
        // the rounding remainder absorbed by the last chip — NOT an equal
        // third of the row width.
        chips := Rectangle {
            property <length> gap: 12px;
            property <length> share: (self.width - 2 * self.gap - chip-instances.min-width - chip-logs.min-width - chip-mods.min-width) / 3;
            property <length> row-h: max(chip-instances.preferred-height, max(chip-logs.preferred-height, chip-mods.preferred-height));
            height: root.narrow
                ? chip-instances.preferred-height + self.gap + chip-logs.preferred-height + self.gap + chip-mods.preferred-height
                : self.row-h;
            chip-instances := SubfolderChip {
                icon: SetIcons.briefcase;
                text: T.tr("dash.data.openInstances");
                clicked => { SettingsBridge.open-data-folder("instances"); }
                x: 0px;
                y: 0px;
                width: root.narrow ? chips.width : self.min-width + chips.share;
                height: root.narrow ? self.preferred-height : chips.row-h;
            }
            chip-logs := SubfolderChip {
                icon: SetIcons.file-text;
                text: T.tr("dash.data.openLogs");
                clicked => { SettingsBridge.open-data-folder("logs"); }
                x: root.narrow ? 0px : chip-instances.width + chips.gap;
                y: root.narrow ? chip-instances.preferred-height + chips.gap : 0px;
                width: root.narrow ? chips.width : self.min-width + chips.share;
                height: root.narrow ? self.preferred-height : chips.row-h;
            }
            chip-mods := SubfolderChip {
                icon: Icons.package;
                text: T.tr("dash.data.openMods");
                clicked => { SettingsBridge.open-data-folder("mods"); }
                x: root.narrow ? 0px : chip-instances.width + chips.gap + chip-logs.width + chips.gap;
                y: root.narrow ? chip-instances.preferred-height + chips.gap + chip-logs.preferred-height + chips.gap : 0px;
                width: root.narrow ? chips.width : chips.width - chip-instances.width - chip-logs.width - 2 * chips.gap;
                height: root.narrow ? self.preferred-height : chips.row-h;
            }
        }
    }
}

component HealthRow inherits Rectangle {
