    if root.value != "": SelectableText { text: root.value; font-size: 14px; font-weight: 600; color: Theme.text; line-height-factor: 1.25; wrap: word-wrap; }
}

component JdkCard inherits SettingCard {
    in property <bool> dirty;
    VerticalLayout {
        alignment: start;
        CardHead {
            title: T.tr("dash.jdk.title");
            badge: root.dirty ? T.tr("dash.unsavedBadge") : "";
            desc: T.tr("dash.jdk.desc");
        }
        Field {
            label: T.tr("settings.jdkPath");
            hint: T.tr("settings.jdkPathHint");
            VerticalLayout {
                spacing: 12px;
                SsTextField {
                    text <=> SettingsBridge.jdk;
                    placeholder: T.tr("settings.jdkPlaceholder");
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Btn {
                        variant: root.dirty ? BtnVariant.primary : BtnVariant.secondary;
                        size: BtnSize.sm;
                        loading: SettingsBridge.saving-field == "jdk";
                        text: SettingsBridge.saving-field == "jdk" ? T.tr("common.saving") : T.tr("dash.jdk.saveBtn");
                        clicked => { SettingsBridge.save-jdk(SettingsBridge.jdk); }
                    }
                    Btn {
                        variant: BtnVariant.ghost;
                        size: BtnSize.sm;
                        icon: Icons.play;
                        loading: SettingsBridge.probing;
                        text: SettingsBridge.probing ? T.tr("dash.jdk.testingBtn") : T.tr("dash.jdk.testBtn");
                        clicked => { SettingsBridge.probe-jdk(); }
                    }
                }
            }
            if SettingsBridge.probe-msg != "": VerticalLayout {
                padding-top: 8px;
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: (SettingsBridge.probe-ok ? Theme.accent-green : Theme.accent-red).with-alpha(0.12);
                    border-width: Theme.hairline;
                    border-color: SettingsBridge.probe-ok ? Theme.accent-green : Theme.accent-red;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                data: SettingsBridge.probe-ok ? SetIcons.check-circle : Icons.alert-circle;
                                size: 16px;
                                color: SettingsBridge.probe-ok ? Theme.accent-green : Theme.accent-red;
                            }
                        }
                        SelectableText {
                            horizontal-stretch: 1;
                            text: SettingsBridge.probe-msg;
                            font-size: 13.6px;
                            color: SettingsBridge.probe-ok ? Theme.accent-green : Theme.accent-red;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if SettingsBridge.probe-ok && SettingsBridge.jvm-version != "": VerticalLayout {
                padding-top: 12px;
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.card-bg-soft;
                    border-width: Theme.hairline;
                    border-color: Theme.border-solid;
                    HorizontalLayout {
                        padding: 16px;
                        VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 12px;
                                JvmKv { key: T.tr("dash.jdk.versionLabel"); value: SettingsBridge.jvm-version; }
                                JvmKv { key: T.tr("dash.jdk.vendorLabel"); value: SettingsBridge.jvm-vendor; }
                                JvmKv {
                                    key: T.tr("dash.jdk.sourceLabel");
                                    HorizontalLayout {
                                        alignment: start;
                                        Badge { text: SettingsBridge.jvm-source; variant: BadgeVariant.accent; }
                                    }
                                }
                            }
                            JvmKv {
                                key: T.tr("dash.jdk.pathLabel");
                                HorizontalLayout {
                                    alignment: start;
                                    Rectangle {
                                        border-radius: Theme.radius-sm;
                                        background: Theme.log-bg;
                                        border-width: Theme.hairline;
                                        border-color: Theme.border-solid;
                                        min-width: 0;
                                        horizontal-stretch: 1;
                                        max-width: path-text.preferred-width + 20px;
                                        HorizontalLayout {
                                            padding-left: 9.6px;
                                            padding-right: 9.6px;
                                            padding-top: 5.6px;
                                            padding-bottom: 5.6px;
                                            path-text := SelectableText {
                                                text: SettingsBridge.jvm-path;
                                                font-family: Theme.font-mono;
                                                font-size: 12.8px;
                                                color: Theme.text;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---- feature toggles ----------------------------------------------------------------

component ToggleCard inherits GlassCard {
    in property <string> badge;
    in property <BadgeVariant> badge-variant: BadgeVariant.accent;
    in property <string> speedup;
    in property <string> heading;
    in property <string> desc;
    in-out property <bool> checked;
    in property <bool> busy;
    callback toggled(bool);
    min-width: 0px;
    elevation: Elevation.md;
    spacing: 0px;
    padding-size: 20px;
    preferred-width: 1px;
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: 16px;
        alignment: stretch;
        VerticalLayout {
            spacing: 6.4px;
            horizontal-stretch: 1;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Badge { text: root.badge; variant: root.badge-variant; }
                if root.speedup != "": Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    wrap: word-wrap;
                    text: root.speedup;
                    font-size: Theme.text-xs;
                    font-weight: 600;
                    line-height-factor: 1.25;
                    color: Theme.accent;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.heading;
                font-family: Theme.font-title;
                font-size: Theme.text-base;
                font-weight: 700;
                line-height-factor: 1.1;
                color: Theme.title-color;
                wrap: word-wrap;
            }
            Text {
                text: root.desc;
                font-family: Theme.font-body;
                font-size: 12.8px;
                color: Theme.muted;
                line-height-factor: 1.09;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            Toggle {
                checked <=> root.checked;
                enabled: !root.busy;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

component AotCard inherits ToggleCard {
    badge: T.tr("dash.aot.badge");
    badge-variant: BadgeVariant.purple;
    speedup: T.tr("dash.aot.speedup");
