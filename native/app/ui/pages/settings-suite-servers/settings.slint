component AboutCard inherits Rectangle {
    in property <bool> narrow;
    border-radius: Theme.radius-lg;
    background: Theme.card-bg;
    border-width: Theme.hairline;
    border-color: Theme.glass-border;
    clip: true;
    GlassSheen {
        width: 100%;
        height: 100%;
        radius: Theme.radius-lg;
    }
    // grid-template-columns: 1.2fr 1fr, positioned by hand (a layout would
    // measure the wrapped texts at their preferred width)
    property <length> inner: root.width - 64px;
    property <length> lw: root.narrow ? root.inner : (root.inner - 24px) * 1.2 / 2.2;
    property <length> bw: root.narrow ? root.inner : root.inner - root.lw - 24px;
    height: root.narrow ? left.preferred-height + 24px + banner.preferred-height + 64px : max(left.preferred-height, banner.preferred-height) + 64px;
    left := AboutLeft {
        x: 32px;
        y: 32px;
        width: root.lw;
        height: self.preferred-height;
    }
    banner := VipBanner {
        x: root.narrow ? 32px : 32px + root.lw + 24px;
        width: root.bw;
        height: self.preferred-height;
        y: root.narrow ? 32px + left.preferred-height + 24px : (root.height - self.height) / 2;
    }
}

// ---- agent access (MCP) ----------------------------------------------------------------------
//
// Port of SettingsDashboard.svelte "SECTION 4: AGENT ACCESS (MCP)": toggle +
// safety rules + token rotation, MCP snippets (JSON / TOML) with copy buttons,
// allowlist editor. State lives on SettingsBridge (`agent-*`), the engine calls
// in src/pages/settings_suite_servers/agent.rs.

/// `.section-header` with the "ACTIVO" badge on the right (Svelte has no
/// badge slot in SectionHeader, so this is the local variant with its metrics).
component AgentHeader inherits HorizontalLayout {
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            McTitle {
                text: T.tr("dash.agent.title");
                font-size: 24px;
            }
        }
        Text {
            text: T.tr("dash.agent.subtitle");
            font-family: Theme.font-body;
            color: Theme.muted;
            font-size: 13.6px;
            line-height-factor: 1.25;
            wrap: word-wrap;
        }
    }
    // `.section-header { align-items: center }`
    if SettingsBridge.agent-active: VerticalLayout {
        alignment: center;
        Badge { text: T.tr("dash.agent.enabledBadge"); variant: BadgeVariant.ok; dot: true; }
    }
}

/// `.agent-host-chip` (mono `code` chip; `blocked` = never-allowlisted host).
component HostChip inherits Rectangle {
    in property <string> text;
    in property <bool> blocked: false;
    height: row.preferred-height;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: blocked ? Theme.accent-red.with-alpha(0.6) : Theme.border-solid;
    row := HorizontalLayout {
        padding-left: 7.2px;
        padding-right: 7.2px;
        padding-top: 3.2px;
        padding-bottom: 3.2px;
        SelectableText {
            text: root.text;
            font-family: Theme.font-mono;
            font-size: 11.5px;
            color: root.blocked ? Theme.accent-red : Theme.text;
            vertical-alignment: center;
        }
    }
}

/// One safety rule (`<li>`; the Svelte list is a flex column with bullets).
component RuleItem inherits HorizontalLayout {
    in property <string> text;
    spacing: 8px;
    alignment: start;
    padding-left: 6.4px;
    Text {
        text: "•";
        color: Theme.muted;
        font-size: 12.8px;
        line-height-factor: 1.13;
        vertical-alignment: top;
    }
    Text {
        horizontal-stretch: 1;
        min-width: 0px;
        text: root.text;
        font-family: Theme.font-body;
        color: Theme.muted;
        font-size: 12.8px;
        line-height-factor: 1.13;
        wrap: word-wrap;
    }
}

/// `.agent-config-block`: mono label + copy button + the `<pre>` snippet.
component AgentConfigBlock inherits VerticalLayout {
    in property <string> label;
    in property <string> code;
    in property <string> copy-label;
    in property <bool> copied;
    callback copy();
    spacing: 8px;
    HorizontalLayout {
        spacing: 12px;
        SelectableText {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.label;
            font-family: Theme.font-mono;
            font-size: 11.5px;
            color: Theme.muted;
            vertical-alignment: center;
        }
        Btn {
            variant: BtnVariant.ghost;
            size: BtnSize.sm;
            icon: root.copied ? Icons.check : Icons.copy;
            text: root.copied ? T.tr("dash.agent.copied") : root.copy-label;
            clicked => { root.copy(); }
        }
    }
    // `.agent-config-code`: --log-bg, `white-space: pre`, max-height 15rem,
    // overflow-x: auto -> no wrapping, scroll both ways.
    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.log-bg;
        border-width: Theme.hairline;
        border-color: Theme.border-solid;
        height: min(240px, code-text.preferred-height + 24px);
        clip: true;
        flick := Flickable {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: parent.height - 24px;
            content-width: max(flick.width, code-text.preferred-width);
            content-height: code-text.preferred-height;
            code-text := SelectableText {
                single-line: false;
                x: 0;
                y: 0;
                width: self.preferred-width;
                height: self.preferred-height;
                text: root.code;
                color: Theme.text;
                font-family: Theme.font-mono;
                font-size: 11.5px;
                line-height-factor: 1.17;
                wrap: no-wrap;
            }
        }
    }
}

/// One allowlist row (`.agent-allow-item`) with its remove button.
component AgentAllowRow inherits Rectangle {
    in property <string> host;
    border-radius: Theme.radius-md;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: Theme.border-solid;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 7.2px;
        padding-bottom: 7.2px;
        spacing: 12px;
        SelectableText {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.host;
            font-family: Theme.font-mono;
            font-size: 12.8px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: rm-touch.has-hover ? Theme.accent-red.with-alpha(0.12) : transparent;
            Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "✕";
                font-size: 12.8px;
                color: rm-touch.has-hover ? Theme.accent-red : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            rm-touch := TouchArea {
                enabled: !SettingsBridge.agent-allow-saving;
                mouse-cursor: pointer;
                // the Svelte aria-label / title = t('dash.agent.allowRemove', { host })
                accessible-role: AccessibleRole.button;
                accessible-label: T.tr1("dash.agent.allowRemove", "host", root.host);
                clicked => { SettingsBridge.agent-allow-remove(root.host); }
            }
        }
    }
}

/// Card 1: master toggle, safety rules, token path + rotation (with confirm).
component AgentToggleCard inherits SettingCard {
    in-out property <bool> checked;
    VerticalLayout {
        spacing: 20px;
        CardHead {
            title: T.tr("dash.agent.toggleTitle");
            desc: T.tr("dash.agent.toggleDesc");
            VerticalLayout {
                alignment: start;
                Toggle {
                    checked <=> root.checked;
                    enabled: SettingsBridge.agent-loaded && !SettingsBridge.agent-saving;
                    toggled(v) => { SettingsBridge.agent-set-enabled(v); }
                }
            }
        }
        InfoBox { text: T.tr("dash.agent.rulesTitle"); icon: Icons.shield; }
        VerticalLayout {
            spacing: 6.4px;
            RuleItem { text: T.tr("dash.agent.ruleEspectral"); }
            RuleItem { text: T.tr("dash.agent.ruleF8"); }
            RuleItem { text: T.tr("dash.agent.ruleLocal"); }
        }
        // `.agent-token-block`: border-top + 1rem padding, 0.6rem gaps
        VerticalLayout {
            spacing: 0px;
            Rectangle { height: Theme.hairline; background: Theme.border-solid; }
            VerticalLayout {
                padding-top: 16px;
                spacing: 9.6px;
                VerticalLayout {
                    spacing: 2.4px;
                    Text {
                        text: T.tr("dash.agent.tokenTitle");
                        font-family: Theme.font-body;
                        font-size: 15.2px;
                        font-weight: 600;
                        color: Theme.text;
                        line-height-factor: 1.25;
                    }
                    Text {
                        text: T.tr("dash.agent.tokenDesc");
                        font-family: Theme.font-body;
                        font-size: 12.5px;
                        color: Theme.muted;
                        line-height-factor: 1.13;
                        wrap: word-wrap;
                    }
                }
                if SettingsBridge.agent-token-path != "": Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.card-bg-soft;
                    border-width: Theme.hairline;
                    border-color: Theme.border-solid;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 12px;
                        Text {
                            text: T.tr("dash.agent.tokenPath");
                            font-family: Theme.font-body;
                            font-size: 13.6px;
                            color: Theme.muted;
                            line-height-factor: 1.25;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            height: path-text.preferred-height + 11.2px;
                            border-radius: Theme.radius-sm;
                            background: Theme.log-bg;
                            border-width: Theme.hairline;
                            border-color: Theme.border-solid;
                            clip: true;
                            path-text := SelectableText {
                                x: 9.6px;
                                y: 5.6px;
                                width: parent.width - 19.2px;
                                text: SettingsBridge.agent-token-path;
                                font-family: Theme.font-mono;
                                font-size: 11.5px;
                                color: Theme.text;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    if SettingsBridge.agent-confirming-rotate: Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: T.tr("dash.agent.rotateConfirm");
                        font-family: Theme.font-body;
                        font-size: 12.8px;
                        color: Theme.text;
                        line-height-factor: 1.13;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if SettingsBridge.agent-confirming-rotate: VerticalLayout {
                        alignment: center;
                        Btn {
                            variant: BtnVariant.danger;
                            size: BtnSize.sm;
                            loading: SettingsBridge.agent-rotating;
                            enabled: !SettingsBridge.agent-rotating;
                            text: T.tr("dash.agent.rotateConfirmYes");
                            clicked => { SettingsBridge.agent-rotate(); }
                        }
                    }
                    if SettingsBridge.agent-confirming-rotate: VerticalLayout {
                        alignment: center;
                        Btn {
                            variant: BtnVariant.ghost;
                            size: BtnSize.sm;
                            enabled: !SettingsBridge.agent-rotating;
                            text: T.tr("dash.agent.rotateCancel");
                            clicked => { SettingsBridge.agent-confirming-rotate = false; }
                        }
                    }
                    if !SettingsBridge.agent-confirming-rotate: VerticalLayout {
                        alignment: center;
                        Btn {
                            variant: BtnVariant.secondary;
                            size: BtnSize.sm;
                            text: T.tr("dash.agent.rotate");
                            clicked => { SettingsBridge.agent-confirming-rotate = true; }
                        }
                    }
                }
            }
        }
    }
}

/// Card 2: MCP configuration snippets (JSON for Claude Code / Cursor, TOML for
/// Codex) with copy buttons, or the empty state while the agent is disabled.
component AgentConfigCard inherits SettingCard {
    VerticalLayout {
        spacing: 20px;
        CardHead {
            title: T.tr("dash.agent.configTitle");
            desc: T.tr("dash.agent.configDesc");
        }
        if SettingsBridge.agent-active && SettingsBridge.agent-json != "": VerticalLayout {
            spacing: 20px;
            AgentConfigBlock {
                label: "mcpServers.espectral";
                code: SettingsBridge.agent-json;
                copy-label: T.tr("dash.agent.copyJson");
                copied: SettingsBridge.agent-json-copied;
                copy => { SettingsBridge.agent-copy("json"); }
            }
            AgentConfigBlock {
                label: "~/.codex/config.toml";
                code: SettingsBridge.agent-toml;
                copy-label: T.tr("dash.agent.copyToml");
                copied: SettingsBridge.agent-toml-copied;
                copy => { SettingsBridge.agent-copy("toml"); }
            }
        }
        if !SettingsBridge.agent-active || SettingsBridge.agent-json == "": Text {
            text: T.tr("dash.agent.configEmpty");
            font-family: Theme.font-body;
            font-size: 12.8px;
            color: Theme.muted;
            line-height-factor: 1.25;
            wrap: word-wrap;
        }
    }
}

/// Card 3: allowed-servers editor (add / remove / save the draft).
component AgentAllowCard inherits SettingCard {
    VerticalLayout {
        spacing: 20px;
        CardHead {
            title: T.tr("dash.agent.allowTitle");
            desc: T.tr("dash.agent.allowDesc");
        }
        // `.agent-always-row` wraps in CSS; split in two rows (Slint has no
        // wrapping layout) so the Spanish labels still fit at 1/3 width.
        VerticalLayout {
            spacing: 6.4px;
            HorizontalLayout {
                spacing: 6.4px;
                alignment: start;
                Badge { text: T.tr("dash.agent.allowAlways"); variant: BadgeVariant.ok; }
                HostChip { text: "singleplayer"; }
                HostChip { text: "localhost"; }
            }
            HorizontalLayout {
                spacing: 6.4px;
                alignment: start;
                Badge { text: T.tr("dash.agent.allowNever"); variant: BadgeVariant.err; }
                HostChip { text: "*.uhce.top"; blocked: true; }
                HostChip { text: "*.espectral.es"; blocked: true; }
            }
        }
        HorizontalLayout {
            spacing: 9.6px;
            SsTextField {
                text <=> SettingsBridge.agent-allow-input;
                placeholder: T.tr("dash.agent.allowPlaceholder");
                enabled: !SettingsBridge.agent-allow-saving;
                min-h: 32px;
                pad-y: 6.4px;
                accepted => { SettingsBridge.agent-allow-add(); }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    variant: BtnVariant.secondary;
                    size: BtnSize.sm;
                    enabled: !SettingsBridge.agent-allow-saving;
                    text: T.tr("dash.agent.allowAdd");
                    clicked => { SettingsBridge.agent-allow-add(); }
                }
            }
        }
        if SettingsBridge.agent-allow-error != "": SelectableText {
            text: SettingsBridge.agent-allow-error;
            font-size: 12.5px;
            color: Theme.accent-red;
            line-height-factor: 1.25;
            wrap: word-wrap;
        }
        VerticalLayout {
            spacing: 6.4px;
            for h in SettingsBridge.agent-allow-list: AgentAllowRow { host: h; }
            if SettingsBridge.agent-allow-list.length == 0: Text {
                text: T.tr("dash.agent.allowEmpty");
                font-family: Theme.font-body;
                font-size: 12.8px;
                color: Theme.muted;
                line-height-factor: 1.25;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            padding-top: 4px;
            Rectangle { horizontal-stretch: 1; min-width: 0px; }
            Btn {
                variant: BtnVariant.secondary;
                size: BtnSize.sm;
                loading: SettingsBridge.agent-allow-saving;
                enabled: !SettingsBridge.agent-allow-saving && SettingsBridge.agent-allow-dirty;
                text: T.tr("dash.agent.allowSave");
                clicked => { SettingsBridge.agent-allow-save(); }
            }
        }
    }
}

component AgentSection inherits VerticalLayout {
    in property <bool> narrow;
    spacing: 16px;
    AgentHeader { }
    // `.agent-grid`: 3 columns at >= 1100px, `align-items: start`. One
    // instance of each card, positioned by `root.narrow` (a responsive `if`
    // pair would compile a second component tree): wide cards keep their
    // natural height and their row is as tall as the tallest card.
    agent-grid := Rectangle {
        property <length> gap: 20px;
        property <length> col-w: (self.width - 2 * self.gap) / 3;
        property <length> row-h: max(agent-toggle-card.preferred-height, max(agent-config-card.preferred-height, agent-allow-card.preferred-height));
        height: root.narrow
            ? agent-toggle-card.preferred-height + self.gap + agent-config-card.preferred-height + self.gap + agent-allow-card.preferred-height
            : self.row-h;
        agent-toggle-card := AgentToggleCard {
            checked <=> SettingsBridge.agent-enabled;
            x: 0px;
            y: 0px;
            width: root.narrow ? agent-grid.width : agent-grid.col-w;
            height: self.preferred-height;
        }
        agent-config-card := AgentConfigCard {
            x: root.narrow ? 0px : agent-grid.col-w + agent-grid.gap;
            y: root.narrow ? agent-toggle-card.preferred-height + agent-grid.gap : 0px;
            width: root.narrow ? agent-grid.width : agent-grid.col-w;
            height: self.preferred-height;
        }
        agent-allow-card := AgentAllowCard {
            x: root.narrow ? 0px : 2 * (agent-grid.col-w + agent-grid.gap);
            y: root.narrow ? agent-toggle-card.preferred-height + agent-grid.gap + agent-config-card.preferred-height + agent-grid.gap : 0px;
            width: root.narrow ? agent-grid.width : agent-grid.col-w;
            height: self.preferred-height;
        }
    }
}

// ---- page ------------------------------------------------------------------------------------

export component SettingsPage inherits Rectangle {
    /// CSS @media (max-width: 1100px): every grid collapses to one column.
    property <bool> narrow: root.width < 1100px;
    /// memory number input holds something that is not an integer.
    property <bool> mem-text-bad: false;
    property <int> mem: round(SettingsBridge.memory);
    property <string> memory-error: (root.mem-text-bad || root.mem < 512 || root.mem > 65536) ? T.tr("settings.memory.invalid") : "";
    property <bool> memory-dirty: SettingsBridge.cfg-loaded && root.mem != SettingsBridge.cfg-memory && root.memory-error == "";
    property <bool> concurrency-dirty: SettingsBridge.cfg-loaded && round(SettingsBridge.concurrency) != SettingsBridge.cfg-concurrency;
    property <bool> jdk-dirty: SettingsBridge.cfg-loaded && SettingsBridge.jdk != SettingsBridge.cfg-jdk;
    property <bool> any-dirty: root.memory-dirty || root.concurrency-dirty || root.jdk-dirty || (SettingsBridge.cfg-loaded && (SettingsBridge.aot != SettingsBridge.cfg-aot || SettingsBridge.fastboot != SettingsBridge.cfg-fastboot || SettingsBridge.discord != SettingsBridge.cfg-discord));
    /// Settings behind the disclosure that differ from their defaults.
    property <int> advanced-changed: (SettingsBridge.cfg-concurrency != 6 ? 1 : 0) + (SettingsBridge.cfg-jdk != "" ? 1 : 0) + (!SettingsBridge.cfg-aot ? 1 : 0) + (SettingsBridge.cfg-fastboot ? 1 : 0) + (SettingsBridge.agent-enabled ? 1 : 0);

    PageScaffold {
        max-content-width: 1400px;
        content-padding: root.width < 768px ? 16px : 40px;
        content-padding-top: root.width < 768px ? 20px : 30px;
        content-padding-bottom: 64px;
        spacing: 28px;

        Hero { any-dirty: root.any-dirty; memory-invalid: root.memory-error != ""; }

        if SettingsBridge.cfg-error != "": Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.accent-red.with-alpha(0.12);
            border-width: Theme.hairline;
            border-color: Theme.accent-red.with-alpha(0.6);
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    Icon { data: Icons.alert-circle; size: 20px; color: Theme.accent-red; }
                }
                SelectableText {
                    horizontal-stretch: 1;
                    text: T.tr("dash.saveError") + ": " + SettingsBridge.cfg-error;
                    font-size: 14px;
                    color: Theme.accent-red;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        variant: BtnVariant.secondary;
                        size: BtnSize.sm;
                        text: T.tr("actions.retry");
                        clicked => { SettingsBridge.settings-reload(); }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 36px;

            // SECTION 1: appearance & language
            VerticalLayout {
                spacing: 16px;
                SectionHeader { title: T.tr("dash.appearance.title"); desc: T.tr("dash.appearance.subtitle"); }
                // One instance of each card, positioned by `root.narrow`: two
                // cards per row wide, one column narrow. An `if` pair would
                // compile four extra component trees.
                appearance-grid := Rectangle {
                    property <length> gap: 20px;
                    property <length> col-w: (self.width - self.gap) / 2;
                    property <length> row1-h: max(theme-card.preferred-height, language-card.preferred-height);
                    property <length> row2-h: max(accent-card.preferred-height, backdrop-card.preferred-height);
                    height: root.narrow
                        ? theme-card.preferred-height + self.gap + language-card.preferred-height + self.gap + accent-card.preferred-height + self.gap + backdrop-card.preferred-height
                        : self.row1-h + self.gap + self.row2-h;
                    theme-card := ThemeCard {
                        x: 0px;
                        y: 0px;
                        width: root.narrow ? appearance-grid.width : appearance-grid.col-w;
                        height: root.narrow ? self.preferred-height : appearance-grid.row1-h;
                    }
                    language-card := LanguageCard {
                        x: root.narrow ? 0px : appearance-grid.col-w + appearance-grid.gap;
                        y: root.narrow ? theme-card.preferred-height + appearance-grid.gap : 0px;
                        width: root.narrow ? appearance-grid.width : appearance-grid.width - appearance-grid.col-w - appearance-grid.gap;
                        height: root.narrow ? self.preferred-height : appearance-grid.row1-h;
                    }
                    accent-card := AccentCard {
                        x: 0px;
                        y: root.narrow ? theme-card.preferred-height + appearance-grid.gap + language-card.preferred-height + appearance-grid.gap : appearance-grid.row1-h + appearance-grid.gap;
                        width: root.narrow ? appearance-grid.width : appearance-grid.col-w;
                        height: root.narrow ? self.preferred-height : appearance-grid.row2-h;
                    }
                    backdrop-card := BackdropCard {
                        x: root.narrow ? 0px : appearance-grid.col-w + appearance-grid.gap;
                        y: root.narrow ? theme-card.preferred-height + appearance-grid.gap + language-card.preferred-height + appearance-grid.gap + accent-card.preferred-height + appearance-grid.gap : appearance-grid.row1-h + appearance-grid.gap;
                        width: root.narrow ? appearance-grid.width : appearance-grid.width - appearance-grid.col-w - appearance-grid.gap;
                        height: root.narrow ? self.preferred-height : appearance-grid.row2-h;
                    }
                }
            }

            // SECTION 2: game (memory + the player-facing toggles)
            VerticalLayout {
                spacing: 16px;
                SectionHeader { title: T.tr("dash.game.title"); desc: T.tr("dash.game.subtitle"); }
                MemoryCard {
                    dirty: root.memory-dirty;
                    error: root.memory-error;
                    text-edited(t) => {
                        if t.is-float() && round(t.to-float()) == t.to-float() {
                            root.mem-text-bad = false;
                            SettingsBridge.memory = t.to-float();
                        } else {
                            root.mem-text-bad = true;
                        }
                    }
                }
                // One instance of each toggle, positioned by `root.narrow`.
                game-toggles := Rectangle {
                    property <length> gap: 20px;
                    property <length> col-w: (self.width - self.gap) / 2;
                    property <length> row-h: max(close-on-start-card.preferred-height, discord-card.preferred-height);
                    height: root.narrow
                        ? close-on-start-card.preferred-height + self.gap + discord-card.preferred-height
                        : self.row-h;
                    close-on-start-card := CloseOnStartCard {
                        x: 0px;
                        y: 0px;
                        width: root.narrow ? game-toggles.width : game-toggles.col-w;
                        height: root.narrow ? self.preferred-height : game-toggles.row-h;
                    }
                    discord-card := DiscordCard {
                        x: root.narrow ? 0px : game-toggles.col-w + game-toggles.gap;
                        y: root.narrow ? close-on-start-card.preferred-height + game-toggles.gap : 0px;
                        width: root.narrow ? game-toggles.width : game-toggles.width - game-toggles.col-w - game-toggles.gap;
                        height: root.narrow ? self.preferred-height : game-toggles.row-h;
                    }
                }
            }

            // SECTION 3: the shared "Opciones avanzadas" disclosure
            VerticalLayout {
                spacing: 16px;
                AdvancedToggle { summary: T.tr("settings.advancedSummary"); changed: root.advanced-changed; }
                if Shell.show-advanced: VerticalLayout {
                    spacing: 36px;

                    // downloads, Java & startup
                    VerticalLayout {
                        spacing: 16px;
                        SectionHeader { title: T.tr("dash.engine.title"); desc: T.tr("dash.engine.subtitle"); }
                        DownloadsCard { dirty: root.concurrency-dirty; }
                        JdkCard { dirty: root.jdk-dirty; }
                        // One instance of each toggle plus the trailing spacer:
                        // the wide row keeps a third, empty column.
                        startup-toggles := Rectangle {
                            property <length> gap: 20px;
                            property <length> col-w: (self.width - 2 * self.gap) / 3;
                            property <length> row-h: max(aot-card.preferred-height, fastboot-card.preferred-height);
                            height: root.narrow
                                ? aot-card.preferred-height + self.gap + fastboot-card.preferred-height
                                : self.row-h;
                            aot-card := AotCard {
                                x: 0px;
                                y: 0px;
                                width: root.narrow ? startup-toggles.width : startup-toggles.col-w;
                                height: root.narrow ? self.preferred-height : startup-toggles.row-h;
                            }
                            fastboot-card := FastBootCard {
                                x: root.narrow ? 0px : startup-toggles.col-w + startup-toggles.gap;
                                y: root.narrow ? aot-card.preferred-height + startup-toggles.gap : 0px;
                                width: root.narrow ? startup-toggles.width : startup-toggles.col-w;
                                height: root.narrow ? self.preferred-height : startup-toggles.row-h;
                            }
                            Rectangle {
                                x: root.narrow ? 0px : 2 * (startup-toggles.col-w + startup-toggles.gap);
                                y: 0px;
                                width: root.narrow ? 0px : startup-toggles.col-w;
                                height: root.narrow ? 0px : startup-toggles.row-h;
                            }
                        }
                    }

                    // agent access (MCP)
                    AgentSection { narrow: root.narrow; }

                    // folders & diagnostics
                    VerticalLayout {
                        spacing: 16px;
                        SectionHeader { title: T.tr("dash.data.title"); desc: T.tr("dash.data.subtitle"); }
                        // One instance of each card, positioned by `root.narrow`.
                        diagnostics-grid := Rectangle {
                            property <length> gap: 20px;
                            property <length> col-w: (self.width - self.gap) / 2;
                            property <length> row-h: max(data-dir-card.preferred-height, health-card.preferred-height);
                            height: root.narrow
                                ? data-dir-card.preferred-height + self.gap + health-card.preferred-height
                                : self.row-h;
                            data-dir-card := DataDirCard {
                                narrow: root.width < 768px;
                                x: 0px;
                                y: 0px;
                                width: root.narrow ? diagnostics-grid.width : diagnostics-grid.col-w;
                                height: root.narrow ? self.preferred-height : diagnostics-grid.row-h;
                            }
                            health-card := HealthCard {
                                x: root.narrow ? 0px : diagnostics-grid.col-w + diagnostics-grid.gap;
                                y: root.narrow ? data-dir-card.preferred-height + diagnostics-grid.gap : 0px;
                                width: root.narrow ? diagnostics-grid.width : diagnostics-grid.width - diagnostics-grid.col-w - diagnostics-grid.gap;
                                height: root.narrow ? self.preferred-height : diagnostics-grid.row-h;
                            }
                        }
                    }
                }
            }

            // SECTION 6: about + donations bridge
            AboutCard { narrow: root.narrow; }
        }
    }
}
