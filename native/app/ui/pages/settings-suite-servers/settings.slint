// OWNER: settings-suite-servers agent. Port of src/ui/src/pages/SettingsDashboard.svelte.
// Keep the exported component name and the empty interface used by app.slint.
//
// Sections: hero (+ dirty dock), appearance (theme / language / accent +
// reduced motion), game (memory + player-facing toggles), the shared
// "Opciones avanzadas" disclosure (downloads / JDK / AOT + fast boot / agent
// access / data directory + diagnostics), about.
import { Theme, T, Router, AppState, Shell, GlassCard, Elevation, Btn, BtnVariant, BtnSize, Badge, BadgeVariant, McTitle, Field, Slider, Segmented, Toggle, Icon, Icons, Emoji, PageScaffold, AdvancedToggle, SelectableText } from "../../widgets.slint";
import { Backdrop, BackdropItem } from "../../state.slint";
import { ThemeToggle } from "../../shell/top-chrome.slint";
import { GlassSheen } from "../../widgets/card.slint";
import { SettingsBridge } from "api.slint";
import { PresetChip, CardHead, SectionHeader, InfoBox, SsTextField } from "parts.slint";

// ---- local icons (feather) ---------------------------------------------------
global SetIcons {
    out property <string> save: "M 19 21 L 5 21 A 2 2 0 0 1 3 19 L 3 5 A 2 2 0 0 1 5 3 L 16 3 L 21 8 L 21 19 A 2 2 0 0 1 19 21 Z M 17 21 L 17 13 L 7 13 L 7 21 M 7 3 L 7 8 L 15 8";
    out property <string> check-circle: "M 22 11.08 L 22 12 A 10 10 0 1 1 16.07 2.86 M 22 4 L 12 14.01 L 9 11.01";
    out property <string> rotate: "M 21.5 2 L 21.5 8 L 15.5 8 M 21.34 15.57 A 10 10 0 1 1 20.77 7.19 L 26.44 1.52";
    out property <string> briefcase: "M 4 7 L 20 7 A 2 2 0 0 1 22 9 L 22 19 A 2 2 0 0 1 20 21 L 4 21 A 2 2 0 0 1 2 19 L 2 9 A 2 2 0 0 1 4 7 Z M 16 21 L 16 5 A 2 2 0 0 0 14 3 L 10 3 A 2 2 0 0 0 8 5 L 8 21";
    out property <string> file-text: "M 14 2 L 6 2 A 2 2 0 0 0 4 4 L 4 20 A 2 2 0 0 0 6 22 L 18 22 A 2 2 0 0 0 20 20 L 20 8 Z M 14 2 L 14 8 L 20 8 M 16 13 L 8 13 M 16 17 L 8 17 M 10 9 L 8 9";
    /// lucide "sparkles" (the glass-mode tile's icon)
    out property <string> sparkles: "M 12 3 L 13.4 8.6 L 19 10 L 13.4 11.4 L 12 17 L 10.6 11.4 L 5 10 L 10.6 8.6 Z M 19 15 L 19.7 17.3 L 22 18 L 19.7 18.7 L 19 21 L 18.3 18.7 L 16 18 L 18.3 17.3 Z M 5 3 L 5.7 5.3 L 8 6 L 5.7 6.7 L 5 9 L 4.3 6.7 L 2 6 L 4.3 5.3 Z";
}

// ---- hero ----------------------------------------------------------------------

component DirtyDock inherits Rectangle {
    in property <bool> memory-invalid;
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: Theme.hairline;
    border-color: Theme.edge-strong;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Badge { text: T.tr("dash.unsavedBadge"); variant: BadgeVariant.warn; dot: true; large: true; }
        }
        Btn {
            variant: BtnVariant.primary;
            size: BtnSize.md;
            icon: SetIcons.save;
            loading: SettingsBridge.saving-all;
            enabled: !root.memory-invalid;
            text: SettingsBridge.saving-all ? T.tr("dash.savingAll") : T.tr("dash.saveAll");
            clicked => { SettingsBridge.save-all(); }
        }
        Btn {
            variant: BtnVariant.ghost;
            size: BtnSize.md;
            text: T.tr("dash.resetField");
            clicked => { SettingsBridge.reset-all(); }
        }
    }
}

component Hero inherits VerticalLayout {
    in property <bool> any-dirty;
    in property <bool> memory-invalid;
    spacing: 0px;
    HorizontalLayout {
        spacing: 24px;
        padding-bottom: 20px;
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            McTitle {
                text: T.tr("dash.title");
                font-size: 32px;
            }
            HorizontalLayout {
                alignment: start;
                Text {
                    max-width: 650px;
                    text: T.tr("dash.subtitle");
                    font-family: Theme.font-body;
                    color: Theme.muted;
                    font-size: 15.2px;
                    line-height-factor: 1.17;
                    wrap: word-wrap;
                }
            }
        }
        if root.any-dirty: VerticalLayout {
            alignment: start;
            DirtyDock { memory-invalid: root.memory-invalid; }
        }
    }
    Rectangle { height: Theme.hairline; background: Theme.border-solid; }
}

// ---- appearance ------------------------------------------------------------------

component ThemeChoice inherits Rectangle {
    in property <string> mode;
    in property <string> label;
    in property <string> icon;
    property <bool> active: Theme.mode == root.mode;
    height: 76px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 1px;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: active ? Theme.edge-strong : ta.has-hover ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Icon { data: root.icon; size: 18px; color: root.active ? Theme.accent-bright : ta.has-hover ? Theme.text : Theme.muted; }
        }
        Text {
            text: root.label;
            font-size: 13.6px;
            font-weight: 700;
            color: root.active ? Theme.accent-bright : ta.has-hover ? Theme.text : Theme.muted;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Shell.set-theme-mode(root.mode); }
    }
}

/// .theme-preview-stage: a mini window that looks like the glass launcher —
/// charcoal body, a floating pill nav and a "Jugar" accent button.
component ThemePreview inherits Rectangle {
    min-height: 110px;
    preferred-height: 110px;
    border-radius: Theme.radius-md;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: Theme.border-solid;
    clip: true;
    mock := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 110px;
        background: Theme.bg;
        // the three backdrop glows, hinted
        Rectangle {
            x: parent.width * 0.05;
            y: -30px;
            width: 200px;
            height: 90px;
            border-radius: 45px;
            background: Theme.accent.with-alpha(Theme.dark ? 0.16 : 0.10);
        }
        Rectangle {
            x: parent.width * 0.62;
            y: 10px;
            width: 170px;
            height: 80px;
            border-radius: 40px;
            background: Theme.accent-purple.with-alpha(Theme.dark ? 0.10 : 0.06);
        }
        // floating pill nav
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 12px;
            width: 176px;
            height: 20px;
            border-radius: Theme.radius-pill;
            background: Theme.surface;
            border-width: Theme.hairline;
            border-color: Theme.glass-border;
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                Rectangle { width: 26px; height: 4px; border-radius: 2px; background: Theme.accent; }
                Rectangle { width: 22px; height: 4px; border-radius: 2px; background: Theme.muted.with-alpha(0.35); }
                Rectangle { width: 26px; height: 4px; border-radius: 2px; background: Theme.muted.with-alpha(0.35); }
                Rectangle { width: 20px; height: 4px; border-radius: 2px; background: Theme.muted.with-alpha(0.35); }
            }
        }
        // the one solid accent of the view: Jugar
        Rectangle {
            x: 24px;
            y: 52px;
            width: jugar.preferred-width + 28px;
            height: 26px;
            border-radius: Theme.radius-md;
            background: Theme.accent;
            jugar := Text {
                text: (Theme.dark ? "DARK" : "LIGHT") + " MODE";
                font-size: Theme.text-xs;
                font-weight: 700;
                color: Theme.on-gold;
                x: 14px;
                y: 0px;
                height: parent.height;
                vertical-alignment: center;
            }
        }
        // content skeleton
        VerticalLayout {
            x: 24px;
            y: 88px;
            spacing: 6px;
            Rectangle { width: 150px; height: 4px; border-radius: 2px; background: Theme.muted.with-alpha(0.3); }
            Rectangle { width: 96px; height: 4px; border-radius: 2px; background: Theme.muted.with-alpha(0.3); }
        }
    }
}

component SettingCard inherits GlassCard {
    min-width: 0px;
    elevation: Elevation.md;
    spacing: 0px;
    padding-size: 20px;
    preferred-width: 1px;
    horizontal-stretch: 1;
}

component ThemeCard inherits SettingCard {
    VerticalLayout {
        alignment: start;
        CardHead {
            title: T.tr("dash.appearance.themeLabel");
            desc: T.tr("dash.appearance.themeDesc");
            VerticalLayout {
                alignment: start;
                ThemeToggle { }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            ThemeChoice { mode: "dark"; label: T.tr("settings.theme.dark"); icon: Icons.moon; }
            ThemeChoice { mode: "light"; label: T.tr("settings.theme.light"); icon: Icons.sun; }
            ThemeChoice { mode: "system"; label: T.tr("settings.theme.system"); icon: Icons.monitor; }
        }
        InfoBox {
            text: T.tr("dash.appearance.systemDesc");
            icon: Icons.info;
        }
        ThemePreview { }
    }
}

component LangTile inherits Rectangle {
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    in property <string> lang;
    in property <string> flag;
    in property <string> name;
    in property <string> sub;
    in property <string> active-text;
    property <bool> active: T.lang == root.lang;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: active ? Theme.edge-strong : ta.has-hover ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Shell.set-language(root.lang); }
    }
    inner := HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 0px;
        VerticalLayout {
            alignment: center;
            padding-right: 12px;
            Emoji { char: root.flag; size: 24px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2.4px;
            alignment: center;
            Text { text: root.name; font-size: 15.2px; font-weight: 700; color: root.active ? Theme.accent-bright : Theme.text; line-height-factor: 1.25; }
            Text { text: root.sub; font-size: 12px; color: root.active ? Theme.accent-bright : Theme.muted; line-height-factor: 1.25; font-weight: 500; }
        }
        if root.active: VerticalLayout {
            alignment: center;
            Badge { text: root.active-text; variant: BadgeVariant.accent; }
        }
    }
}

component LanguageCard inherits SettingCard {
    VerticalLayout {
        alignment: start;
        CardHead {
            title: T.tr("dash.appearance.langLabel");
            desc: T.tr("dash.appearance.langDesc");
            VerticalLayout {
                alignment: start;
                Segmented {
                    items: ["ES", "EN"];
                    current: T.lang == "es" ? 0 : 1;
                    selected(i) => { Shell.set-language(i == 0 ? "es" : "en"); }
                }
            }
        }
        VerticalLayout {
            spacing: 12px;
            LangTile { lang: "es"; flag: "🇪🇸"; name: "Español"; sub: "Predeterminado (Espectral)"; active-text: "ACTIVO"; }
            LangTile { lang: "en"; flag: "🇬🇧"; name: "English"; sub: "International Standard"; active-text: "ACTIVE"; }
        }
    }
}

component AccentSwatch inherits Rectangle {
    in property <string> id;
    in property <string> label;
    in property <color> swatch;
    property <bool> active: Theme.accent-id == root.id;
    height: row.preferred-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: active ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: active ? Theme.edge-strong : ta.has-hover ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 3px;
                background: root.swatch;
                border-width: Theme.hairline;
                border-color: Theme.border-solid;
            }
        }
        Text {
            text: root.label;
            font-size: 12.8px;
            font-weight: 700;
            color: root.active ? Theme.accent-bright : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Shell.set-accent(root.id); }
    }
}

component AccentCard inherits SettingCard {
    VerticalLayout {
        alignment: start;
        CardHead {
            title: T.tr("dash.accent.title");
            desc: T.tr("dash.accent.desc");
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            AccentSwatch { id: "oro"; label: T.tr("dash.accent.oro"); swatch: #d9a93b; }
            AccentSwatch { id: "carmesi"; label: T.tr("dash.accent.carmesi"); swatch: #e5484d; }
            AccentSwatch { id: "amatista"; label: T.tr("dash.accent.amatista"); swatch: #bb86fc; }
            AccentSwatch { id: "esmeralda"; label: T.tr("dash.accent.esmeralda"); swatch: #10b981; }
            AccentSwatch { id: "glaciar"; label: T.tr("dash.accent.glaciar"); swatch: #38bdf8; }
        }
        // .motion-row (margin-top + border-top)
        VerticalLayout {
            padding-top: 16px;
            Rectangle { height: Theme.hairline; background: Theme.border-solid; }
            HorizontalLayout {
                padding-top: 16px;
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2.4px;
                    alignment: center;
                    Text { text: T.tr("dash.motion.title"); font-family: Theme.font-body; font-size: 15.2px; font-weight: 700; color: Theme.text; line-height-factor: 1.25; }
                    Text {
                        text: T.tr("dash.motion.desc");
                        font-family: Theme.font-body;
                        font-size: 12.5px;
                        color: Theme.muted;
                        line-height-factor: 1.13;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        variant: SettingsBridge.reduced-motion ? BtnVariant.primary : BtnVariant.secondary;
                        size: BtnSize.sm;
                        loading: SettingsBridge.saving-motion;
                        text: SettingsBridge.reduced-motion ? T.tr("dash.motion.on") : T.tr("dash.motion.off");
                        clicked => { SettingsBridge.toggle-reduced-motion(); }
                    }
                }
            }
        }
    }
}
// ---- launcher background (Backdrop) --------------------------------------------

/// Mode tile, same shape as ThemeChoice but bound to Backdrop.mode.
component BackdropChoice inherits Rectangle {
    in property <string> mode;
    in property <string> label;
    in property <string> icon;
    property <bool> active: Backdrop.mode == root.mode;
    height: 76px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 1px;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.surface-up : Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: active ? Theme.edge-strong : ta.has-hover ? Theme.hover-border : Theme.border-solid;
    animate background, border-color { duration: Theme.dur-fast; }
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Icon { data: root.icon; size: 18px; color: root.active ? Theme.accent-bright : ta.has-hover ? Theme.text : Theme.muted; }
        }
        Text {
            text: root.label;
            font-size: 13.6px;
            font-weight: 700;
            color: root.active ? Theme.accent-bright : ta.has-hover ? Theme.text : Theme.muted;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Backdrop.set-mode(root.mode); }
    }
}

/// One picture in the grid: 16:9 thumbnail (sized by BackdropGrid), accent
/// edge on the current picture, a small × on hover on the player's own pictures.
component BackdropThumb inherits Rectangle {
    in property <BackdropItem> item;
    border-radius: Theme.radius-md;
    border-width: root.item.key == Backdrop.current ? 2px : Theme.hairline;
    border-color: root.item.key == Backdrop.current ? Theme.accent : ta.has-hover ? Theme.hover-border : Theme.border-solid;
    background: Theme.card-bg-soft;
    clip: true;
    animate border-color { duration: Theme.dur-fast; }
    Image {
        width: 100%;
        height: 100%;
        source: root.item.thumb;
        image-fit: cover;
    }
    // dim on hover so the × reads over busy pictures
    if ta.has-hover && root.item.custom: Rectangle {
        background: rgba(0, 0, 0, 0.25);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Backdrop.select(root.item.key); }
    }
    if root.item.custom && ta.has-hover: Rectangle {
        x: parent.width - self.width - 4px;
        y: 4px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: rgba(8, 10, 12, 0.85);
        border-width: Theme.hairline;
        border-color: Theme.glass-border;
        Icon { data: Icons.x; size: 11px; color: rm.has-hover ? Theme.accent-red : #e8e6e1; }
        rm := TouchArea {
            mouse-cursor: pointer;
            clicked => { Backdrop.remove(root.item.key); }
        }
    }
}

/// The last tile of the grid: opens the file dialog for the player's pictures.
component BackdropAdd inherits Rectangle {
    border-radius: Theme.radius-md;
    border-width: Theme.hairline;
    border-color: ta.has-hover ? Theme.hover-border : Theme.border-solid;
    background: ta.has-hover ? Theme.surface-up : Theme.card-bg-soft;
    animate background, border-color { duration: Theme.dur-fast; }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Icon { data: Icons.plus; size: 16px; color: ta.has-hover ? Theme.text : Theme.muted; }
        }
        Text {
            text: T.tr("settings.backdrop.add");
            font-size: 11.6px;
            font-weight: 600;
            color: ta.has-hover ? Theme.text : Theme.muted;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Backdrop.add-custom(); }
    }
}

/// Manual wrap grid (the GalleryGrid pattern): Backdrop.items + the add tile.
/// Cells fill the card width (4 columns, 2 when narrow) with the same 12px
/// gap as the mode tiles above, so the two rows share their edges.
component BackdropGrid inherits Rectangle {
    property <length> gap: 12px;
    property <int> cols: root.width >= 400px ? 4 : 2;
    property <length> cell-w: (root.width - (cols - 1) * gap) / cols;
    property <length> cell-h: root.cell-w * 9 / 16;
    property <int> total: Backdrop.items.length + 1;
    property <int> rows: ceil(total / cols);
    height: rows * cell-h + max(0, rows - 1) * gap;
    for it[i] in Backdrop.items: BackdropThumb {
        x: mod(i, root.cols) * (root.cell-w + root.gap);
        y: floor(i / root.cols) * (root.cell-h + root.gap);
        width: root.cell-w;
        height: root.cell-h;
        item: it;
    }
    BackdropAdd {
        x: mod(Backdrop.items.length, root.cols) * (root.cell-w + root.gap);
        y: floor(Backdrop.items.length / root.cols) * (root.cell-h + root.gap);
        width: root.cell-w;
        height: root.cell-h;
    }
}

component BackdropCard inherits SettingCard {
    VerticalLayout {
        alignment: start;
        CardHead {
            title: T.tr("settings.backdrop.title");
            desc: T.tr("settings.backdrop.desc");
        }
        VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                BackdropChoice { mode: "image"; label: T.tr("settings.backdrop.modeImages"); icon: Icons.image; }
                BackdropChoice { mode: "glass"; label: T.tr("settings.backdrop.modeGlass"); icon: SetIcons.sparkles; }
            }
            if Backdrop.mode == "image": BackdropGrid { }
            if Backdrop.mode == "image": Text {
                text: T.tr("settings.backdrop.hint");
                font-family: Theme.font-body;
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
            if Backdrop.mode == "glass" && !Theme.glass: Text {
                text: T.tr("settings.backdrop.glassNote");
                font-family: Theme.font-body;
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
    }
}

// ---- engine: memory / downloads / jdk ------------------------------------------------

/// `.slider-control-group`: range + number input + unit + save button.
component SliderRow inherits HorizontalLayout {
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <string> unit;
    in property <string> save-text;
    in property <bool> dirty;
    in property <bool> saving;
    in property <bool> save-enabled: true;
    in property <bool> narrow;
    callback text-edited(string);
    callback save();
    spacing: 20px;
    property <int> shown: round(root.value);
    changed shown => {
        if !num.has-focus { num.text = root.shown; }
    }
    Slider {
        horizontal-stretch: 1;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value <=> root.value;
    }
    HorizontalLayout {
        spacing: 8px;
        horizontal-stretch: 0;
        num := SsTextField {
            width: 110px;
            horizontal-stretch: 0;
            mono: true;
            text: root.shown;
            edited(t) => { root.text-edited(t); }
        }
        Text {
            text: root.unit;
            font-family: Theme.font-body;
            font-size: 13.6px;
            font-weight: 500;
            color: Theme.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                variant: root.dirty ? BtnVariant.primary : BtnVariant.secondary;
                size: BtnSize.sm;
                loading: root.saving;
                enabled: !root.saving && root.save-enabled;
                text: root.saving ? T.tr("common.saving") : root.save-text;
                clicked => { root.save(); }
            }
        }
    }
}

component RamBadge inherits Rectangle {
    in property <string> value;
    height: row.preferred-height;
    width: row.preferred-width;
    border-radius: Theme.radius-md;
    background: Theme.card-bg-soft;
    border-width: Theme.hairline;
    border-color: Theme.border-solid;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 5.6px;
        padding-bottom: 5.6px;
        spacing: 4px;
        Text { text: root.value; font-family: Theme.font-mono; font-size: Theme.text-lg; font-weight: 700; color: Theme.title-color; vertical-alignment: bottom; }
        VerticalLayout {
            alignment: end;
            padding-bottom: 2px;
            Text { text: "GB"; font-size: Theme.text-xs; font-weight: 700; color: Theme.muted; }
        }
    }
}

component MemoryCard inherits SettingCard {
    in property <bool> dirty;
    in property <string> error;
    callback text-edited(string);
    VerticalLayout {
        alignment: start;
        spacing: 0px;
        CardHead {
            title: T.tr("dash.memory.title");
            badge: root.dirty ? T.tr("dash.unsavedBadge") : "";
            desc: T.tr("dash.memory.desc");
            VerticalLayout {
                alignment: start;
                RamBadge { value: round(SettingsBridge.memory / 1024 * 10) / 10; }
            }
        }
        Field {
            label: T.tr("dash.memory.sliderLabel");
            hint: T.tr("settings.memoryHint");
            error: root.error;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-bottom: 12px;
                PresetChip {
                    text: T.tr("instance.memoryAuto");
                    active: SettingsBridge.cfg-memory-auto && round(SettingsBridge.memory) == SettingsBridge.cfg-memory;
                    enabled: SettingsBridge.saving-field != "memory";
                    clicked => { SettingsBridge.save-memory-auto(); }
                }
                for mb in [2048, 3072, 4096, 6144, 8192, 12288, 16384]: PresetChip {
                    text: (mb / 1024) + " GB";
                    active: round(SettingsBridge.memory) == mb && !(SettingsBridge.cfg-memory-auto && round(SettingsBridge.memory) == SettingsBridge.cfg-memory);
                    clicked => { SettingsBridge.memory = mb; }
                }
            }
            SliderRow {
                value <=> SettingsBridge.memory;
                minimum: 1024;
                maximum: 16384;
                step: 512;
                unit: "MB";
                save-text: T.tr("dash.memory.saveBtn");
                dirty: root.dirty;
                saving: SettingsBridge.saving-field == "memory";
                save-enabled: root.error == "";
                text-edited(t) => { root.text-edited(t); }
                save => { SettingsBridge.save-memory(round(SettingsBridge.memory)); }
            }
        }
    }
}

component DownloadsCard inherits SettingCard {
    in property <bool> dirty;
    VerticalLayout {
        alignment: start;
        CardHead {
            title: T.tr("dash.downloads.title");
            badge: root.dirty ? T.tr("dash.unsavedBadge") : "";
            desc: T.tr1("dash.downloads.threads", "n", round(SettingsBridge.concurrency)) + " — " + T.tr("settings.downloadConcurrencyHint");
        }
        Field {
            label: T.tr("settings.downloadConcurrency");
            hint: T.tr("dash.downloads.desc");
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-bottom: 12px;
                for n in [2, 4, 6, 8, 12, 16]: PresetChip {
                    text: n;
                    active: round(SettingsBridge.concurrency) == n;
                    clicked => { SettingsBridge.concurrency = n; }
                }
            }
            SliderRow {
                value <=> SettingsBridge.concurrency;
                minimum: 1;
                maximum: 16;
                step: 1;
                unit: T.tr("settings.downloadsUnit");
                save-text: T.tr("dash.downloads.saveBtn");
                dirty: root.dirty;
                saving: SettingsBridge.saving-field == "concurrency";
                text-edited(t) => {
                    if t.is-float() { SettingsBridge.concurrency = t.to-float(); }
                }
                save => { SettingsBridge.save-concurrency(round(SettingsBridge.concurrency)); }
            }
        }
    }
}

component JvmKv inherits VerticalLayout {
