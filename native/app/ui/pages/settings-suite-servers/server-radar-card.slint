// OWNER: settings-suite-servers agent. Port of components/ServerRadarCard.svelte
// (+ PingWaveform). SHARED: home-instances' Home page imports this component
// for its server strip, so keep the interface below stable (add properties,
// never rename/remove). Data: AppState.servers (src/store.rs refresh_servers).
//
// Click copies the host (Svelte useCopy: "✓ Copiado" for 1.8 s, no toast) and
// also emits clicked(); set `copy-on-click: false` to only get clicked().
// The beacon orb pulse animation is omitted (idle = 0% CPU).
//
// Poster look: the site's "Estado de servidores" card — flat block, 2px border,
// hard ink shadow, pixel-font server name, address chip + Copiar pill, and
// JUGADORES / MOTD labels in small-caps body text.

import { Theme, T, AppState, ServerRow, GlassCard, Elevation, Btn, BtnVariant, BtnSize, Badge, BadgeVariant, MonogramTile, MonogramShape } from "../../widgets.slint";
import { SettingsBridge, MotdLineRow, PingWaveGeometry } from "api.slint";

/// components/PingWaveform.svelte: deterministic sparkline seeded by the ping,
/// emerald / amber / red by latency, dashed flat line when offline. The path is
/// a pure function of (ping, online, size): recomputed only when one changes.
export component PingWaveform inherits HorizontalLayout {
    /// Latency in ms; -1 = unknown.
    in property <int> ping-ms: -1;
    in property <bool> online: true;
    in property <length> wave-width: 84px;
    in property <length> wave-height: 24px;
    in property <bool> show-label: false;

    property <bool> unknown: !root.online || root.ping-ms < 0;
    property <color> stroke: root.unknown || root.ping-ms > 140 ? Theme.accent-red : root.ping-ms <= 65 ? Theme.accent-green : Theme.accent-alt;
    property <PingWaveGeometry> geo: SettingsBridge.ping-wave(root.ping-ms, root.online, root.wave-width / 1px, root.wave-height / 1px);

    spacing: Theme.space-2;
    Rectangle {
        width: root.wave-width;
        height: root.wave-height;
        // the gradient area fill is off-style: a flat low-alpha band instead
        Rectangle {
            x: 0;
            y: root.wave-height * 0.5;
            width: root.wave-width;
            height: root.wave-height * 0.5;
            background: root.stroke.with-alpha(0.12);
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: root.wave-width / 1px;
            viewbox-height: root.wave-height / 1px;
            commands: root.geo.line;
            stroke: root.stroke;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        Rectangle {
            x: root.geo.dot-x * 1px - 3px;
            y: root.geo.dot-y * 1px - 3px;
            width: 6px;
            height: 6px;
            border-radius: 1px;
            background: root.stroke;
            border-width: 1px;
            border-color: Theme.brand-ink;
        }
    }
    if root.show-label: Text {
        text: root.online && root.ping-ms >= 0 ? root.ping-ms + "ms" : root.online ? "--ms" : "OFF";
        font-family: Theme.font-pixel;
        font-size: 8px;
        color: Theme.muted-strong;
        vertical-alignment: center;
    }
}

/// MOTD stage: § colored runs, one HorizontalLayout per line.
component MotdStage inherits Rectangle {
    in property <[MotdLineRow]> lines;
    min-height: max(48px, inner.min-height);
    preferred-height: max(48px, inner.preferred-height);
    border-radius: Theme.radius-sm;
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: Theme.border-solid;
    clip: true;
    inner := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            alignment: center;
            for l in root.lines: HorizontalLayout {
                alignment: start;
                for seg in l.segments: Text {
                    text: seg.text;
                    font-family: Theme.font-mono;
                    font-size: 12px;
                    font-weight: seg.bold ? 700 : 400;
                    font-italic: seg.italic;
                    color: seg.has-color ? seg.color : Theme.text;
                    overflow: elide;
                }
            }
        }
    }
}

/// Small flat chip (software / version). Pixel font at 8px for short labels.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> pixel;
    in property <color> fg: Theme.muted-strong;
    in property <color> edge: Theme.border-solid;
    height: lbl.preferred-height + 8px;
    width: min(lbl.preferred-width + 16px, 168px);
    border-radius: Theme.radius-sm;
    background: Theme.card-bg-soft;
    border-width: 2px;
    border-color: root.edge;
    lbl := Text {
        text: root.text;
        font-family: root.pixel ? Theme.font-pixel : Theme.font-body;
        font-size: root.pixel ? 8px : 11px;
        font-weight: root.pixel ? 400 : 600;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: min(self.preferred-width, 152px);
    }
}

export component ServerRadarCard inherits Rectangle {
    in property <ServerRow> server;
    in property <bool> compact: false;
    in property <bool> interactive: false;
    in property <bool> featured: false;
    in property <bool> show-ip: true;
    /// Copy the host on click (Svelte default). clicked() is emitted either way.
    in property <bool> copy-on-click: true;
    callback clicked();

    property <bool> copied: false;
    property <string> address: root.server.host != "" ? root.server.host : root.server.hostname;
    property <string> direct: root.server.ip != "" ? root.server.ip + ":" + (root.server.port > 0 ? root.server.port : 25565) : "";
    property <bool> has-players: root.server.online && root.server.players-online > 0;

    function copy(text: string) {
        if text == "" {
            return;
        }
        AppState.copy-text(text);
        root.copied = true;
        copy-timer.running = true;
        copy-timer.restart();
    }

    copy-timer := Timer {
        interval: 1800ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }

    min-height: card.min-height;
    preferred-height: card.preferred-height;
    min-width: 0px;

    card := GlassCard {
        width: 100%;
        height: 100%;
        elevation: Elevation.md;
        clickable: true;
        interactive: root.interactive;
        featured: root.featured;
        padding-size: root.compact ? 20px : 24px;
        spacing: root.compact ? 8px : 12px;
        clicked => {
            if root.copy-on-click {
                root.copy(root.address);
            }
            root.clicked();
        }

        // ---- name row: server icon + status dot + pixel-font name + players
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: root.compact ? 32px : 40px;
                    height: root.compact ? 32px : 40px;
                    border-radius: Theme.radius-sm;
                    border-width: 2px;
                    border-color: Theme.brand-ink;
                    clip: true;
                    if root.server.has-icon: Image {
                        width: 100%;
                        height: 100%;
                        source: root.server.icon;
                        image-fit: cover;
                        image-rendering: pixelated;
                    }
                    if !root.server.has-icon: MonogramTile {
                        width: 100%;
                        height: 100%;
                        name: root.server.hostname != "" ? root.server.hostname : root.server.host != "" ? root.server.host : "ES";
                        size: root.compact ? 32px : 40px;
                        shape: MonogramShape.rounded;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 2px;
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 1px;
                        background: root.server.online ? Theme.accent-green : Theme.accent-red;
                        border-width: 2px;
                        border-color: Theme.brand-ink;
                        // the row is centred: keep the dot on the text baseline
                        y: (parent.height - self.height) / 2 + 3px;
                    }
                    Text {
                        text: root.server.hostname != "" ? root.server.hostname : root.server.host;
                        font-family: Theme.font-title;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.title-color;
                        overflow: elide;
                    }
                }
                if root.server.software != "" || root.server.version != "": HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    if root.server.software != "": Chip { text: root.server.software; pixel: true; fg: Theme.accent-cyan; edge: Theme.accent-cyan.with-alpha(0.5); }
                    if root.server.version != "": Chip { text: root.server.version; }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: T.tr("server.players").to-uppercase();
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    color: Theme.muted;
                    horizontal-alignment: right;
                }
                HorizontalLayout {
                    alignment: end;
                    Badge {
                        text: root.server.online ? root.server.players-online + "/" + root.server.players-max : "0/0";
                        variant: root.has-players ? BadgeVariant.accent : BadgeVariant.neutral;
                        pixel: true;
                        large: !root.compact;
                    }
                }
            }
        }

        // ---- address row: mono chip + Copiar pill
        HorizontalLayout {
            spacing: 8px;
            // no `alignment: start` here: it would pin the chip at its
            // (zero) preferred width instead of letting it stretch
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: addr.preferred-width + 20px;
                height: addr.preferred-height + 12px;
                border-radius: Theme.radius-sm;
                background: Theme.log-bg;
                border-width: 2px;
                border-color: Theme.border-solid;
                addr := Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 20px;
                    text: root.address != "" ? root.address : "—";
                    font-family: Theme.font-mono;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.accent-cyan;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Btn {
                variant: root.copied ? BtnVariant.primary : BtnVariant.secondary;
                size: BtnSize.sm;
                text: root.copied ? T.tr("server.copied") : T.tr("server.copy");
                clicked => { root.copy(root.direct != "" ? root.direct : root.address); }
            }
        }

        if !root.compact && root.show-ip && root.direct != "": HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Rectangle {
                height: ip.preferred-height + 6px;
                width: ip.preferred-width + 14px;
                border-radius: Theme.radius-sm;
                background: Theme.card-bg-soft;
                border-width: 2px;
                border-color: ip-ta.has-hover ? Theme.hover-border : Theme.border-solid;
                ip := Text {
                    text: "IP: " + root.direct;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    color: ip-ta.has-hover ? Theme.hover-border : Theme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ip-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.copy(root.direct); }
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            Text {
                text: "MOTD";
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.8px;
                color: Theme.muted;
            }
            MotdStage { lines: SettingsBridge.motd-lines(root.server); }
        }

        // status footer (no ping in ServerRow: no sparkline here)
        if !root.compact: VerticalLayout {
            spacing: 8px;
            Rectangle { height: 2px; background: Theme.border-solid; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.server.online: Badge { text: T.tr("common.online"); variant: BadgeVariant.ok; dot: true; }
                if !root.server.online: Badge { text: T.tr("server.offline"); variant: BadgeVariant.err; }
                if root.server.error != "": Text {
                    text: root.server.error;
                    font-size: 11px;
                    color: Theme.accent-red;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
