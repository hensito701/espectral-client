{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Espectral Client",
  "version": "1.3.10",
  "identifier": "es.spectral.launcher",
  "build": {
    "beforeDevCommand": "npm run ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && node scripts/stage-tauri-resources.mjs",
    "frontendDist": "../src/ui/dist"
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNjY5N0JDMzQwRjY3NUMKUldSY1p3ODB2SmRtc3Q3dm91TmJJTkhsQXorV01TU0NrTklDd3JlY1d0RU9pK1FkR093elV4UU8K",
      "endpoints": [
        "https://espectral.es/client/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Espectral Client",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://espectral.es; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://espectral.es ws://localhost:5173; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../build/tauri-resources/engine": "engine/",
      "../build/tauri-resources/package.json": "package.json",
      "../build/tauri-resources/node_modules": "node_modules/",
      "../build/tauri-resources/node.exe": "node.exe",
      "../build/tauri-resources/branding": "branding/"
    },
    "externalBin": [],
    "copyright": "© 2026 Espectral Client",
    "category": "Game",
    "shortDescription": "Espectral Client launcher",
    "longDescription": "Lanzador open source para espectral.es — JDK 25 + AOT boot.",
    "fileAssociations": [
      {
        "ext": [
          "mrpack"
        ],
        "name": "Espectral Modpack",
        "description": "Modrinth modpack (.mrpack)",
        "role": "Editor"
      }
    ]
  }
}
